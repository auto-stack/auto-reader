// probe.at — PLAN-026 探针表面页。
// remote-frame 在 vue 轨渲染为 <div data-remote-frame="1"
// data-remote-frame-url="...">（shadcn_attrs.rs PLAN-760 臂）——探针胶水
// 以 querySelector 接管该 div 并挂载 foliate-js 引擎；选区/定位经页面
// fetch 通道（与本页 .at 编译面同传输）进 back/api.at 的 .at 消费 handler。
widget probe {
    view {
        col {
            style: "min-h-screen p-6 gap-4 max-w-4xl mx-auto"

            h1 "引擎表面探针" { style: "text-2xl font-bold text-foreground" }
            text "PLAN-026 document surface — engine mounts into the remote-frame seam below" {
                style: "text-sm text-muted-foreground"
            }

            remote-frame (url: "probe://engine-surface") {
                style: "w-full h-[70vh] border border-border rounded-md bg-white overflow-hidden"
            }

            text "状态：等待探针驱动注入引擎胶水" {
                style: "text-xs text-muted-foreground"
            }
        }
    }
}
