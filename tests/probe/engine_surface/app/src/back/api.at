/// GET /api/probe/dbg_text — epub_full_text 诊断（T-02 专用，交付前移除）。
#[api(method = "GET", path = "/api/probe/dbg_text")]
pub fn probe_dbg_text(book_id str) str {
    let dj str = find_doc_json(book_id)
    if dj == "" {
        return "{\"found\":false}"
    }
    var mp str = ""
    try {
        let dparsed = json.parse(dj)
        mp = "" + dparsed.managed_path
    } catch {
        return "{\"found\":false,\"why\":\"parse\"}"
    }
    let full str = epub_full_text(mp)
    let n int = full.len()
    var head str = full
    if n > 400 {
        head = full.substr(0, 400)
    }
    head = head + "||TAIL||"
    let tl int = full.len()
    if tl > 400 {
        head = head + full.substr(tl - 200, 200)
    }
    var out str = "{\"len\":"
    let ns str = n.to_string()
    out = out + ns
    out = out + ",\"head\":\""
    let he str = json_escape(head)
    out = out + he
    out = out + "\"}"
    return out
}
