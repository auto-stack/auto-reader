# Override parent .gitignore so the handmade theme escape-hatch files commit.
# The repo-root rule `examples/**/vue/` ignores generated vue dirs; this example
# ships a handmade ThemeToggle.vue + index.css that must be tracked (cf.
# examples/a3ui-replica/.gitignore which does the same).
!vue/

# And allow the playwright test manifest (repo-root `*.json` ignores it; 017-chat
# relies on pnpm-lock.yaml, but committing package.json makes `npm/pnpm install`
# work without regeneration).
!tests/package.json

# Generated / runtime artifacts (still ignored).
gen/
.auto/
dist/
build/
examples/
.am/
tests/node_modules/
tests/test-results/
tests/playwright-report/

# Independent app generated/runtime artifacts
.am/
am.at
gen/
node_modules/
target/
rust-workspace/
dist/
__pycache__/
*.pyc
*.log
*.exe
*.pdb
/tmp/
/test-results/
/playwright-report/

# a2r single-file transpile artifacts
*.a2r.rs

# capacity-ladder fixtures are generated by t04_http_verify.py (runtime artifacts)
tests/fixtures/library/cap-*
tests/fixtures/library/gen-same-title-*

# deps/ = CLI 依赖实体化产物（auto fetch/build 从 pac.at path 复制；
# 旧符号链接指针机制已废——绝对路径指向已迁移的 auto-os 旧位）
deps/

# AutoOS 运行时账本目录：specs.json 已迁移 AutoDown（PLAN-107），本地保留只读副本作回滚依据
.autoos/

# 前端临时验证截图不入库
src/front/tmp/
