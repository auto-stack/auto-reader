// api.at — Book Reader API.
// CRUD over books + chapters + reading progress. All endpoints delegate to
// db.rs (Plan 399 route B: full coverage, no State<Db> fallback, no mixed
// state). Frontend consumes Book/Chapter via `use back.api`.

/// A book in the library.
pub type Book = {
    id: int
    title: str
    author: str
    chapter_count: int
    word_count: int
    progress: int
    status: str
    cover_color: str
}

/// A single chapter within a book.
pub type Chapter = {
    book_id: int
    number: int
    title: str
    body: str
    word_count: int
}

use db
use library: BookRecord, ImportOutcome, TocEntry, RemoveResult, book_json, data_dir
use epub: epub_img_type_of
use importers: ChapterRec
use annotations

/// GET /api/books — list every book in the library.
#[api(method = "GET", path = "/api/books")]
pub fn list_books() []Book {
    return db.all_books()
}

/// POST /api/books — add a new book (auto-generates chapters + cover).
#[api(method = "POST", path = "/api/books")]
pub fn create_book(title str, author str) Book {
    return db.create_book(title, author)
}

/// DELETE /api/books/:id — remove a book (and its chapters).
#[api(method = "DELETE", path = "/api/books/:id")]
pub fn delete_book(id int) bool {
    return db.delete_book(id)
}

/// GET /api/books/:id — fetch a single book by id.
#[api(method = "GET", path = "/api/books/:id")]
pub fn get_book(id int) ?Book {
    return db.find_book(id)
}

/// GET /api/books/:id/chapters — list chapters of a book.
/// PLAN-712 r2 T-15：形参名必须与路径占位符一致（`:id` ↔ `id`）——
/// proxy 按占位符名绑参，形参 book_id 曾致「missing param book_id」400。
#[api(method = "GET", path = "/api/books/:id/chapters")]
pub fn list_chapters(id int) []Chapter {
    return db.chapters_of(id)
}

/// GET /api/chapters — read a specific chapter by book + number.
/// (Query params book_id + number.)
#[api(method = "GET", path = "/api/chapters")]
pub fn get_chapter(book_id int, number int) Chapter {
    return db.get_chapter(book_id, number)
}

/// PUT /api/books/:id/progress — persist reading progress (0-100).
#[api(method = "PUT", path = "/api/books/:id/progress")]
pub fn update_progress(id int, progress int) Book {
    return db.update_progress(id, progress)
}

// ═══════════════════════════════════════════════════════════
// READER-001 真实书库端点（thin 体 + JSON 字符串返回——非 api 模块构造
// api 端点类型在 a2r 转译面报 undefined 且无 serde 派生（T-01 实测），
// 故与 027-file-manager 同款：后端交 JSON 文本，前端 json.parse 动态取用。
// 形参名与路径占位符一致；多参数查询走 query（基线 get_chapter 同款）。
// ═══════════════════════════════════════════════════════════

/// GET /api/library/books — 真实书目 JSON（区别于 demo 的 /api/books）。
#[api(method = "GET", path = "/api/library/books")]
pub fn library_books() str {
    return db.library_books()
}

/// POST /api/library/import — 导入真实 TXT/Markdown 文件。
/// body: { path, author?, force? }；同指纹默认 duplicate 提示复用。
#[api(method = "POST", path = "/api/library/import")]
pub fn library_import(path str, author str, force bool) str {
    return db.library_import(path, author, force)
}

/// GET /api/library/books/:id — 单本真实书（未找到返回 ""）。
#[api(method = "GET", path = "/api/library/books/:id")]
pub fn library_book(id str) str {
    return db.library_book(id)
}

/// DELETE /api/library/books/:id — 可恢复移除（受管副本与原文件不动）。
#[api(method = "DELETE", path = "/api/library/books/:id")]
pub fn library_remove(id str) str {
    return db.library_remove(id)
}

/// POST /api/library/books/:id/restore — 从移除记录恢复。
#[api(method = "POST", path = "/api/library/books/:id/restore")]
pub fn library_restore(id str) str {
    return db.library_restore(id)
}

/// GET /api/library/books/:id/toc — 真实书目录 JSON。
#[api(method = "GET", path = "/api/library/books/:id/toc")]
pub fn library_toc(id str) str {
    return db.library_toc(id)
}

/// GET /api/library/chapter — 真实书单章 JSON（query: book_id + number）。
#[api(method = "GET", path = "/api/library/chapter")]
pub fn library_chapter(book_id str, number int) str {
    return db.library_chapter(book_id, number)
}

/// GET /api/library/progress — 阅读状态 JSON（query: book_id；无记录 ""）。
#[api(method = "GET", path = "/api/library/progress")]
pub fn library_get_reading(book_id str) str {
    return db.library_get_reading(book_id)
}

/// POST /api/library/progress — 写阅读状态（locator v1 + settings）。
/// body: { book_id, payload, para_text }——payload 为状态 JSON 字符串
/// （jsonx 词法门：结构/类型精确/重复键拒绝）；para_text 为顶层内容锚点
/// 字段（Phase 3 F-08/F-10：段级定位必填，后端与当前原文行逐字核对后
/// 注入存储态；走外层 JSON 传输，前端零转义）。校验失败以
/// {"ok":false,"message"} 返回。VM HTTP 层对 PUT+str 返回会丢响应体
/// （T-02 实测），故写端点用 POST。
#[api(method = "POST", path = "/api/library/progress")]
pub fn library_put_reading(book_id str, payload str, para_text str) str {
    return db.library_put_reading(book_id, payload, para_text)
}

// ═══════════════════════════════════════════════════════════
// READER-002 阶段A：注释/书签/高亮、全文搜索、导出（annotations.at 直通，
// JSON 字符串表面同款——形参名与 body/query 字段一致；用户文本一律顶层
// 字段直传，VM HTTP 多字节损坏规避与 progress 同源）。
// ═══════════════════════════════════════════════════════════

/// GET /api/library/annotations — 注释集合 JSON（query: book_id）。
#[api(method = "GET", path = "/api/library/annotations")]
pub fn library_annotations(book_id str) str {
    return db.library_get_annotations(book_id)
}

/// POST /api/library/annotations — 注释写操作。
/// body: { book_id, op, annotation_id, kind, chapter_number, para_idx,
///         occurrence, comment, tags_json, quote }
/// op=create|update|delete；op=update/delete 时未用锚字段传默认值
/// （chapter_number=0 等）；tags_json 为字符串数组 JSON 文本。
#[api(method = "POST", path = "/api/library/annotations")]
pub fn library_put_annotations(book_id str, op str, annotation_id str, kind str, chapter_number int, para_idx int, occurrence int, comment str, tags_json str, quote str) str {
    return db.library_put_annotations(book_id, op, annotation_id, kind, chapter_number, para_idx, occurrence, comment, tags_json, quote)
}

/// POST /api/library/search — 段粒度全文搜索。
/// body: { book_id, query }
#[api(method = "POST", path = "/api/library/search")]
pub fn library_search(book_id str, query str) str {
    return db.library_search(book_id, query)
}

/// POST /api/library/export — 注释 Markdown 导出（本地文件交付）。
/// body: { book_id }
#[api(method = "POST", path = "/api/library/export")]
pub fn library_export(book_id str) str {
    return db.library_export_annotations(book_id)
}

// ═══════════════════════════════════════════════════════════
// READER-005 T-02：EPUB 章图稳定字节服务。URI = /api/reader/media/
// <book_id>/res_<双射扁平名>（epub.at epub_chapter_json 产出）；文件体
// 由 VM 缺省 HTTP transport 承载（http.file_response：GET/HEAD、单区间、
// 条件请求；root 越界 .. /绝对路径/盘符/UNC 403）。root 只由书目记录
// 派生（受管副本章节缓存目录），:res 段另过形状白名单（res_ 前缀 +
// [A-Za-z0-9.-]）——双保险，不具跨书/逃逸可达性。
// ═══════════════════════════════════════════════════════════

/// GET /api/reader/media/:bid/:res — 章图原始字节（不支持形态 → 404）。
/// root/形状白名单与 content type 推导在 library.epub_media_response
/// （db 委托同款分层——codegen db.rs 一致性门要求端点经 db 面）。
#[api(method = "GET", path = "/api/reader/media/:bid/:res")]
pub fn reader_media(bid str, res str) FileResponse {
    return db.reader_media(bid, res)
}

// ═══════════════════════════════════════════════════════════
// READER-007 T-03：产品引擎资源/会话端点（正式 /api/reader/*）。
// 固定资产 root = 应用自有资产目录（仓库内 src/assets/engine-assets，
// AUTO_READER_ENGINE_ASSETS 可覆盖隔离）；受管原件 root = 正式书目记录
// 派生；会话存数据目录 sessions.json。全部经 db 面委托（一致性门）。
// ═══════════════════════════════════════════════════════════

/// GET /api/reader/asset/:name — 产品固定资产字节（引擎资产/adapter/宿主页）。
#[api(method = "GET", path = "/api/reader/asset/:name")]
pub fn reader_asset(name str) FileResponse {
    return db.reader_asset(name)
}

/// GET /api/reader/document/:bid/file — 本书受管原件字节（引擎装载源）。
#[api(method = "GET", path = "/api/reader/document/:bid/file")]
pub fn reader_document(bid str) FileResponse {
    return db.reader_document(bid)
}

/// POST /api/reader/session — 建立产品会话（绑定书/源版本/引擎）。
/// body: { session_id, book_id, source_hash, engine }。
#[api(method = "POST", path = "/api/reader/session")]
pub fn reader_session_create(session_id str, book_id str, source_hash str, engine str) str {
    return db.reader_session_create(session_id, book_id, source_hash, engine)
}

/// GET /api/reader/session — 会话读回（query: session_id；冷恢复身份）。
#[api(method = "GET", path = "/api/reader/session")]
pub fn reader_session_read(session_id str) str {
    return db.reader_session_read(session_id)
}

/// GET /api/reader/surface-url — 正式阅读页 doc-surface 装载 URL（最近会话）。
#[api(method = "GET", path = "/api/reader/surface-url")]
pub fn reader_surface_url() str {
    return db.reader_surface_url_json()
}
