// jsonx.at — READER-001 Phase 3 词法级 JSON 结构校验器（F-09/F-11 落地面）。
// 背景（t11 探针实测）：VM 动态 json 层无法做类型判别——`+` 对 str/int 一律
// 字符串拼接（"3" 与 3 都得 "30"）、容器 "" + v 是递增内部句柄、typed 绑定
// 对 str 字段静默强转、键重复被解析层后值覆盖。因此「真实结构与类型验证」
// 只能在**原始文本的词法层**做：本模块按字节扫描（VM len/substr 为字节口径；
// UTF-8 多字节字节 ≥0x80 永不与结构字符 '"''\\' 混淆，跳串安全），提供：
//   valid_index(raw)  — library.json 结构门：version 必须为整数字面量 1、
//                       books 必须为数组、每条记录必需字段齐备且类型正确、
//                       顶层与记录内已知键重复拒绝。错误返回非空消息；
//                       "" = 结构合法（值语义仍由调用方判读）。
//   valid_state(raw)  — ReadingState 结构门：8 个已知键的类型/重复/空白/
//                       转义键词法校验（值提取由调用方在通过后 json.parse）。
// 已知键之外的未知键容忍（跳过）；未知键重复不追踪（无害，如实记录）。
// 本模块为 VM 后端轨专用（交付轨；a2r 轨本仓不可构建——已登记框架差距），
// 字节语义与 Rust char 口径不同，不得在 a2r 语境复用。
// 值得注意：json.parse 对合法空白/转义键天然容忍（t11 探针 Q4）——本模块
// 只补「结构与类型」判别，值转义仍交给 json.parse（unquote 助手）。

/// 跳过空白（空格/制表/换行/回车）。返回新位置。
fn skip_ws(s str, i int) int {
    var j int = i
    var n int = s.len()
    var guard int = 0
    while j < n {
        if guard > 1048576 {
            break
        }
        guard = guard + 1
        let c str = s.substr(j, 1)
        if c == " " {
            j = j + 1
        } else {
            if c == "\t" {
                j = j + 1
            } else {
                if c == "\n" {
                    j = j + 1
                } else {
                    if c == "\r" {
                        j = j + 1
                    } else {
                        break
                    }
                }
            }
        }
    }
    return j
}

/// 字符串值扫描：i 指向开引号，返回闭引号后一位；非法返回 -1。
/// 转义校验：\" \\ \/ \b \f \n \r \t \uXXXX（u 后须 4 个 hex）。
fn scan_string_end(s str, i int) int {
    let n int = s.len()
    var j int = i + 1
    var guard int = 0
    while j < n {
        if guard > 1048576 {
            return -1
        }
        guard = guard + 1
        let c str = s.substr(j, 1)
        if c == "\"" {
            return j + 1
        }
        if c == "\\" {
            if j + 1 >= n {
                return -1
            }
            let e str = s.substr(j + 1, 1)
            if e == "u" {
                if j + 5 >= n {
                    return -1
                }
                var k int = 0
                while k < 4 {
                    let h str = s.substr(j + 2 + k, 1)
                    let hex bool = h == "0" || h == "1" || h == "2" || h == "3" || h == "4" || h == "5" || h == "6" || h == "7" || h == "8" || h == "9" || h == "a" || h == "b" || h == "c" || h == "d" || h == "e" || h == "f" || h == "A" || h == "B" || h == "C" || h == "D" || h == "E" || h == "F"
                    if !hex {
                        return -1
                    }
                    k = k + 1
                }
                j = j + 6
            } else {
                if e == "\"" || e == "\\" || e == "/" || e == "b" || e == "f" || e == "n" || e == "r" || e == "t" {
                    j = j + 2
                } else {
                    return -1
                }
            }
        } else {
            j = j + 1
        }
    }
    return -1
}

/// 数字字面量扫描：-?digits(.digits)?([eE][+-]?digits)?。返回结束位；非法 -1。
fn scan_number_end(s str, i int) int {
    let n int = s.len()
    var j int = i
    if j < n {
        if s.substr(j, 1) == "-" {
            j = j + 1
        }
    }
    var digits int = 0
    while j < n {
        let c str = s.substr(j, 1)
        if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9" {
            digits = digits + 1
            j = j + 1
        } else {
            break
        }
    }
    if digits == 0 {
        return -1
    }
    if j < n {
        if s.substr(j, 1) == "." {
            j = j + 1
            var fd int = 0
            while j < n {
                let c str = s.substr(j, 1)
                if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9" {
                    fd = fd + 1
                    j = j + 1
                } else {
                    break
                }
            }
            if fd == 0 {
                return -1
            }
        }
    }
    if j < n {
        let c str = s.substr(j, 1)
        if c == "e" || c == "E" {
            j = j + 1
            if j < n {
                let sgn str = s.substr(j, 1)
                if sgn == "+" || sgn == "-" {
                    j = j + 1
                }
            }
            var ed int = 0
            while j < n {
                let c str = s.substr(j, 1)
                if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9" {
                    ed = ed + 1
                    j = j + 1
                } else {
                    break
                }
            }
            if ed == 0 {
                return -1
            }
        }
    }
    return j
}

/// 值扫描：任意 JSON 值，返回结束位；非法 -1。depth 防嵌套失控。
fn scan_value_end(s str, i int, depth int) int {
    if depth > 32 {
        return -1
    }
    let n int = s.len()
    if i >= n {
        return -1
    }
    let c str = s.substr(i, 1)
    if c == "\"" {
        return scan_string_end(s, i)
    }
    if c == "-" || c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9" {
        return scan_number_end(s, i)
    }
    if c == "t" {
        if i + 4 <= n {
            if s.substr(i, 4) == "true" {
                return i + 4
            }
        }
        return -1
    }
    if c == "f" {
        if i + 5 <= n {
            if s.substr(i, 5) == "false" {
                return i + 5
            }
        }
        return -1
    }
    if c == "n" {
        if i + 4 <= n {
            if s.substr(i, 4) == "null" {
                return i + 4
            }
        }
        return -1
    }
    if c == "{" {
        var j int = skip_ws(s, i + 1)
        if j < n {
            if s.substr(j, 1) == "}" {
                return j + 1
            }
        }
        while j < n {
            if s.substr(j, 1) != "\"" {
                return -1
            }
            let ke int = scan_string_end(s, j)
            if ke < 0 {
                return -1
            }
            j = skip_ws(s, ke)
            if j >= n || s.substr(j, 1) != ":" {
                return -1
            }
            j = skip_ws(s, j + 1)
            let ve int = scan_value_end(s, j, depth + 1)
            if ve < 0 {
                return -1
            }
            j = skip_ws(s, ve)
            if j < n {
                if s.substr(j, 1) == "," {
                    j = skip_ws(s, j + 1)
                    continue
                }
                if s.substr(j, 1) == "}" {
                    return j + 1
                }
            }
            return -1
        }
        return -1
    }
    if c == "[" {
        var j int = skip_ws(s, i + 1)
        if j < n {
            if s.substr(j, 1) == "]" {
                return j + 1
            }
        }
        while j < n {
            let ve int = scan_value_end(s, j, depth + 1)
            if ve < 0 {
                return -1
            }
            j = skip_ws(s, ve)
            if j < n {
                if s.substr(j, 1) == "," {
                    j = skip_ws(s, j + 1)
                    continue
                }
                if s.substr(j, 1) == "]" {
                    return j + 1
                }
            }
            return -1
        }
        return -1
    }
    return -1
}

/// 数字字面量是否为纯整数形态（无小数/指数）。span 已由 scan_number_end 保证合法。
fn span_is_int(span str) bool {
    if span.find(".") >= 0 {
        return false
    }
    if span.find("e") >= 0 {
        return false
    }
    if span.find("E") >= 0 {
        return false
    }
    return true
}

/// 十进制数字串无符号词法比较：a < b 返回 -1，a == b 返回 0，a > b 返回 1。
/// 双侧须为纯数字串（调用方保证）。
fn digits_cmp(a str, b str) int {
    if a.len() < b.len() {
        return -1
    }
    if a.len() > b.len() {
        return 1
    }
    var i int = 0
    while i < a.len() {
        if a.substr(i, 1) < b.substr(i, 1) {
            return -1
        }
        if a.substr(i, 1) > b.substr(i, 1) {
            return 1
        }
        i = i + 1
    }
    return 0
}

/// 去符号与前导零（保留个位）。输入须为合法整数字面量 span。
fn digits_norm(span str) str {
    var t str = span
    if t.substr(0, 1) == "-" {
        t = t.substr(1, t.len() - 1)
    }
    while t.len() > 1 {
        if t.substr(0, 1) == "0" {
            t = t.substr(1, t.len() - 1)
        } else {
            break
        }
    }
    return t
}

/// F-15/T-23：整数字面量是否落在 i32 可无损表示范围
/// [-2147483648, 2147483647]（词法比较，不经过 to_int/typed 绑定——
/// 两者对 2^31 起 wrap、2^63 起归零/舍入，t11/p5 探针实测）。
fn span_is_i32(span str) bool {
    if !span_is_int(span) {
        return false
    }
    let norm str = digits_norm(span)
    if norm == "0" {
        return true
    }
    if span.substr(0, 1) == "-" {
        return digits_cmp(norm, "2147483648") <= 0
    }
    return digits_cmp(norm, "2147483647") <= 0
}

/// 值形态判别（按首非空白字符）：返回 "str"|"num"|"bool"|"null"|"obj"|"arr"|"bad"。
pub fn value_kind(s str, i int) str {
    let j int = skip_ws(s, i)
    if j >= s.len() {
        return "bad"
    }
    let c str = s.substr(j, 1)
    if c == "\"" {
        return "str"
    }
    if c == "-" || c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9" {
        return "num"
    }
    if c == "t" || c == "f" {
        return "bool"
    }
    if c == "n" {
        return "null"
    }
    if c == "{" {
        return "obj"
    }
    if c == "[" {
        return "arr"
    }
    return "bad"
}

/// 引号串去转义：span 为完整 "\"...\"" 形态，经 json.parse 还原。
/// 失败/结果为空返回 ""（调用方字段语义下 "" 均按缺省/无效处理）。
pub fn unquote(s str) str {
    var out str = ""
    try {
        let v = json.parse(s)
        out = "" + v
    } catch {
        out = ""
    }
    return out
}

/// 已知键集合判定（state）。返回 1=已知，0=未知。
fn known_state_key(key str) int {
    if key == "book_id" {
        return 1
    }
    if key == "chapter_number" {
        return 1
    }
    if key == "paragraph_index" {
        return 1
    }
    if key == "para_hash" {
        return 1
    }
    if key == "para_text" {
        return 1
    }
    if key == "quote_prefix" {
        return 1
    }
    if key == "font_size" {
        return 1
    }
    if key == "line_height" {
        return 1
    }
    if key == "updated_at" {
        return 1
    }
    return 0
}

/// state 键期望形态：整数字段与字符串字段在 JSON 词法层统一以 "num"/"str"
/// 判别（JSON 无独立整数类型）；整数性由调用点追加「无小数/指数字面量」检查。
fn state_key_kind(key str) str {
    if key == "chapter_number" {
        return "num"
    }
    if key == "paragraph_index" {
        return "num"
    }
    if key == "updated_at" {
        return "num"
    }
    return "str"
}

/// 数字字面量是否为纯整数形态（无小数/指数）。span 已由 scan_number_end 保证合法。
fn span_is_int(span str) bool {
    if span.find(".") >= 0 {
        return false
    }
    if span.find("e") >= 0 {
        return false
    }
    if span.find("E") >= 0 {
        return false
    }
    return true
}

/// ReadingState 词法校验（F-09 落地面）。规则：
///   顶层必须是对象；已知键不得重复；类型必须精确（int 键必须是整数字面量，
///   str 键必须是引号串——数字串冒充整数拒绝）；未知键容忍；结构非法/
///   尾随内容拒绝。合法空白与转义属性名兼容（键经 unquote 归一）。
/// 返回 "" = 合法；非空 = 错误消息。
pub fn valid_state(raw str) str {
    let t str = raw.trim()
    var i int = skip_ws(t, 0)
    if i >= t.len() || t.substr(i, 1) != "{" {
        return "state must be a JSON object"
    }
    i = skip_ws(t, i + 1)
    var seen_book_id int = 0
    var seen_ch int = 0
    var seen_pi int = 0
    var seen_hash int = 0
    var seen_text int = 0
    var seen_quote int = 0
    var seen_font int = 0
    var seen_line int = 0
    var seen_ua int = 0
    var guard int = 0
    while i < t.len() {
        if guard > 4096 {
            return "state object too large"
        }
        guard = guard + 1
        if t.substr(i, 1) == "}" {
            i = skip_ws(t, i + 1)
            if i != t.len() {
                return "state has trailing content"
            }
            return ""
        }
        if t.substr(i, 1) == "," {
            i = skip_ws(t, i + 1)
            if i < t.len() {
                if t.substr(i, 1) == "}" {
                    return "state unexpected trailing comma"
                }
            }
            continue
        }
        if t.substr(i, 1) != "\"" {
            return "state expected property name"
        }
        let ke int = scan_string_end(t, i)
        if ke < 0 {
            return "state bad property name"
        }
        let key str = unquote(t.substr(i, ke - i))
        i = skip_ws(t, ke)
        if i >= t.len() || t.substr(i, 1) != ":" {
            return "state expected colon"
        }
        i = skip_ws(t, i + 1)
        let ve int = scan_value_end(t, i, 0)
        if ve < 0 {
            return "state bad value"
        }
        let kind str = value_kind(t, i)
        if known_state_key(key) == 1 {
            var seen int = 0
            if key == "book_id" {
                seen = seen_book_id
            }
            if key == "chapter_number" {
                seen = seen_ch
            }
            if key == "paragraph_index" {
                seen = seen_pi
            }
            if key == "para_hash" {
                seen = seen_hash
            }
            if key == "para_text" {
                seen = seen_text
            }
            if key == "quote_prefix" {
                seen = seen_quote
            }
            if key == "font_size" {
                seen = seen_font
            }
            if key == "line_height" {
                seen = seen_line
            }
            if key == "updated_at" {
                seen = seen_ua
            }
            if seen == 1 {
                return "state duplicate key: " + key
            }
            if key == "book_id" {
                seen_book_id = 1
            }
            if key == "chapter_number" {
                seen_ch = 1
            }
            if key == "paragraph_index" {
                seen_pi = 1
            }
            if key == "para_hash" {
                seen_hash = 1
            }
            if key == "para_text" {
                seen_text = 1
            }
            if key == "quote_prefix" {
                seen_quote = 1
            }
            if key == "font_size" {
                seen_font = 1
            }
            if key == "line_height" {
                seen_line = 1
            }
            if key == "updated_at" {
                seen_ua = 1
            }
            let want str = state_key_kind(key)
            if kind != want {
                return "state key " + key + " must be " + want
            }
            if want == "num" {
                let span str = t.substr(i, ve - i)
                if !span_is_int(span) {
                    return "state key " + key + " must be an integer"
                }
            }
        }
        i = skip_ws(t, ve)
    }
    return "state object not closed"
}

/// library.json 词法校验（F-11 落地面）。规则：
///   顶层对象；version 必须为整数字面量 1（引号串/浮点/缺失常拒）；
///   books 必须为数组（对象/null/缺失常拒——不把损坏形态当空库）；
///   每条记录必须是对象且必需字段齐备、类型正确（6 str + 4 int）、
///   记录内已知键重复拒绝；未知键容忍。
/// 返回 "" = 合法；非空 = 错误消息（调用方一律 refuse-to-load 保留原件）。
pub fn valid_index(raw str) str {
    let t str = raw.trim()
    var i int = skip_ws(t, 0)
    if i >= t.len() || t.substr(i, 1) != "{" {
        return "index must be a JSON object"
    }
    i = skip_ws(t, i + 1)
    var ver_ok int = 0
    var books_ok int = 0
    var books_start int = -1
    var books_end int = -1
    var guard int = 0
    while i < t.len() {
        if guard > 4096 {
            return "index object too large"
        }
        guard = guard + 1
        if t.substr(i, 1) == "}" {
            i = skip_ws(t, i + 1)
            if i != t.len() {
                return "index has trailing content"
            }
            break
        }
        if t.substr(i, 1) == "," {
            i = skip_ws(t, i + 1)
            if i < t.len() {
                if t.substr(i, 1) == "}" {
                    return "index unexpected trailing comma"
                }
            }
            continue
        }
        if t.substr(i, 1) != "\"" {
            return "index expected property name"
        }
        let ke int = scan_string_end(t, i)
        if ke < 0 {
            return "index bad property name"
        }
        let key str = unquote(t.substr(i, ke - i))
        i = skip_ws(t, ke)
        if i >= t.len() || t.substr(i, 1) != ":" {
            return "index expected colon"
        }
        i = skip_ws(t, i + 1)
        let ve int = scan_value_end(t, i, 0)
        if ve < 0 {
            return "index bad value"
        }
        if key == "version" {
            if ver_ok == 1 {
                return "index duplicate key: version"
            }
            let kind str = value_kind(t, i)
            if kind != "num" {
                return "index version must be a number"
            }
            let span str = t.substr(i, ve - i)
            if span.find(".") >= 0 || span.find("e") >= 0 || span.find("E") >= 0 {
                return "index version must be an integer"
            }
            let nv int = span.to_int()
            let back str = nv.to_string()
            if back != span {
                return "index version must be the integer 1"
            }
            if nv != 1 {
                return "index version must be the integer 1"
            }
            ver_ok = 1
        }
        if key == "books" {
            if books_ok == 1 {
                return "index duplicate key: books"
            }
            let kind str = value_kind(t, i)
            if kind != "arr" {
                return "index books must be an array"
            }
            books_ok = 1
            books_start = i
            books_end = ve
        }
        i = skip_ws(t, ve)
    }
    if ver_ok == 0 {
        return "index missing version"
    }
    if books_ok == 0 {
        return "index missing books"
    }
    // 记录逐条验证（books 数组区间内）
    var j int = skip_ws(t, books_start + 1)
    let be int = books_end
    var rguard int = 0
    while j < be {
        if rguard > 100000 {
            return "index books too large"
        }
        rguard = rguard + 1
        if t.substr(j, 1) == "]" {
            break
        }
        if t.substr(j, 1) == "," {
            j = skip_ws(t, j + 1)
            continue
        }
        if t.substr(j, 1) != "{" {
            return "index book record must be an object"
        }
        let re int = scan_value_end(t, j, 1)
        if re < 0 || re > be {
            return "index bad book record"
        }
        let rerr str = valid_record(t, j, re)
        if rerr != "" {
            return rerr
        }
        j = skip_ws(t, re)
    }
    return ""
}

/// 单条记录验证：必需字段齐备 + 类型精确 + 已知键重复拒绝。
fn valid_record(t str, start int, end int) str {
    var i int = skip_ws(t, start + 1)
    var seen_id int = 0
    var seen_hash int = 0
    var seen_title int = 0
    var seen_author int = 0
    var seen_format int = 0
    var seen_opath int = 0
    var seen_mpath int = 0
    var seen_size int = 0
    var seen_cc int = 0
    var seen_iv int = 0
    var seen_ca int = 0
    var guard int = 0
    while i < end {
        if guard > 512 {
            return "index record too large"
        }
        guard = guard + 1
        if t.substr(i, 1) == "}" {
            break
        }
        if t.substr(i, 1) == "," {
            i = skip_ws(t, i + 1)
            if i < end {
                if t.substr(i, 1) == "}" {
                    return "index record unexpected trailing comma"
                }
            }
            continue
        }
        if t.substr(i, 1) != "\"" {
            return "index record expected property name"
        }
        let ke int = scan_string_end(t, i)
        if ke < 0 {
            return "index record bad property name"
        }
        let key str = unquote(t.substr(i, ke - i))
        i = skip_ws(t, ke)
        if i >= end || t.substr(i, 1) != ":" {
            return "index record expected colon"
        }
        i = skip_ws(t, i + 1)
        let ve int = scan_value_end(t, i, 2)
        if ve < 0 || ve > end {
            return "index record bad value"
        }
        let kind str = value_kind(t, i)
        var span str = ""
        if kind == "num" {
            span = t.substr(i, ve - i)
        }
        var dup int = 0
        if key == "book_id" {
            dup = seen_id
            seen_id = 1
            if kind != "str" {
                return "index record book_id must be a string"
            }
        } else {
            if key == "source_hash" {
                dup = seen_hash
                seen_hash = 1
                if kind != "str" {
                    return "index record source_hash must be a string"
                }
            } else {
                if key == "title" {
                    dup = seen_title
                    seen_title = 1
                    if kind != "str" {
                        return "index record title must be a string"
                    }
                } else {
                    if key == "author" {
                        dup = seen_author
                        seen_author = 1
                        if kind != "str" {
                            return "index record author must be a string"
                        }
                    } else {
                        if key == "format" {
                            dup = seen_format
                            seen_format = 1
                            if kind != "str" {
                                return "index record format must be a string"
                            }
                        } else {
                            if key == "original_path" {
                                dup = seen_opath
                                seen_opath = 1
                                if kind != "str" {
                                    return "index record original_path must be a string"
                                }
                            } else {
                                if key == "managed_path" {
                                    dup = seen_mpath
                                    seen_mpath = 1
                                    if kind != "str" {
                                        return "index record managed_path must be a string"
                                    }
                                } else {
                                    if key == "size" {
                                        dup = seen_size
                                        seen_size = 1
                                        if kind != "num" {
                                            return "index record size must be a number"
                                        }
                                        if !span_is_i32(span) {
                                            return "index record size out of i32 range"
                                        }
                                    } else {
                                        if key == "chapter_count" {
                                            dup = seen_cc
                                            seen_cc = 1
                                            if kind != "num" {
                                                return "index record chapter_count must be a number"
                                            }
                                            if !span_is_i32(span) {
                                                return "index record chapter_count out of i32 range"
                                            }
                                        } else {
                                            if key == "import_version" {
                                                dup = seen_iv
                                                seen_iv = 1
                                                if kind != "num" {
                                                    return "index record import_version must be a number"
                                                }
                                                if !span_is_i32(span) {
                                                    return "index record import_version out of i32 range"
                                                }
                                            } else {
                                                if key == "created_at" {
                                                    dup = seen_ca
                                                    seen_ca = 1
                                                    if kind != "num" {
                                                        return "index record created_at must be a number"
                                                    }
                                                    if !span_is_i32(span) {
                                                        return "index record created_at out of i32 range"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if dup == 1 {
            return "index record duplicate key: " + key
        }
        i = skip_ws(t, ve)
    }
    if seen_id == 0 {
        return "index record missing book_id"
    }
    if seen_hash == 0 {
        return "index record missing source_hash"
    }
    if seen_title == 0 {
        return "index record missing title"
    }
    if seen_author == 0 {
        return "index record missing author"
    }
    if seen_format == 0 {
        return "index record missing format"
    }
    if seen_opath == 0 {
        return "index record missing original_path"
    }
    if seen_mpath == 0 {
        return "index record missing managed_path"
    }
    if seen_size == 0 {
        return "index record missing size"
    }
    if seen_cc == 0 {
        return "index record missing chapter_count"
    }
    if seen_iv == 0 {
        return "index record missing import_version"
    }
    if seen_ca == 0 {
        return "index record missing created_at"
    }
    return ""
}

// ---- 同模块单测（自包含零 use——测试装置兼容面） ----
fn expect(cond bool) {
    if cond {
        assert_eq(1, 1)
    } else {
        assert_eq(1, 0)
    }
}

#[test]
fn t_valid_state() {
    expect(valid_state("{\"book_id\":\"a\",\"chapter_number\":1,\"paragraph_index\":-1,\"para_hash\":\"sig1:0:1\",\"font_size\":\"medium\",\"line_height\":\"comfy\",\"updated_at\":0}") == "")
    expect(valid_state("{ \"book_id\" : \"a\" , \"chapter_number\" : 2 , \"paragraph_index\" : 0 , \"para_hash\" : \"sig1:2:1\" , \"font_size\" : \"large\" , \"line_height\" : \"comfy\" , \"updated_at\" : 0 }") == "")
    expect(valid_state("{\"book_id\":\"a\",\"chapter_number\":\"1\"}") != "")
    expect(valid_state("{\"book_id\":\"a\",\"chapter_number\":1.5}") != "")
    expect(valid_state("{\"book_id\":\"a\",\"book_id\":\"b\"}") != "")
    expect(valid_state("{\"book_id\":\"a\",\"chapter_number\":true}") != "")
    expect(valid_state("{\"book_id\":\"a\",\"chapter_number\":null}") != "")
    expect(valid_state("{\"book_id\":\"a\",}") != "")
    expect(valid_state("[]") != "")
    expect(valid_state("{\"book_id\":\"a\"}") == "")
}

#[test]
fn t_valid_index() {
    expect(valid_index("{\"version\":1,\"books\":[]}") == "")
    expect(valid_index("{\"books\":[],\"version\":1}") == "")
    expect(valid_index("{\"version\":\"1\",\"books\":[]}") != "")
    expect(valid_index("{\"version\":1.0,\"books\":[]}") != "")
    expect(valid_index("{\"version\":1,\"books\":{}}") != "")
    expect(valid_index("{\"version\":1,\"books\":null}") != "")
    expect(valid_index("{\"books\":[]}") != "")
    expect(valid_index("{\"version\":1,\"books\":[{\"book_id\":\"a\",\"source_hash\":\"ph1:1:1\",\"title\":\"t\",\"author\":\"a\",\"format\":\"txt\",\"original_path\":\"p\",\"managed_path\":\"m\",\"size\":3,\"chapter_count\":1,\"import_version\":1,\"created_at\":0}]}") == "")
    expect(valid_index("{\"version\":1,\"books\":[{\"book_id\":5}]}") != "")
    expect(valid_index("{\"version\":1,\"books\":[{\"book_id\":\"a\",\"source_hash\":\"h\",\"title\":\"t\",\"author\":\"a\",\"format\":\"txt\",\"original_path\":\"o\",\"managed_path\":\"m\",\"size\":1.5,\"chapter_count\":1,\"import_version\":1,\"created_at\":0}]}") != "")
    expect(valid_index("{\"version\":1,\"books\":[{\"book_id\":\"a\",\"source_hash\":\"h\",\"title\":\"t\",\"author\":\"a\",\"format\":\"txt\",\"original_path\":\"o\",\"managed_path\":\"m\",\"size\":1,\"chapter_count\":1.5,\"import_version\":1,\"created_at\":0}]}") != "")
    expect(valid_index("{\"version\":1,\"books\":[{\"book_id\":\"a\",\"source_hash\":\"h\",\"title\":\"t\",\"author\":\"a\",\"format\":\"txt\",\"original_path\":\"o\",\"managed_path\":\"m\",\"size\":1,\"chapter_count\":1,\"import_version\":1.5,\"created_at\":0}]}") != "")
    expect(valid_index("{\"version\":1,\"books\":[{\"book_id\":\"a\",\"source_hash\":\"h\",\"title\":\"t\",\"author\":\"a\",\"format\":\"txt\",\"original_path\":\"o\",\"managed_path\":\"m\",\"size\":1,\"chapter_count\":1,\"import_version\":1,\"created_at\":1.5e2}]}") != "")
    expect(valid_index("{\"version\":1,\"books\":[{\"book_id\":\"a\",\"book_id\":\"b\"}]}") != "")
    expect(valid_index("{\"version\":1,\"books\":[\"x\"]}") != "")
    expect(valid_index("{\"version\":1,\"books\":[],\"extra\":{\"k\":1}}") == "")
}
