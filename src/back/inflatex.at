    t.push(3)
    t.push(4)
    t.push(5)
    t.push(6)
    t.push(7)
    t.push(8)
    t.push(9)
    t.push(10)
    t.push(11)
    t.push(13)
    t.push(15)
    t.push(17)
    t.push(19)
    t.push(23)
    t.push(27)
    t.push(31)
    t.push(35)
    t.push(43)
    t.push(51)
    t.push(59)
    t.push(67)
    t.push(83)
    t.push(99)
    t.push(115)
    t.push(131)
    t.push(163)
    t.push(195)
    t.push(227)
    t.push(258)
}

