/// 码长字母表读取顺序填充（RFC 1951 §3.2.7，19 项）。
fn fill_cl_order(t List<int>) {
    t.push(16)
    t.push(17)
    t.push(18)
    t.push(0)
    t.push(8)
    t.push(7)
