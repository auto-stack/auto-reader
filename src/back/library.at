// library.at — READER-001 真实书库存储、导入事务与位置恢复数据服务。
// 职责：受管副本、library.json 索引、去重（source_hash）、可恢复移除。
// 双轨纪律（T-00 能力报告）：只用 a2r 已映射 native——fs.exists/is_dir/
// file_size/read_text/write_text/create_dir、File.read_text_range、str.uuid、
// Env.get、json.parse；路径助手用 pathx（fs.join/parent 等 VM-only）。
// 持久化写侧手工转义（pathx.json_escape），读侧 json.parse——json.encode
// 对动态 map 在 VM 轨只回内部句柄，不可用作持久化（实测记录）。
//
// 无状态 + JSON 字符串表面（T-01 实测裁定，VM/a2r 缺陷规避）：
//   a) 不做进程内缓存——跨调用的类型化 struct 列表元素字段读取不稳。
//      每次公开调用从 library.json 现读、改完即写；单写入者（同数据目录
//      同时只跑一个运行时实例），并发写不在 v1 范围。
//   b) 本模块不构造、不引用 api 端点类型——非 api/db 模块构造 api 导入
//      类型在 a2r 转译面报 undefined（T-01 实测）。公开面全部为标量与
//      JSON 字符串；db.at 解析后构造端点类型（基线 create_book 已证 db.at
//      可构造 api 类型）。
//   c) struct/List 不作 fn 参数；fn 实参先绑定局部变量；拼接链每步
//      ≤2 操作数。
//   d) json.parse 数组用 for-in 遍历（len()/索引有在册缺陷 F-8）。
//
// 数据目录（AUTO_READER_DATA env → USERPROFILE/.autoreader → ./.autoreader-data）：
//   library.json          书目索引（全部记录，version:1）
//   library.json.bak      上一次成功写入前的备份（AC-05 迁移前备份）
//   removed.jsonl         移除记录（JSONL，可恢复；restore 后行剔除）
//   books/<hash 目录>/original.<ext>   受管副本（按内容指纹寻址）
//
// 导入事务：校验（存在/非目录/非空/可解码）→ ph1 指纹（候选索引）→
// 同指纹记录逐字核对受管副本（F-02：采样指纹可确定性碰撞，不核对必串文）
// → 资产槽位分配（主槽 + d1..d64 隔离槽，碰撞不复用错误资产）→ 受管副本
// 落盘并读回校验（F-03）→ 追加索引（备份/暂存/提交协议，F-06）→ 索引落盘；
// 任一步失败不产生"成功却缺原文件"的记录。
// 编码检测双轨：envelope total==-1（头部 64KB）+ read_text 长度对账全文。

use pathx: join, basename, stem_of, mkdirs, json_escape, normalize, parent
use hashx: ph1
use jsonx: valid_index, valid_state, valid_removed_entry, valid_locator_document
use importers: parse_book_json, format_of, scan_meta_json
use epub: epub_import_json, epub_toc_json, epub_chapter_json, epub_img_type_of, epub_href_at
use locator: count_occurrences, count_occurrences_fast, locator_canonical, locator_emit, has_locator

fn empty_str() str {
    return ""
}

/// 受管文件与给定全文的逐字比较（F-02 修复：ph1 只是候选索引，去重与
/// 资产复用必须核对完整内容）。
/// 返回 1 = 内容逐字相等；0 = 存在但内容不同（碰撞/损坏）；-1 = 不存在。
fn content_equal(path str, text str) int {
    if !fs.exists(path) {
        return -1
    }
    let cur str = fs.read_text(path)
    if cur == text {
        return 1
    }
    return 0
}

// ═══════════════════════════════════════════════════════════
// 路径
// ═══════════════════════════════════════════════════════════

/// 数据目录解析（每次调用重算，AUTO_READER_DATA 可在启动前注入）。
pub fn data_dir() str {
    let env str = Env.get("AUTO_READER_DATA")
    if env != "" {
        return normalize(env)
    }
    var home str = Env.get("USERPROFILE")
    if home == "" {
        home = Env.get("HOME")
    }
    if home != "" {
        let nh str = normalize(home)
        return nh + "/.autoreader"
    }
    return "./.autoreader-data"
}

fn lib_path() str {
    let dd str = data_dir()
    return join(dd, "library.json")
}

fn removed_path() str {
    let dd str = data_dir()
    return join(dd, "removed.jsonl")
}

pub fn hash_dir_of(source_hash str) str {
    // ':' 在 Windows 目录名非法 → '-'
    var d str = ""
    var i int = 0
    while i < source_hash.len() {
        let c str = source_hash.substr(i, 1)
        if c == ":" {
            d = d + "-"
        } else {
            d = d + c
        }
        i = i + 1
    }
    return d
}

// ═══════════════════════════════════════════════════════════
// 序列化助手（只收标量参数）
// ═══════════════════════════════════════════════════════════

/// 单条记录 JSON（标量入参，步进构建）。
fn record_json(v1 str, v2 str, v3 str, v4 str, v5 str, v6 str, v7 str, n1 int, n2 int, n3 int, n4 int) str {
    var out str = "{\"book_id\":\""
    out = out + json_escape(v1)
    out = out + "\",\"source_hash\":\""
    out = out + json_escape(v2)
    out = out + "\",\"title\":\""
    out = out + json_escape(v3)
    out = out + "\",\"author\":\""
    out = out + json_escape(v4)
    out = out + "\",\"format\":\""
    out = out + json_escape(v5)
    out = out + "\",\"original_path\":\""
    out = out + json_escape(v6)
    out = out + "\",\"managed_path\":\""
    out = out + json_escape(v7)
    out = out + "\",\"size\":"
    out = out + n1.to_string()
    out = out + ",\"chapter_count\":"
    out = out + n2.to_string()
    out = out + ",\"import_version\":"
    out = out + n3.to_string()
    out = out + ",\"created_at\":"
    out = out + n4.to_string()
    out = out + "}"
    return out
}

/// 单章 JSON（标量入参）。
pub fn chapter_json_raw(n int, title str, body str, wc int) str {
    var out str = "{\"number\":"
    out = out + n.to_string()
    out = out + ",\"title\":\""
    out = out + json_escape(title)
    out = out + "\",\"body\":\""
    out = out + json_escape(body)
    out = out + "\",\"word_count\":"
    out = out + wc.to_string()
    out = out + "}"
    return out
}

/// 现读 library.json 并重序列化为规范全文（动态值直读——可靠形态）。
/// 加载语义（F-06 修复）：**缺文件**才可初始化为空表；存在但为空、解析
/// 失败、版本 ≠1、缺 books 或记录缺字段——一律返回 ""（refuse-to-load），
/// 调用方拒写并保留原件（人工迁移/诊断），绝不把损坏索引当新库覆盖。
pub fn books_json() str {
    let lp str = lib_path()
    if !fs.exists(lp) {
        return "{\"version\":1,\"books\":[]}"
    }
    let raw str = fs.read_text(lp)
    if raw == "" {
        return ""
    }
    // F-11 修正：词法级结构门（jsonx）——version 必须为整数字面量 1、
    // books 必须为数组、每条记录必需字段齐备且类型精确。对象/null/缺失
    // 等错误形态一律 refuse-to-load（返回 ""，调用方拒写并保留原件），
    // 绝不把损坏索引当空库覆盖。json.parse 对畸形输入会 raise，动态层
    // 无法类型判别（t11 探针实测）——词法校验先行，之后解析才安全。
    let verr str = valid_index(raw)
    if verr != "" {
        return ""
    }
    var out str = ""
    // json.parse 对畸形输入会 raise（t05 探针实测）；缺字段访问同样
    // raise——解析/版本/形态任一失败都归一为 ""，不让异常穿透到端点。
    try {
        let parsed = json.parse(raw)
        let ver int = parsed.version
        if ver == 1 {
            let books = parsed.books
            var acc str = "{\"version\":1,\"books\":["
            var i int = 0
            // json.parse 数组用 for-in（F-8）；fn 实参先绑定局部
            for b in books {
                if i > 0 {
                    acc = acc + ","
                }
                let v1 str = "" + b.book_id
                let v2 str = "" + b.source_hash
                let v3 str = "" + b.title
                let v4 str = "" + b.author
                let v5 str = "" + b.format
                let v6 str = "" + b.original_path
                let v7 str = "" + b.managed_path
                let n1 int = b.size
                let n2 int = b.chapter_count
                let n3 int = b.import_version
                let n4 int = b.created_at
                let rj str = record_json(v1, v2, v3, v4, v5, v6, v7, n1, n2, n3, n4)
                acc = acc + rj
                i = i + 1
            }
            acc = acc + "]}"
            out = acc
        }
    } catch {
        out = ""
    }
    return out
}

/// 按 book_id 取单条记录 JSON；未找到返回 ""。
pub fn book_json(book_id str) str {
    let cur str = books_json()
    let parsed = json.parse(cur)
    let books = parsed.books
    for b in books {
        let v1 str = "" + b.book_id
        if v1 == book_id {
            let v2 str = "" + b.source_hash
            let v3 str = "" + b.title
            let v4 str = "" + b.author
            let v5 str = "" + b.format
            let v6 str = "" + b.original_path
            let v7 str = "" + b.managed_path
            let n1 int = b.size
            let n2 int = b.chapter_count
            let n3 int = b.import_version
            let n4 int = b.created_at
            return record_json(v1, v2, v3, v4, v5, v6, v7, n1, n2, n3, n4)
        }
    }
    return empty_str()
}

/// 读回校验写入（F-03/F-06）：write_text 对目录等失败形态会静默返回 0
/// （t05 探针实测）——返回码之外必须读回逐字比较。
/// 返回 0 = 写入且读回逐字一致；非 0 = write_text 返回码或 -1（读回不符）。
pub fn verified_write(path str, payload str) int {
    let wrc int = fs.write_text(path, payload)
    if wrc != 0 {
        return wrc
    }
    let back str = fs.read_text(path)
    if back != payload {
        return -1
    }
    return 0
}

/// 备份 + 暂存校验 + 提交的写协议（F-06 修复）。目标已存在时先写 .bak
/// 并读回校验——备份失败、现内容为空/不可读、目标被目录占位一律中止
/// （返回负码），目标不被触碰；.bak 就绪后先写 .tmp 读回校验（暂存），
/// 再提交正式文件并读回校验；提交不一致时尽力从 .bak 还原原件。
/// 注意：运行时无 rename/delete 原子原语（T-00 映射集），本协议是
/// 「已验证的暂存-提交-恢复」尽力保证，不冒充断电级原子性（如实记录）。
/// 返回 0 = 成功；-2 目标是目录；-3 现内容为空/不可读；-4 备份失败；
/// -5 暂存失败；其余 = write_text/verified_write 返回码。
pub fn write_with_backup(path str, payload str) int {
    if fs.exists(path) {
        if fs.is_dir(path) {
            return -2
        }
        let prev str = fs.read_text(path)
        if prev == "" {
            return -3
        }
        let bak str = path + ".bak"
        let brc int = verified_write(bak, prev)
        if brc != 0 {
            return -4
        }
    }
    let tmp str = path + ".tmp"
    let trc int = verified_write(tmp, payload)
    if trc != 0 {
        return -5
    }
    let wrc int = verified_write(path, payload)
    if wrc != 0 {
        let bak2 str = path + ".bak"
        if fs.exists(bak2) {
            if !fs.is_dir(bak2) {
                let prev2 str = fs.read_text(bak2)
                if prev2 != "" {
                    fs.write_text(path, prev2)
                }
            }
        }
        return wrc
    }
    return 0
}

/// 索引落盘（含 AC-05 迁移前备份）。payload 为完整 library.json 内容，
/// 经备份/暂存/提交协议写入（write_with_backup）。
pub fn write_library_file(payload str) int {
    let lp str = lib_path()
    let dd str = data_dir()
    let mrc int = mkdirs(dd)
    if mrc != 0 {
        return mrc
    }
    return write_with_backup(lp, payload)
}

/// 受管副本全文（书不存在或文件被外删时回 ""，由调用方报缺失）。
pub fn content_of(book_id str) str {
    let rj str = book_json(book_id)
    if rj == "" {
        return ""
    }
    let r = json.parse(rj)
    let mp str = "" + r.managed_path
    if !fs.exists(mp) {
        return ""
    }
    return fs.read_text(mp)
}

// ═══════════════════════════════════════════════════════════
// 目录与单章（JSON 字符串面）
// ═══════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════
// 章 meta 索引（PLAN-781 阶段 E / T-25）
//
// 导入时 scan_meta_json 一次扫描产出 <data>/<book_id>.meta.json（书级
// 统计 + 每章 {number,title,body_off,body_len,word_count}，UTF-8 字节
// 偏移与 File.read_text_range 窗读同空间）。TOC/单章此后**不再整书重
// 解析**——旧路径每次 toc/chapter GET 都 parse_book_json 全文（10MiB
// 书 ~170s 忙段），新路径 = meta 直读 + 章窗 O(章) 读。受管副本不可变
// + source_hash 钉死 ⇒ 索引永免失效。meta 缺失/损坏 → 诚实失败
///（title="索引缺失" / toc=[]），不静默重建——重建属显式修复动作。
// ═══════════════════════════════════════════════════════════

/// meta 边车路径：<data>/<book_id>.meta.json。
pub fn meta_path(book_id str) str {
    let dd str = data_dir()
    return join(dd, book_id + ".meta.json")
}

/// meta 写入：verified_write（F-03 同款读回校验）；rc=0 成功。
fn write_meta(book_id str, meta_json str) int {
    return verified_write(meta_path(book_id), meta_json)
}

/// 数字字段消费域探测（F-781-R05 r6）：**非负 VM 整数（含合法 0）**。
/// `type_of(x)`（VM 原生类型谓词，auto#1527）精确区分 int/float/str/
/// bool/null——浮点 0.0 与 int 0 可靠分离（r5 的字符串形态判别对 0.0
/// 失真：其位模式恰为 0、两形同为 "0"；且该判别受池/槽混叠波及——
/// 复审 r6 指令不再依赖"浮点两形必不一致"前提）。`> -1` 拒负值。
fn num_domain_ok(x) bool {
    if type_of(x) != "int" {
        return false
    }
    if !(x > -1) {
        return false
    }
    return true
}

/// meta 读取 + 轻量准入：缺失/空/前缀后缀不符 → ""；解析与**全部必
/// 需字段存在性探测**（顶层 4 + 条目 5，`"" +` 拼接使 None 必然
/// TypeError）在本帧 try 内完成（F-781-R05 r4 修复轮：缺数字字段曾
/// 经 typed 绑定静默流过 → 章节空正文假成功；E01 引擎根修后 catch
/// 不毒化调用方，本形态安全）。畸形 JSON/任一必需字段缺失 → catch
/// 归一 ""（索引缺失）。错类型标量为既有动态类型边界（静默强转、
/// 不崩溃不毒化；词法级严拒需类型谓词原语，超出本轮）——t07 S9 记
/// 录该边界形态。
pub fn load_meta(book_id str) str {
    let mp str = meta_path(book_id)
    if !fs.exists(mp) {
        return ""
    }
    let raw str = fs.read_text(mp)
    if raw == "" {
        return ""
    }
    if !raw.starts_with("{\"version\":1,") {
        return ""
    }
    if !raw.ends_with("]}") {
        return ""
    }
    var out str = ""
    try {
        let m = json.parse(raw)
        // F-781-R05（r4 修复轮）：全部必需字段探测——存在性（`"" +`
        // 拼接使 None 必然 TypeError；动态缺失值在 typed 绑定不 raise，
        // 复审反例：缺 body_len → 章节空正文假成功）+ 数字字段消费前
        // 提（`> -1` 对字符串/负数为 false 且不 raise——偏移/长度/计
        // 数结构上非负；错类型数字字段同拒，非 SD-11 边界）。字符串字
        // 段（title/source_sha256）仅查存在性（值语义松转换无害）。
        let p_sh str = "" + m.source_sha256
        if !num_domain_ok(m.version) {
            return ""
        }
        if ("" + m.version) != "1" {
            return ""
        }
        if !num_domain_ok(m.total_chapters) {
            return ""
        }
        if !num_domain_ok(m.total_words) {
            return ""
        }
        for c in m.chapters {
            let q2 str = "" + c.title
            if !num_domain_ok(c.number) {
                return ""
            }
            if !num_domain_ok(c.body_off) {
                return ""
            }
            if !num_domain_ok(c.body_len) {
                return ""
            }
            if !num_domain_ok(c.word_count) {
                return ""
            }
        }
        out = raw
    } catch {
        out = ""
    }
    return out
}

/// 真实书目录 JSON：[{"number":n,"title":t},...]；书缺失/副本缺失/
/// meta 缺失 → []（前端按无章处理）。
pub fn toc_json(book_id str) str {
    let rj str = book_json(book_id)
    if rj == empty_str() {
        return "[]"
    }
    let r = json.parse(rj)
    let fmt str = "" + r.format
    if fmt == "epub" {
        let meta str = load_epub_meta(book_id)
        if meta == "" {
            return "[]"
        }
        let m = json.parse(meta)
        let hrefs str = "" + m.spine
        let toc str = "" + m.toc
        return epub_toc_json(hrefs, toc)
    }
    let mp str = "" + r.managed_path
    if !fs.exists(mp) {
        return "[]"
    }
    // 空副本（导入后被清空的损坏资产，t06 S7 语义）与缺失同判。
    if fs.size(mp) <= 0 {
        return "[]"
    }
    let raw str = load_meta(book_id)
    if raw == "" {
        return "[]"
    }
    // load_meta 已完成解析/必需字段探测（E01 根修后 catch 不毒化）——
    // 此处再解析为纯解析（结构已证合法），直线代码零 raise。
    let m = json.parse(raw)
    let arr = m.chapters
    var out str = "["
    var i int = 0
    for it in arr {
        if i > 0 {
            out = out + ","
        }
        let n int = it.number
        let t str = "" + it.title
        let ej str = chapter_json_raw(n, t, "", 0)
        out = out + ej
        i = i + 1
    }
    out = out + "]"
    return out
}

/// 真实书单章 JSON（meta 路径）：meta 命中 → File.read_text_range 只读
/// 该章字节窗（标题/词数直读 meta；正文 trim/word_count 语义由
/// chapter_json_raw 保持）。书/副本/章节缺失沿用占位对象约定
/// （word_count=0，前端按未找到处理）；meta 缺失/窗读失败为诚实失败
/// 占位（"索引缺失"/"内容缺失"）。
pub fn chapter_json(book_id str, number int) str {
    let rj str = book_json(book_id)
    if rj == empty_str() {
        return chapter_json_raw(number, "内容缺失", "", 0)
    }
    let r = json.parse(rj)
    let fmt str = "" + r.format
    if fmt == "epub" {
        let meta str = load_epub_meta(book_id)
        if meta == "" {
            return chapter_json_raw(number, "内容缺失", "", 0)
        }
        let m = json.parse(meta)
        let hrefs str = "" + m.spine
        let opf_dir str = "" + m.opf_dir
        // titles 同 spine hrefs 的管道围栏形（"|t1|t2|"）：每项 "|"+title，
        // 末尾补闭合管道——T-02 探针实证：旧形自 "|" 起再拼 "|t|" 产生
        // "||t1|"，epub_href_at 首记录恒空 → 章标题恒回落 "第 N 章"
        // （003 只断言 TOC 标题未覆盖此面）。
        var titles str = ""
        let tocarr = json.parse("[]")
        let tocj str = epub_toc_json(hrefs, "" + m.toc)
        let tarr = json.parse(tocj)
        var i int = 0
        for t in tarr {
            i = i + 1
        }
        var k int = 1
        while k <= i {
            for t in tarr {
                if t.number == k {
                    titles = titles + "|"
                    titles = titles + ("" + t.title)
                }
            }
            k = k + 1
        }
        if titles != "" {
            titles = titles + "|"
        }
        let mp str = "" + r.managed_path
        return epub_chapter_json(book_id, mp, opf_dir, hrefs, number, titles)
    }
    let mp str = "" + r.managed_path
    if !fs.exists(mp) {
        return chapter_json_raw(number, "内容缺失", "", 0)
    }
    // 空副本（导入后被清空的损坏资产，t06 S7 语义）与缺失同判。
    if fs.size(mp) <= 0 {
        return chapter_json_raw(number, "内容缺失", "", 0)
    }
    let raw str = load_meta(book_id)
    if raw == "" {
        return chapter_json_raw(number, "索引缺失", "", 0)
    }
    // load_meta 已完成解析/必需字段探测（E01 根修后 catch 不毒化）；
    // 错类型标量按既有动态类型边界静默强转（不崩溃不毒化，数据级损坏
    // 由内容 oracle 捕获——t07 S6/S9）。
    let m = json.parse(raw)
    let arr = m.chapters
    for it in arr {
        if it.number == number {
            let t str = "" + it.title
            let w int = it.word_count
            var b str = ""
            let bl int = it.body_len
            if bl > 0 {
                let bo int = it.body_off
                let env str = File.read_text_range(mp, bo, bl)
                var ok bool = false
                // 同款形状门禁（envelope 自产恒 "{"text":…" 形）。
                if !env.starts_with("{\"text\":") {
                    return chapter_json_raw(number, "内容缺失", "", 0)
                }
                try {
                    let e = json.parse(env)
                    let tt int = e.total
                    if tt != -1 {
                        b = "" + e.text
                        ok = true
                    }
                } catch {
                    ok = false
                }
                if !ok {
                    return chapter_json_raw(number, "内容缺失", "", 0)
                }
            }
            // 窗文本含章间尾随换行——旧路径的 body 经 importers
            // chapter_json_raw 的 trim 语义产出；此处同口径 trim（word_count
            // 已在扫描期按同式预计算）。
            return chapter_json_raw(number, t, b.trim(), w)
        }
    }
    return chapter_json_raw(number, "章节不存在", "", 0)
}

// ═══════════════════════════════════════════════════════════
// 导入事务
// ═══════════════════════════════════════════════════════════

/// READER-005 T-02：EPUB 章图字节服务（http.file_response 承载）。
/// root 只由书目记录派生（受管副本章节缓存目录）；res 形状白名单
/// （res_ 前缀 + [A-Za-z0-9.-]，双射扁平名保证）；缺书/格式不符/非法名
/// → 指向必然不存在的名字（传输层 404），不泄露任何状态。
pub fn epub_media_response(bid str, res str) FileResponse {
    var ok bool = true
    if res.len() < 5 {
        ok = false
    }
    if ok {
        if res.substr(0, 4) != "res_" {
            ok = false
        }
    }
    if ok {
        var i int = 0
        while i < res.len() {
            let c str = res.substr(i, 1)
            var known bool = false
            if "0123456789".find(c) >= 0 {
                known = true
            }
            if "abcdefghijklmnopqrstuvwxyz".find(c) >= 0 {
                known = true
            }
            if "ABCDEFGHIJKLMNOPQRSTUVWXYZ".find(c) >= 0 {
                known = true
            }
            if c == "." {
                known = true
            }
            if c == "-" {
                known = true
            }
            if c == "_" {
                known = true
            }
            if !known {
                ok = false
                i = res.len()
            }
            i = i + 1
        }
    }
    var root str = ""
    var rel str = "__missing__"
    if ok {
        let rj str = book_json(bid)
        if rj != "" {
            let r = json.parse(rj)
            let fmt str = "" + r.format
            if fmt == "epub" {
                let mp str = "" + r.managed_path
                if mp != "" {
                    root = mp + ".chapters"
                    rel = res
                }
            }
        }
    }
    if root == "" {
        root = data_dir()
        rel = "__missing__"
    }
    var opts str = "{}"
    let ct str = epub_img_type_of(res)
    if ct != "" {
        opts = "{\"content_type\":\"" + ct + "\"}"
    }
    return http.file_response(root, rel, opts)
}

/// EPUB 索引边车路径（epub.at 消费）

/// EPUB 索引读取（诚实失败 ""）；供 toc/chapter 分支消费。
pub fn load_epub_meta(book_id str) str {
    let dd str = data_dir()
    let ep str = join(dd, book_id + ".epubmeta.json")
    if !fs.exists(ep) {
        return ""
    }
    let raw str = fs.read_text(ep)
    if raw == "" {
        return ""
    }
    if !raw.starts_with("{\"version\":1,\"kind\":\"epub\"") {
        return ""
    }
    return raw
}
pub fn write_epub_meta_file(book_id str, payload str) int {
    let dd str = data_dir()
    let mrc int = mkdirs(dd)
    if mrc != 0 {
        return mrc
    }
    let ep str = join(dd, book_id + ".epubmeta.json")
    return verified_write(ep, payload)
}

/// 导入结果 JSON：{"code","message","book_id","existing_id"}。
/// code: ok | duplicate | invalid_path | is_dir | empty_file | decode_error
/// | io_error。duplicate 时 existing_id 指向已存书目。
pub fn import_book_json(path str, author str, force bool) str {
    let trimmed str = path.trim()
    let p str = normalize(trimmed)
    if p == "" {
        return "{\"code\":\"invalid_path\",\"message\":\"路径为空\",\"book_id\":\"\",\"existing_id\":\"\"}"
    }
    if !fs.exists(p) {
        var m str = "{\"code\":\"invalid_path\",\"message\":\"文件不存在: "
        m = m + json_escape(p)
        m = m + "\",\"book_id\":\"\",\"existing_id\":\"\"}"
        return m
    }
    if fs.is_dir(p) {
        var m2 str = "{\"code\":\"is_dir\",\"message\":\"路径是目录而非文件: "
        m2 = m2 + json_escape(p)
        m2 = m2 + "\",\"book_id\":\"\",\"existing_id\":\"\"}"
        return m2
    }
    let size int = fs.file_size(p)
    if size <= 0 {
        return "{\"code\":\"empty_file\",\"message\":\"文件为空\",\"book_id\":\"\",\"existing_id\":\"\"}"
    }
    // READER-003：.epub → EPUB 导入事务（二进制容器，不做 UTF-8 预检）。
    let lower_p str = p.lower()
    if lower_p.ends_with(".epub") {
        return epub_import_json(p, author, force)
    }
    // 头部 64KB 解码检查（envelope total==-1 = 非法 UTF-8/IO 失败）
    let head_env str = File.read_text_range(p, 0, 65536)
    let head = json.parse(head_env)
    if head.total == -1 {
        return "{\"code\":\"decode_error\",\"message\":\"无法解码：不是有效的 UTF-8 文本\",\"book_id\":\"\",\"existing_id\":\"\"}"
    }
    // 全文解码对账（非法 UTF-8 时 read_text 双轨均回 ""，长度必不等）
    let text str = fs.read_text(p)
    if text.len() != size {
        return "{\"code\":\"decode_error\",\"message\":\"无法解码：文件含无效 UTF-8 序列或读取失败\",\"book_id\":\"\",\"existing_id\":\"\"}"
    }
    let fmt str = format_of(p)
    let base str = basename(p)
    let title str = stem_of(base)
    var who str = author
    if who.trim() == "" {
        who = "未知"
    }
    let hash str = ph1(text, size)
    // 去重（F-02 修复）：ph1 同值只作候选——必须读候选记录的受管副本与
    // 本次全文逐字比较；相等才是真重复，不等即指纹碰撞，不误去重、
    // 不串换正文。副本缺失（记录在而文件被外删）时无法证实同文，同样
    // 不判重，按新书导入（旧记录保持，读取面报「内容缺失」不伪造）。
    let cur str = books_json()
    if cur == "" {
        return "{\"code\":\"io_error\",\"message\":\"书库索引版本不受支持：已保留原文件，需人工迁移\",\"book_id\":\"\",\"existing_id\":\"\"}"
    }
    let parsed = json.parse(cur)
    let books = parsed.books
    var dup_id str = ""
    var dup_title str = ""
    for b in books {
        let bsh str = "" + b.source_hash
        if bsh == hash {
            let cmp str = "" + b.managed_path
            let eq int = content_equal(cmp, text)
            if eq == 1 {
                dup_id = "" + b.book_id
                dup_title = "" + b.title
            }
        }
    }
    if dup_id != "" {
        if !force {
            var dm str = "{\"code\":\"duplicate\",\"message\":\"已存在相同内容的书: "
            dm = dm + json_escape(dup_title)
            dm = dm + "\",\"book_id\":\"\",\"existing_id\":\""
            dm = dm + json_escape(dup_id)
            dm = dm + "\"}"
            return dm
        }
    }
    // 受管资产分配（F-02/F-03 修复）：主槽位 books/<hdir>/original.<ext>，
    // 内容碰撞或已有资产损坏（内容不等）时隔离到 d1..d64 子槽位——按
    // book 独立资产，force 永不复用内容不符的资产，不串换正文。首个
    // 「不存在」或「内容逐字相等」的槽位命中：相等即复用（中断幂等语义，
    // 无重写）。
    let dd str = data_dir()
    let books_root str = join(dd, "books")
    let hdir str = hash_dir_of(hash)
    let dir str = join(books_root, hdir)
    let mrc int = mkdirs(dir)
    if mrc != 0 {
        var em str = "{\"code\":\"io_error\",\"message\":\"书库目录创建失败 rc="
        em = em + mrc.to_string()
        em = em + "\",\"book_id\":\"\",\"existing_id\":\"\"}"
        return em
    }
    var ext_name str = "txt"
    if fmt == "md" {
        ext_name = "md"
    }
    let fname str = "original." + ext_name
    let primary str = join(dir, fname)
    var managed str = ""
    var reused bool = false
    var slot int = 0
    var exhausted bool = false
    while !reused {
        if slot > 64 {
            exhausted = true
            reused = true
        } else {
            var cand str = primary
            if slot > 0 {
                let ddir str = join(dir, "d" + slot.to_string())
                cand = join(ddir, fname)
            }
            let eq int = content_equal(cand, text)
            if eq == 1 {
                managed = cand
                reused = true
            } else {
                if eq == -1 {
                    if slot > 0 {
                        let pdir str = join(dir, "d" + slot.to_string())
                        let mrc2 int = mkdirs(pdir)
                        if mrc2 != 0 {
                            var em2 str = "{\"code\":\"io_error\",\"message\":\"受管资产目录创建失败 rc="
                            em2 = em2 + mrc2.to_string()
                            em2 = em2 + "\",\"book_id\":\"\",\"existing_id\":\"\"}"
                            return em2
                        }
                    }
                    managed = cand
                    reused = true
                }
            }
            slot = slot + 1
        }
    }
    if exhausted {
        return "{\"code\":\"io_error\",\"message\":\"受管资产槽位耗尽（同指纹冲突超过上限）\",\"book_id\":\"\",\"existing_id\":\"\"}"
    }
    if !fs.exists(managed) {
        let wrc int = fs.write_text(managed, text)
        if wrc != 0 {
            var wm str = "{\"code\":\"io_error\",\"message\":\"受管副本写入失败 rc="
            wm = wm + wrc.to_string()
            wm = wm + "\",\"book_id\":\"\",\"existing_id\":\"\"}"
            return wm
        }
        // 新写入读回校验（F-03）：副本逐字完整才允许继续建索引记录
        let rb str = fs.read_text(managed)
        if rb != text {
            return "{\"code\":\"io_error\",\"message\":\"受管副本写入校验失败（读回与源不一致）\",\"book_id\":\"\",\"existing_id\":\"\"}"
        }
    }
    // PLAN-781 阶段 E（T-25）：一次扫描产出章 meta 索引（替代旧
    // parse_book_json 整书 JSON + 计数——同一份解析成本，现在同时产出
    // 字节偏移索引；读路径从此不再重解析）。
    let bid str = str.uuid()
    let meta_json str = scan_meta_json(text, fmt, title, hash)
    let mw = json.parse(meta_json)
    let nch int = mw.total_chapters
    // meta 先写（写失败 = 导入失败，库索引不动）；成功后写库索引。
    // 库写失败的 meta 孤儿无害（uuid 命名，不复活不误读）。
    let mrc int = write_meta(bid, meta_json)
    if mrc != 0 {
        var mm str = "{\"code\":\"io_error\",\"message\":\"章索引写入失败 rc="
        mm = mm + mrc.to_string()
        mm = mm + "\",\"book_id\":\"\",\"existing_id\":\"\"}"
        return mm
    }
    // 新记录：created_at v1 恒 0（a2r_std 无 time 模块，框架债见 T-00 报告）
    let nrj str = record_json(bid, hash, title, who, fmt, p, managed, size, nch, 1, 0)
    // 索引追加：现有记录重序列化 + 新记录
    var payload str = "{\"version\":1,\"books\":["
    var i int = 0
    for b in books {
        if i > 0 {
            payload = payload + ","
        }
        let v1 str = "" + b.book_id
        let v2 str = "" + b.source_hash
        let v3 str = "" + b.title
        let v4 str = "" + b.author
        let v5 str = "" + b.format
        let v6 str = "" + b.original_path
        let v7 str = "" + b.managed_path
        let n1 int = b.size
        let n2 int = b.chapter_count
        let n3 int = b.import_version
        let n4 int = b.created_at
        let rj str = record_json(v1, v2, v3, v4, v5, v6, v7, n1, n2, n3, n4)
        payload = payload + rj
        i = i + 1
    }
    if i > 0 {
        payload = payload + ","
    }
    payload = payload + nrj
    payload = payload + "]}"
    let src int = write_library_file(payload)
    if src != 0 {
        var sm str = "{\"code\":\"io_error\",\"message\":\"书库索引写入失败 rc="
        sm = sm + src.to_string()
        sm = sm + "\",\"book_id\":\"\",\"existing_id\":\"\"}"
        return sm
    }
    var okm str = "{\"code\":\"ok\",\"message\":\"导入成功\",\"book_id\":\""
    okm = okm + json_escape(bid)
    okm = okm + "\",\"existing_id\":\""
    okm = okm + json_escape(dup_id)
    okm = okm + "\"}"
    return okm
}

/// 移除结果 JSON：{"ok":bool,"message":str}。
pub fn remove_book_json(book_id str) str {
    let err str = remove_book(book_id)
    if err == "" {
        return "{\"ok\":true,\"message\":\"\"}"
    }
    var out str = "{\"ok\":false,\"message\":\""
    out = out + json_escape(err)
    out = out + "\"}"
    return out
}

/// 恢复结果 JSON：{"ok":bool,"message":str}。
pub fn restore_book_json(book_id str) str {
    let err str = restore_book(book_id)
    if err == "" {
        return "{\"ok\":true,\"message\":\"\"}"
    }
    var out str = "{\"ok\":false,\"message\":\""
    out = out + json_escape(err)
    out = out + "\"}"
    return out
}

// ═══════════════════════════════════════════════════════════
// 阅读状态（ReadingState + Locator v1 + settings 基础）
// 存储：<data>/reading/<book_id>.json，逐书一份；书删除时状态保留
// （恢复书目后阅读位置随之恢复）。
// Locator v1（TXT/MD 单资源语义，PRODUCT DESIGN §3 的可落地面；
// Phase 2 / SD-03 修订）：
//   chapter_number + paragraph_index（原文行号，-1 = 章级书签）
//   + para_hash（段文本锚点签名 sig1:<字符长>:1，写入与恢复双侧校验）
//   + quote_prefix（段首前缀 ≤64 字符，可选备注位）。
//   写侧 schema 强校验（严格整数/枚举/范围/锚点一致，见 put_reading_json）；
//   读侧容错（坏状态不冒充有效状态）；定位不存像素/百分比；
//   settings（font_size/line_height）随状态持久化。
// ═══════════════════════════════════════════════════════════

fn reading_dir() str {
    let dd str = data_dir()
    return join(dd, "reading")
}

fn reading_path(book_id str) str {
    let rd str = reading_dir()
    let fname str = book_id + ".json"
    return join(rd, fname)
}

/// 读取阅读状态 JSON；无记录或**无效状态**返回 ""。读侧入场校验
/// （F-14 修正，F-04 容错保留）：存在但为空/解析失败/词法结构非法
/// （jsonx.valid_state：类型/重复键等）/book_id 与请求不符/必需字段缺失
/// （chapter_number/paragraph_index/font_size/line_height/updated_at——
/// 缺字段访问 raise）→ 一律返回 ""，不把坏态/错书态冒充有效状态；
/// 损坏文件原样保留供诊断，不被后续写入静默覆盖。合法旧 sig1 态
/// （无 para_text）继续返回——兼容语义由前端恢复面处理。
pub fn get_reading_json(book_id str) str {
    let rp str = reading_path(book_id)
    if !fs.exists(rp) {
        return ""
    }
    let raw str = fs.read_text(rp)
    if raw == "" {
        return ""
    }
    let verr str = valid_state(raw)
    if verr != "" {
        return ""
    }
    var ok bool = false
    try {
        let v = json.parse(raw)
        let t str = "" + v.book_id
        if t == book_id {
            // 整数字段经 concat 提取（缺失字段访问 raise → 归无效）——
            // typed 绑定对缺失字段静默强转（r5 探针实测），不可作在场判别
            let c_s str = "" + v.chapter_number
            let pp_s str = "" + v.paragraph_index
            let u_s str = "" + v.updated_at
            let c int = c_s.to_int()
            let pp int = pp_s.to_int()
            let u int = u_s.to_int()
            let f str = "" + v.font_size
            let l str = "" + v.line_height
            if c_s == c.to_string() {
                if pp_s == pp.to_string() {
                    if u_s == u.to_string() {
                        if c >= 1 {
                            if pp >= -1 {
                                if f == "small" || f == "medium" || f == "large" {
                                    if l == "compact" || l == "comfy" {
                                        ok = true
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    } catch {
        ok = false
    }
    // READER-002 A：可选 layout/theme 枚举核（在场才核；坏值拒绝冒充
    // 有效状态）。缺位 = 旧态/默认，照常返回（向后兼容）。
    // v 作用域仅限上方 try——独立二次解析（raw 已过词法门，解析必成）。
    if ok {
        var ld str = ""
        var th str = ""
        try {
            let v2 = json.parse(raw)
            ld = "" + v2.layout
        } catch {
            ld = ""
        }
        try {
            let v3 = json.parse(raw)
            th = "" + v3.theme
        } catch {
            th = ""
        }
        if ld != "" {
            if ld != "narrow" {
                if ld != "medium" {
                    if ld != "wide" {
                        ok = false
                    }
                }
            }
        }
        if th != "" {
            if th != "light" {
                if th != "sepia" {
                    if th != "dark" {
                        ok = false
                    }
                }
            }
        }
    }
    if !ok {
        return ""
    }
    return raw
}

/// 错误响应（F-04 起 put 面统一 {"ok":false,"message"} 形态，与成功响应
// 同构——错误不再以裸字符串返回）。
fn reading_err(msg str) str {
    var out str = "{\"ok\":false,\"message\":\""
    out = out + json_escape(msg)
    out = out + "\"}"
    return out
}

/// 写入阅读状态（Locator v1 + settings，Phase 3 契约）。
/// 参数：payload = 状态 JSON 字符串（jsonx.valid_state 词法门：结构/类型
/// 精确/重复键拒绝/空白与转义键兼容——F-09）；para_text = 顶层内容锚点
/// （F-08/F-10）：段级定位必填、与当前原文行**逐字相等**（字符串相等，
/// 跨轨安全；长度签名不构成内容证明，等长替换在保存时即被拒绝），经
/// 外层 JSON 传输由框架转义，前端零转义。
/// 校验通过后构建**规范存储态**（后端拥有文件形态：提取字段 + 注入
/// para_text；用户 payload 内不许夹带 para_text），经备份/暂存/提交协议
/// 落盘；任一步失败不落盘、不损坏上一有效状态。返回 {"ok":bool,"message"}。
/// READER-007 T-05：locator_in = 可选顶层 locator v2 文档（方案甲；TXT/MD
/// 走 v1 段锚不传）。显式传入经恢复环核验通过才入存储态；缺省时前向延续
/// 存量 locator（settings-only 保存不清位锚）。存内 locator 由顶层参数
/// 承载，payload 内夹带拒绝（para_text 同款双写歧义防御）。
pub fn put_reading_json(book_id str, payload str, para_text_in str, locator_in str) str {
    if book_id == "" {
        return reading_err("book_id required")
    }
    let rj str = book_json(book_id)
    if rj == "" {
        return reading_err("book not found")
    }
    let rec = json.parse(rj)
    let ch_total int = rec.chapter_count
    let trimmed str = payload.trim()
    if trimmed.substr(0, 1) != "{" {
        return reading_err("payload must be a JSON object")
    }
    // F-09：词法结构/类型/重复键门（jsonx）。先行于解析——畸形文本在
    // 词法层拒绝，不依赖动态层的后值覆盖语义。
    let verr str = valid_state(trimmed)
    if verr != "" {
        return reading_err(verr)
    }
    var parsed = null
    try {
        parsed = json.parse(trimmed)
    } catch {
        return reading_err("payload is not valid JSON")
    }
    // 字段提取：类型已由词法门证明，typed 提取安全；可选键缺位 raise →
    // 归一为空串。para_text 不允许出现在内层 payload（内容锚点由顶层
    // 字段承载，后端注入存储态——避免双写歧义）。
    var bid_s str = ""
    var ch int = 0
    var pi int = 0
    var ph str = ""
    var qp str = ""
    var font str = ""
    var lineh str = ""
    var layout str = ""
    var theme str = ""
    var ua int = 0
    var extract_ok bool = true
    try {
        bid_s = "" + parsed.book_id
        // 整数字段经 concat 提取（缺失 raise → schema invalid）——typed
        // 绑定对缺失静默强转（r5 探针实测），不得用于必需键在场判别
        let ch_s str = "" + parsed.chapter_number
        let pi_s str = "" + parsed.paragraph_index
        let ua_s str = "" + parsed.updated_at
        ch = ch_s.to_int()
        pi = pi_s.to_int()
        ua = ua_s.to_int()
        if ch_s != ch.to_string() {
            extract_ok = false
        }
        if pi_s != pi.to_string() {
            extract_ok = false
        }
        if ua_s != ua.to_string() {
            extract_ok = false
        }
        font = "" + parsed.font_size
        lineh = "" + parsed.line_height
        // READER-002 A：可选排版扩展（缺位 = 维持默认，不写存储态；
        // 出现则枚举校验——SD-02 向后兼容扩展）。
        layout = ""
        theme = ""
        try {
            layout = "" + parsed.layout
        } catch {
            layout = ""
        }
        try {
            theme = "" + parsed.theme
        } catch {
            theme = ""
        }
        ph = ""
        try {
            ph = "" + parsed.para_hash
        } catch {
            ph = ""
        }
        qp = ""
        try {
            qp = "" + parsed.quote_prefix
        } catch {
            qp = ""
        }
        var inner_ptext str = ""
        try {
            inner_ptext = "" + parsed.para_text
        } catch {
            inner_ptext = ""
        }
        if inner_ptext != "" {
            return reading_err("para_text must be a top-level field, not inside payload")
        }
        try {
            let inner_loc = parsed.locator
            if inner_loc != null {
                return reading_err("locator must be a top-level field, not inside payload")
            }
        } catch {
            // 缺位 = 正常（v2 锚由顶层参数承载）
        }
    } catch {
        extract_ok = false
    }
    if !extract_ok {
        return reading_err("payload schema invalid")
    }
    if bid_s != book_id {
        return reading_err("payload book_id mismatch")
    }
    if ch < 1 {
        return reading_err("chapter_number must be an integer >= 1")
    }
    if pi < -1 {
        return reading_err("paragraph_index must be an integer >= -1")
    }
    if ch > ch_total {
        return reading_err("chapter_number out of range")
    }
    if qp.len() > 64 {
        return reading_err("quote_prefix too long")
    }
    var font_ok bool = false
    if font == "small" {
        font_ok = true
    }
    if font == "medium" {
        font_ok = true
    }
    if font == "large" {
        font_ok = true
    }
    if !font_ok {
        return reading_err("invalid font_size")
    }
    var line_ok bool = false
    if lineh == "compact" {
        line_ok = true
    }
    if lineh == "comfy" {
        line_ok = true
    }
    if !line_ok {
        return reading_err("invalid line_height")
    }
    if layout != "" {
        if layout != "narrow" {
            if layout != "medium" {
                if layout != "wide" {
                    return reading_err("invalid layout")
                }
            }
        }
    }
    if theme != "" {
        if theme != "light" {
            if theme != "sepia" {
                if theme != "dark" {
                    return reading_err("invalid theme")
                }
            }
        }
    }
    if ph != "" {
        if !ph.starts_with("sig") {
            return reading_err("invalid para_hash")
        }
    }
    // 内容锚点核对（F-08/F-10）：段级定位必填 para_text 且与当前原文行
    // 逐字相等；资源在位（章非占位、行号在界、行非空）。
    let anchor str = para_text_in.trim()
    if pi >= 0 {
        if anchor == "" {
            return reading_err("paragraph anchor requires para_text (content evidence)")
        }
        let cj str = chapter_json(book_id, ch)
        let c = json.parse(cj)
        let ctitle str = "" + c.title
        if ctitle == "内容缺失" {
            return reading_err("chapter content unavailable")
        }
        if ctitle == "章节不存在" {
            return reading_err("chapter_number out of range")
        }
        let body str = "" + c.body
        let lines = body.split("\n")
        if pi >= lines.len() {
            return reading_err("paragraph_index out of range")
        }
        let ln str = "" + lines[pi]
        let live str = ln.trim()
        if live == "" {
            return reading_err("paragraph_index out of range")
        }
        if live != anchor {
            var dbg str = "paragraph anchor mismatch"
            dbg = dbg + " live=["
            dbg = dbg + json_escape(live)
            dbg = dbg + "] want=["
            dbg = dbg + json_escape(anchor)
            dbg = dbg + "]"
            return reading_err(dbg)
        }
    }
    // ── Locator v2（READER-007 T-05，方案甲）──
    // 显式入参：恢复环核验（身份链/逐字 quote/位次/上下文重算）通过才
    // canonical 重发入存储态；缺省入参：前向延续存量 locator——settings-only
    // 保存不清位锚（冷恢复语义）。存量锚在场但不可重发 → 具名拒绝保原件
    // （不静默丢锚，不假保存）。
    var loc_json str = ""
    if locator_in != "" {
        let lvr str = locator_verify_str(book_id, locator_in)
        if lvr != "" {
            var lmsg str = "locator rejected: "
            lmsg = lmsg + lvr
            return reading_err(lmsg)
        }
        var lparsed = null
        try {
            lparsed = json.parse(locator_in)
        } catch {
            return reading_err("locator parse failed")
        }
        loc_json = locator_emit(lparsed)
        if loc_json == "" {
            return reading_err("locator canonical rebuild failed")
        }
    } else {
        let rp0 str = reading_path(book_id)
        if fs.exists(rp0) {
            let raw0 str = fs.read_text(rp0)
            if raw0 != "" {
                let v0 str = valid_state(raw0)
                if v0 == "" {
                    var carry_ok bool = true
                    var old_loc str = ""
                    try {
                        let p0 = json.parse(raw0)
                        if has_locator(p0) {
                            let emitted str = locator_emit(p0.locator)
                            if emitted == "" {
                                carry_ok = false
                            } else {
                                old_loc = emitted
                            }
                        }
                    } catch {
                        carry_ok = false
                    }
                    if !carry_ok {
                        return reading_err("stored locator unreadable — refusing overwrite (relocate or repair first)")
                    }
                    loc_json = old_loc
                }
            }
        }
    }
    // 规范存储态（后端拥有文件形态）：已知字段 + 注入的 para_text；
    // para_text 仅在段级定位时注入（章级书签无内容锚点）。
    var stored str = "{\"book_id\":\""
    stored = stored + json_escape(bid_s)
    stored = stored + "\",\"chapter_number\":"
    stored = stored + ch.to_string()
    stored = stored + ",\"paragraph_index\":"
    stored = stored + pi.to_string()
    if ph != "" {
        stored = stored + ",\"para_hash\":\""
        stored = stored + json_escape(ph)
        stored = stored + "\""
    }
    if pi >= 0 {
        stored = stored + ",\"para_text\":\""
        stored = stored + json_escape(anchor)
        stored = stored + "\""
    }
    if qp != "" {
        stored = stored + ",\"quote_prefix\":\""
        stored = stored + json_escape(qp)
        stored = stored + "\""
    }
    stored = stored + ",\"font_size\":\""
    stored = stored + json_escape(font)
    stored = stored + "\",\"line_height\":\""
    stored = stored + json_escape(lineh)
    stored = stored + "\""
    if layout != "" {
        stored = stored + ",\"layout\":\""
        stored = stored + json_escape(layout)
        stored = stored + "\""
    }
    if theme != "" {
        stored = stored + ",\"theme\":\""
        stored = stored + json_escape(theme)
        stored = stored + "\""
    }
    if loc_json != "" {
        stored = stored + ",\"locator\":"
        stored = stored + loc_json
    }
    stored = stored + ",\"updated_at\":"
    stored = stored + ua.to_string()
    stored = stored + "}"
    // 写协议：备份 → 暂存 → 提交，全部读回校验（F-06 同源）；失败不落盘
    let rd str = reading_dir()
    let mrc int = mkdirs(rd)
    if mrc != 0 {
        return reading_err("reading dir create failed rc=" + mrc.to_string())
    }
    let rp str = reading_path(book_id)
    let wrc int = write_with_backup(rp, stored)
    if wrc == -2 {
        return reading_err("reading state path occupied")
    }
    if wrc == -3 {
        return reading_err("reading state unreadable (empty) — refusing overwrite")
    }
    if wrc == -4 {
        return reading_err("reading state backup failed — state not modified")
    }
    if wrc == -5 {
        return reading_err("reading state stage failed — state not modified")
    }
    if wrc != 0 {
        return reading_err("reading state write failed rc=" + wrc.to_string())
    }
    return "{\"ok\":true,\"message\":\"\"}"
}

// ═══════════════════════════════════════════════════════════
// 可恢复移除（AC-05：默认不动用户原路径文件，受管副本保留）
// ═══════════════════════════════════════════════════════════

/// 移除书目：仅从索引剔除并登记 removed.jsonl；受管副本与用户原文件不动。
/// 返回 "" = 成功，否则为错误消息。
pub fn remove_book(book_id str) str {
    let cur str = books_json()
    if cur == "" {
        return "library index unsupported version"
    }
    let parsed = json.parse(cur)
    let books = parsed.books
    var found bool = false
    var entry str = ""
    var payload str = "{\"version\":1,\"books\":["
    var i int = 0
    for b in books {
        let bid str = "" + b.book_id
        if bid == book_id {
            found = true
            // 就地登记（先于索引改写：崩溃时最多"已移除但仍可见"）
            let v1 str = "" + b.book_id
            let v2 str = "" + b.source_hash
            let v3 str = "" + b.title
            let v4 str = "" + b.author
            let v5 str = "" + b.format
            let v6 str = "" + b.original_path
            let v7 str = "" + b.managed_path
            let n1 int = b.size
            let n2 int = b.chapter_count
            let n3 int = b.import_version
            let n4 int = b.created_at
            let rj str = record_json(v1, v2, v3, v4, v5, v6, v7, n1, n2, n3, n4)
            entry = "{\"book_id\":\""
            entry = entry + json_escape(v1)
            entry = entry + "\",\"removed_at\":0"
            entry = entry + ",\"record\":"
            entry = entry + rj
            entry = entry + "}"
        } else {
            if i > 0 {
                payload = payload + ","
            }
            let v1 str = "" + b.book_id
            let v2 str = "" + b.source_hash
            let v3 str = "" + b.title
            let v4 str = "" + b.author
            let v5 str = "" + b.format
            let v6 str = "" + b.original_path
            let v7 str = "" + b.managed_path
            let n1 int = b.size
            let n2 int = b.chapter_count
            let n3 int = b.import_version
            let n4 int = b.created_at
            let rj str = record_json(v1, v2, v3, v4, v5, v6, v7, n1, n2, n3, n4)
            payload = payload + rj
            i = i + 1
        }
    }
    if !found {
        return "book not found"
    }
    payload = payload + "]}"
    // JSONL 行式登记（追加=拼行，恢复=按行剔除）
    let rp str = removed_path()
    var log str = ""
    if fs.exists(rp) {
        log = fs.read_text(rp)
    }
    var next str = log
    if next != "" {
        let tail str = next.substr(next.len() - 1, 1)
        if tail != "\n" {
            next = next + "\n"
        }
    }
    next = next + entry
    next = next + "\n"
    // 移除日志先于索引改写（崩溃时最多"已移除但仍可见"）；写入读回校验
    // ——日志是恢复的唯一依据，写失败必须中止移除（F-06）。
    let wrc int = verified_write(rp, next)
    if wrc != 0 {
        return "removed.jsonl write failed rc=" + wrc.to_string()
    }
    let src int = write_library_file(payload)
    if src != 0 {
        return "library write failed rc=" + src.to_string()
    }
    return ""
}

/// 恢复指定书目（removed.jsonl 中取该 id 的记录重加入索引），成功后从
/// removed.jsonl 剔除该行。返回 "" = 成功。
/// F-18 修正：移除日志是外来持久化输入，不再被信任——每一行在首次
/// json.parse 及任何备份/索引/移除日志改写之前先过词法准入
/// （jsonx.valid_removed_entry：外层结构/必需键/类型 + record 与主索引
/// valid_record 同一规则 + i32 词法界限；原始日志记录不得先强转后校验）。
/// 任何行非法一律整体拒恢复（fail-closed：日志是恢复的唯一依据，损坏时
/// 不做部分操作），主库/备份/暂存/移除日志/已有资产全部字节不变。
/// 选中条目身份必须与请求一致（外层 book_id 已在扫描中对齐，内层
/// record.book_id 显式核对）；最终索引候选发布前再以 valid_index 验证
/// （防消费者遗漏）。合法恢复、i32 最大/最小边界与未知合法键保持成功。
pub fn restore_book(book_id str) str {
    let rp str = removed_path()
    if !fs.exists(rp) {
        return "no removed records"
    }
    let raw str = fs.read_text(rp)
    if raw == "" {
        return "no removed records"
    }
    let lines = raw.split("\n")
    var rec_json str = ""
    var i int = 0
    while i < lines.len() {
        let line str = "" + lines[i]
        if line.trim() != "" {
            // 准入先于解析：词法非法行在 json.parse 前整体拒绝
            let verr str = valid_removed_entry(line)
            if verr != "" {
                return "removed log entry invalid: " + verr
            }
            let e = json.parse(line)
            let ebid str = "" + e.book_id
            if ebid == book_id {
                rec_json = line
            }
        }
        i = i + 1
    }
    if rec_json == "" {
        return "book not in removed records"
    }
    let entry = json.parse(rec_json)
    let rec = entry.record
    // 身份一致：内层 record 必须同指请求书目（防换绑）
    let v1 str = "" + rec.book_id
    if v1 != book_id {
        return "removed record identity mismatch"
    }
    let v2 str = "" + rec.source_hash
    let v3 str = "" + rec.title
    let v4 str = "" + rec.author
    let v5 str = "" + rec.format
    let v6 str = "" + rec.original_path
    let v7 str = "" + rec.managed_path
    let n1 int = rec.size
    let n2 int = rec.chapter_count
    let n3 int = rec.import_version
    let n4 int = rec.created_at
    let rj str = record_json(v1, v2, v3, v4, v5, v6, v7, n1, n2, n3, n4)
    let cur str = books_json()
    if cur == "" {
        return "library index unsupported version"
    }
    let parsed = json.parse(cur)
    let books = parsed.books
    var exists bool = false
    var payload str = "{\"version\":1,\"books\":["
    var j int = 0
    for b in books {
        let bbid str = "" + b.book_id
        if bbid == book_id {
            exists = true
        }
        if j > 0 {
            payload = payload + ","
        }
        let w1 str = "" + b.book_id
        let w2 str = "" + b.source_hash
        let w3 str = "" + b.title
        let w4 str = "" + b.author
        let w5 str = "" + b.format
        let w6 str = "" + b.original_path
        let w7 str = "" + b.managed_path
        let m1 int = b.size
        let m2 int = b.chapter_count
        let m3 int = b.import_version
        let m4 int = b.created_at
        let rj2 str = record_json(w1, w2, w3, w4, w5, w6, w7, m1, m2, m3, m4)
        payload = payload + rj2
        j = j + 1
    }
    if !exists {
        if j > 0 {
            payload = payload + ","
        }
        payload = payload + rj
    }
    payload = payload + "]}"
    // 最终候选发布前再验证（主索引同一结构门；typed 提取若有损在此拦截，
    // 不落盘、不清日志）
    let perr str = valid_index(payload)
    if perr != "" {
        return "restored index candidate invalid: " + perr
    }
    let src int = write_library_file(payload)
    if src != 0 {
        return "library write failed rc=" + src.to_string()
    }
    // 从 removed.jsonl 剔除该行（其余原样保留）；清理结果必须读回校验
    // ——失败时书目已回索引但日志行仍在，返回明确错误（F-06：不忽略
    // 返回值；重复恢复经 exists 门幂等，日志残留行在下次恢复时剔除）。
    var kept str = ""
    var k int = 0
    while k < lines.len() {
        let line str = "" + lines[k]
        if line.trim() != "" {
            if line != rec_json {
                kept = kept + line
                kept = kept + "\n"
            }
        }
        k = k + 1
    }
    let clrc int = verified_write(rp, kept)
    if clrc != 0 {
        return "removed log cleanup failed rc=" + clrc.to_string()
    }
    return ""
}

// ───────────────────────────────────────────────────────────────
// READER-007 T-03：产品引擎资源/会话面（正式 /api/reader/*）。
// 与探针（/api/probe/*）同构但数据面不同：固定资产 root 由应用自有
// 资产目录派生（不依赖 PROBE_ASSETS_DIR/PROBE_DATA_DIR），受管原件
// root 由正式书目记录派生（无独立 register 步骤），会话存数据目录
// sessions.json。消费者入口 = 正式 reading_page 的 doc-surface 表面；
// locator 数据层由 T-05 接入（本阶段仅资源/会话/装载）。
// ───────────────────────────────────────────────────────────────

/// 产品固定资产根目录：AUTO_READER_ENGINE_ASSETS env 覆盖（测试隔离用），
/// 缺省 = 仓库内受管资产目录（相对进程 cwd——auto run 自仓库根执行）。
pub fn engine_assets_root() str {
    let env str = Env.get("AUTO_READER_ENGINE_ASSETS")
    if env != "" {
        return normalize(env)
    }
    return normalize("src/assets/engine-assets")
}

/// 资产名形状白名单（字母/数字/./-/_，≤200，无 ..）——双保险同
/// epub_media_response 语义。
pub fn reader_asset_ok(name str) bool {
    if name == "" {
        return false
    }
    if name.len() > 200 {
        return false
    }
    if name.find("..") >= 0 {
        return false
    }
    var i int = 0
    while i < name.len() {
        let c str = name.substr(i, 1)
        var known bool = false
        if "0123456789".find(c) >= 0 {
            known = true
        }
        if "abcdefghijklmnopqrstuvwxyz".find(c) >= 0 {
            known = true
        }
        if "ABCDEFGHIJKLMNOPQRSTUVWXYZ".find(c) >= 0 {
            known = true
        }
        if c == "." {
            known = true
        }
        if c == "-" {
            known = true
        }
        if c == "_" {
            known = true
        }
        if c == "/" {
            known = true
        }
        if !known {
            return false
        }
        i = i + 1
    }
    return true
}

/// 资产 content type（同探针 asset_type_of 语义）。
pub fn reader_asset_type_of(name str) str {
    if name.find(".json") >= 0 {
        return "application/json"
    }
    if name.find(".mjs") >= 0 {
        return "text/javascript"
    }
    if name.find(".js") >= 0 {
        return "text/javascript"
    }
    if name.find(".css") >= 0 {
        return "text/css"
    }
    if name.find(".html") >= 0 {
        return "text/html"
    }
    if name.find(".png") >= 0 {
        return "image/png"
    }
    return ""
}

/// GET /api/reader/asset/:name — 产品固定资产字节。
/// root = 应用自有资产目录（仓库内受管，随 app 分发）；形状白名单 +
/// http.file_response 词法校验双保险；未知名指向必然不存在的 rel（404），
/// 不泄露任何状态。资产目录缺失时同样指向缺失 rel（诚实 404，不伪造）。
pub fn reader_asset_response(name str) FileResponse {
    var root str = data_dir()
    var rel str = "__missing__"
    if reader_asset_ok(name) {
        let ar str = engine_assets_root()
        if ar != "" {
            if fs.exists(ar) {
                if fs.is_dir(ar) {
                    root = ar
                    rel = name
                }
            }
        }
    }
    var ct str = reader_asset_type_of(rel)
    if rel == "__missing__" {
        ct = "application/octet-stream"
    }
    var opts str = "{\"content_type\":\""
    opts = opts + ct
    opts = opts + "\"}"
    return http.file_response(root, rel, opts)
}

/// GET /api/reader/document/:bid/file — 本书受管原件字节（引擎装载源）。
/// root 由正式书目记录 managed_path 派生（目录+文件名拆分），不注册、
/// 不复制、不改原件；缺书/格式不符 → 指向必然不存在的名字（404），
/// 不泄露任何状态。EPUB 二进制经 http.file_response 承载。
pub fn reader_document_response(bid str) FileResponse {
    var root str = data_dir()
    var rel str = "__missing__"
    let rj str = book_json(bid)
    if rj != "" {
        try {
            let r = json.parse(rj)
            let mp str = "" + r.managed_path
            if mp != "" {
                if fs.exists(mp) {
                    if !fs.is_dir(mp) {
                        root = parent(mp)
                        rel = basename(mp)
                    }
                }
            }
        } catch {
            root = data_dir()
            rel = "__missing__"
        }
    }
    return http.file_response(root, rel, "{\"content_type\":\"application/epub+zip\"}")
}

// ── 产品会话（数据目录 sessions.json；T-01 §4.2 身份链的运行时面） ──

fn sessions_path() str {
    let dd str = data_dir()
    return join(dd, "sessions.json")
}

fn session_id_ok(sid str) bool {
    if sid == "" {
        return false
    }
    if sid.len() > 64 {
        return false
    }
    var i int = 0
    while i < sid.len() {
        let c str = sid.substr(i, 1)
        var known bool = false
        if "0123456789".find(c) >= 0 {
            known = true
        }
        if "abcdefghijklmnopqrstuvwxyz".find(c) >= 0 {
            known = true
        }
        if "ABCDEFGHIJKLMNOPQRSTUVWXYZ".find(c) >= 0 {
            known = true
        }
        if c == "-" {
            known = true
        }
        if !known {
            return false
        }
        i = i + 1
    }
    return true
}

fn session_reemit(s) str {
    let fsid str = "" + s.session_id
    let fbid str = "" + s.book_id
    let fsh str = "" + s.source_hash
    let fen str = "" + s.engine
    let fat int = s.created_at
    var out str = "{\"session_id\":\""
    out = out + json_escape(fsid)
    out = out + "\",\"book_id\":\""
    out = out + json_escape(fbid)
    out = out + "\",\"source_hash\":\""
    out = out + json_escape(fsh)
    out = out + "\",\"engine\":\""
    out = out + json_escape(fen)
    out = out + "\",\"created_at\":"
    out = out + fat.to_string()
    out = out + "}"
    return out
}

fn session_reemit_from(session_id str, book_id str, source_hash str, engine str, at int) str {
    var out str = "{\"session_id\":\""
    out = out + json_escape(session_id)
    out = out + "\",\"book_id\":\""
    out = out + json_escape(book_id)
    out = out + "\",\"source_hash\":\""
    out = out + json_escape(source_hash)
    out = out + "\",\"engine\":\""
    out = out + json_escape(engine)
    out = out + "\",\"created_at\":"
    out = out + at.to_string()
    out = out + "}"
    return out
}

/// 建立产品会话：session_id 形状 + 书存在 + source_hash 与书目记录一致 +
/// engine 非空；通过则写 sessions.json（备份协议，同 id 幂等更新保留）。
/// 拒绝零落盘。返回 {"ok":true,"session_id":...} 或 {"ok":false,...}。
pub fn reader_session_put(session_id str, book_id str, source_hash str, engine str) str {
    if !session_id_ok(session_id) {
        return "{\"ok\":false,\"error\":\"rejected_bad_session\",\"detail\":\"session_id shape\"}"
    }
    if engine == "" {
        return "{\"ok\":false,\"error\":\"rejected_bad_engine\"}"
    }
    let rj str = book_json(book_id)
    if rj == "" {
        return "{\"ok\":false,\"error\":\"rejected_bad_document\",\"detail\":\"book not found\"}"
    }
    var rec_hash str = ""
    try {
        let r = json.parse(rj)
        rec_hash = "" + r.source_hash
    } catch {
        return "{\"ok\":false,\"error\":\"rejected_bad_document\",\"detail\":\"book parse\"}"
    }
    if rec_hash != source_hash {
        return "{\"ok\":false,\"error\":\"rejected_bad_document\",\"detail\":\"source_hash mismatch\"}"
    }
    let dd str = data_dir()
    let mrc int = mkdirs(dd)
    if mrc != 0 {
        return "{\"ok\":false,\"error\":\"fs_error\"}"
    }
    let now int = time.now_sec()
    let sp str = sessions_path()
    var out str = "{\"version\":1,\"sessions\":["
    var n int = 0
    if fs.exists(sp) {
        let raw str = fs.read_text(sp)
        if raw != "" {
            try {
                let parsed = json.parse(raw)
                let sessions = parsed.sessions
                for s in sessions {
                    let sid str = "" + s.session_id
                    if sid == session_id {
                        continue
                    }
                    if n > 0 {
                        out = out + ","
                    }
                    out = out + session_reemit(s)
                    n = n + 1
                }
            } catch {
                out = "{\"version\":1,\"sessions\":["
                n = 0
            }
        }
    }
    if n > 0 {
        out = out + ","
    }
    out = out + session_reemit_from(session_id, book_id, source_hash, engine, now)
    out = out + "]}"
    let wrc int = write_with_backup(sp, out)
    if wrc != 0 {
        var fe str = "{\"ok\":false,\"error\":\"fs_error\",\"code\":"
        fe = fe + wrc.to_string()
        fe = fe + "}"
        return fe
    }
    var okr str = "{\"ok\":true,\"session_id\":\""
    okr = okr + json_escape(session_id)
    okr = okr + "\"}"
    return okr
}

// ── 会话命令队列（T-04：宿主→引擎控制通道；目录/设置/分页滚动命令） ──
// 命令文件 data/session-cmds/<sid>.json（备份协议写；seq 单调递增）。
// 引擎表面（adapter 轮询）按 seq 游标拉取待执行命令；拉取即保留（小文件），
// 会话清理时随 sessions 移除（T-08 生命周期门）。

fn cmds_path(sid str) str {
    let dd str = data_dir()
    let dir str = join(dd, "session-cmds")
    return join(dir, sid + ".json")
}

fn cmds_dir() str {
    let dd str = data_dir()
    return join(dd, "session-cmds")
}

/// 写一条会话命令。op ∈ goto|settings|flow；goto 带 index（spine 索引 ≥0），
/// settings 带 font_size/layout/theme 枚举，flow 带 flow_mode 枚举。校验
/// session 存在 + op/枚举合法，通过则追加写（seq = 当前 max+1）。拒绝零落盘。
/// 返回 {"ok":true,"seq":N} 或 {"ok":false,"error":...}。
pub fn reader_command_put(session_id str, op str, index int, font_size str, layout str, theme str, flow_mode str) str {
    if !session_id_ok(session_id) {
        return "{\"ok\":false,\"error\":\"rejected_bad_session\"}"
    }
    if find_session_json(session_id) == "" {
        return "{\"ok\":false,\"error\":\"rejected_no_session\"}"
    }
    var payload str = ""
    if op == "goto" {
        if index < 0 {
            return "{\"ok\":false,\"error\":\"rejected_bad_goto\"}"
        }
        payload = "{\"index\":" + index.to_string() + "}"
    } else {
        if op == "settings" {
            var fs_ok bool = false
            if font_size != "" {
                if font_size == "small" {
                    fs_ok = true
                }
                if font_size == "medium" {
                    fs_ok = true
                }
                if font_size == "large" {
                    fs_ok = true
                }
            }
            var ly_ok bool = false
            if layout != "" {
                if layout == "narrow" {
                    ly_ok = true
                }
                if layout == "medium" {
                    ly_ok = true
                }
                if layout == "wide" {
                    ly_ok = true
                }
            }
            var th_ok bool = false
            if theme != "" {
                if theme == "light" {
                    th_ok = true
                }
                if theme == "sepia" {
                    th_ok = true
                }
                if theme == "dark" {
                    th_ok = true
                }
            }
            if !fs_ok {
                if font_size != "" {
                    return "{\"ok\":false,\"error\":\"rejected_bad_settings\"}"
                }
            }
            if !ly_ok {
                if layout != "" {
                    return "{\"ok\":false,\"error\":\"rejected_bad_settings\"}"
                }
            }
            if !th_ok {
                if theme != "" {
                    return "{\"ok\":false,\"error\":\"rejected_bad_settings\"}"
                }
            }
            if font_size == "" {
                if layout == "" {
                    if theme == "" {
                        return "{\"ok\":false,\"error\":\"rejected_empty_settings\"}"
                    }
                }
            }
            var out str = "{"
            var n int = 0
            if font_size != "" {
                out = out + "\"font_size\":\""
                out = out + json_escape(font_size)
                out = out + "\""
                n = n + 1
            }
            if layout != "" {
                if n > 0 {
                    out = out + ","
                }
                out = out + "\"layout\":\""
                out = out + json_escape(layout)
                out = out + "\""
                n = n + 1
            }
            if theme != "" {
                if n > 0 {
                    out = out + ","
                }
                out = out + "\"theme\":\""
                out = out + json_escape(theme)
                out = out + "\""
                n = n + 1
            }
            out = out + "}"
            payload = out
        } else {
            if op == "flow" {
                var fm_ok bool = false
                if flow_mode == "paged" {
                    fm_ok = true
                }
                if flow_mode == "scrolled" {
                    fm_ok = true
                }
                if !fm_ok {
                    return "{\"ok\":false,\"error\":\"rejected_bad_flow\"}"
                }
                payload = "{\"mode\":\"" + json_escape(flow_mode) + "\"}"
            } else {
                return "{\"ok\":false,\"error\":\"rejected_bad_op\"}"
            }
        }
    }
    let mrc int = mkdirs(cmds_dir())
    if mrc != 0 {
        return "{\"ok\":false,\"error\":\"fs_error\"}"
    }
    let cp str = cmds_path(session_id)
    var next_seq int = 1
    var out str = "{\"version\":1,\"cmds\":["
    var had_prev bool = false
    if fs.exists(cp) {
        let raw str = fs.read_text(cp)
        if raw != "" {
            try {
                let parsed = json.parse(raw)
                let arr = parsed.cmds
                for c in arr {
                    let cs int = c.seq
                    if cs >= next_seq {
                        next_seq = cs + 1
                    }
                    if had_prev {
                        out = out + ","
                    }
                    out = out + reemit_cmd(c)
                    had_prev = true
                }
            } catch {
                out = "{\"version\":1,\"cmds\":["
                next_seq = 1
                had_prev = false
            }
        }
    }
    if next_seq < 1 {
        next_seq = 1
    }
    if had_prev {
        out = out + ","
    }
    out = out + "{\"seq\":" + next_seq.to_string() + ",\"op\":\""
    out = out + json_escape(op)
    out = out + "\",\"payload\":\""
    out = out + json_escape(payload)
    out = out + "\"}]}"
    let wrc int = write_with_backup(cp, out)
    if wrc != 0 {
        var fe str = "{\"ok\":false,\"error\":\"fs_error\",\"code\":"
        fe = fe + wrc.to_string()
        fe = fe + "}"
        return fe
    }
    var okr str = "{\"ok\":true,\"seq\":"
    okr = okr + next_seq.to_string()
    okr = okr + "}"
    return okr
}

fn reemit_cmd(c) str {
    let cs int = c.seq
    let cop str = "" + c.op
    var out str = "{\"seq\":"
    out = out + cs.to_string()
    out = out + ",\"op\":\""
    out = out + json_escape(cop)
    out = out + "\",\"payload\":\""
    var cpj = c.payload
    var cp_str str = "{}"
    try {
        cp_str = "" + cpj
    } catch {
        cp_str = "{}"
    }
    out = out + json_escape(cp_str)
    out = out + "\"}"
    return out
}

/// GET 输出形态：payload 还原为对象（adapter 直接读 payload.index 等字段）。
/// 存储字段是字符串（reemit_cmd 持久化），此处拼接为 JSON 对象文本。
fn reemit_cmd_out(c) str {
    let cs int = c.seq
    let cop str = "" + c.op
    var out str = "{\"seq\":"
    out = out + cs.to_string()
    out = out + ",\"op\":\""
    out = out + json_escape(cop)
    out = out + "\",\"payload\":"
    var cpj = c.payload
    var cp_str str = "{}"
    try {
        cp_str = "" + cpj
    } catch {
        cp_str = "{}"
    }
    out = out + cp_str
    out = out + "}"
    return out
}

/// 拉取会话待执行命令（seq > after_seq；会话缺失/无命令 → ok:false 或空）。
/// 返回 {"ok":true,"seq":最大seq,"cmds":[{seq,op,payload},...]}。
pub fn reader_command_get(session_id str, after_seq int) str {
    if !session_id_ok(session_id) {
        return "{\"ok\":false,\"error\":\"rejected_bad_session\"}"
    }
    let cp str = cmds_path(session_id)
    if !fs.exists(cp) {
        return "{\"ok\":true,\"seq\":0,\"cmds\":[]}"
    }
    let raw str = fs.read_text(cp)
    if raw == "" {
        return "{\"ok\":true,\"seq\":0,\"cmds\":[]}"
    }
    // 收集 seq>after 的命令 JSON 片段 + 最大 seq
    var parts str = ""
    var n int = 0
    var max_seq int = 0
    try {
        let parsed = json.parse(raw)
        let arr = parsed.cmds
        for c in arr {
            let cs int = c.seq
            if cs > max_seq {
                max_seq = cs
            }
            if cs > after_seq {
                if n > 0 {
                    parts = parts + ","
                }
                parts = parts + reemit_cmd_out(c)
                n = n + 1
            }
        }
    } catch {
        return "{\"ok\":true,\"seq\":0,\"cmds\":[]}"
    }
    var out str = "{\"ok\":true,\"seq\":"
    out = out + max_seq.to_string()
    out = out + ",\"cmds\":["
    out = out + parts
    out = out + "]}"
    return out
}

fn find_session_json(want str) str {
    let sp str = sessions_path()
    if !fs.exists(sp) {
        return ""
    }
    let raw str = fs.read_text(sp)
    if raw == "" {
        return ""
    }
    var hit str = ""
    try {
        let parsed = json.parse(raw)
        let sessions = parsed.sessions
        for s in sessions {
            let sid str = "" + s.session_id
            if sid == want {
                hit = session_reemit(s)
            }
        }
    } catch {
        return ""
    }
    return hit
}

/// GET /api/reader/session?session_id=... — 会话读回（冷重启恢复身份）。
pub fn reader_session_get(session_id str) str {
    if !session_id_ok(session_id) {
        return "{\"found\":false,\"reason\":\"bad session shape\"}"
    }
    let sj str = find_session_json(session_id)
    if sj == "" {
        return "{\"found\":false}"
    }
    var out str = "{\"found\":true,\"session\":"
    out = out + sj
    out = out + "}"
    return out
}

/// GET /api/reader/surface-url — 正式阅读页 doc-surface 装载 URL（最近会话）。
/// base 由 AUTO_READER_PUBLIC_BASE env 覆盖（双实例端口可配），缺省
/// http://127.0.0.1:17825（pac.at back_port）。无会话 → ok:false。
pub fn reader_surface_url() str {
    var base str = normalize(Env.get("AUTO_READER_PUBLIC_BASE"))
    if base == "" {
        base = "http://127.0.0.1:17825"
    }
    let sp str = sessions_path()
    if !fs.exists(sp) {
        return "{\"ok\":false,\"error\":\"no_session\"}"
    }
    let raw str = fs.read_text(sp)
    if raw == "" {
        return "{\"ok\":false,\"error\":\"no_session\"}"
    }
    var latest str = ""
    var latest_created int = -1
    var lbook str = ""
    var lhash str = ""
    try {
        let parsed = json.parse(raw)
        let sessions = parsed.sessions
        for s in sessions {
            let created int = s.created_at
            if created > latest_created {
                latest_created = created
                latest = "" + s.session_id
                lbook = "" + s.book_id
                lhash = "" + s.source_hash
            }
        }
    } catch {
        return "{\"ok\":false,\"error\":\"sessions_parse\"}"
    }
    if latest == "" {
        return "{\"ok\":false,\"error\":\"no_session\"}"
    }
    var url str = base
    if url.substr(url.len() - 1, 1) == "/" {
        url = url.substr(0, url.len() - 1)
    }
    url = url + "/api/reader/asset/native-host.html?doc="
    url = url + lbook
    url = url + "&session="
    url = url + latest
    url = url + "&hash="
    url = url + lhash
    var out str = "{\"ok\":true,\"url\":\""
    out = out + json_escape(url)
    out = out + "\"}"
    return out
}

// ═══════════════════════════════════════════════════════════
// READER-007 T-05：Locator v2（reader-locator v1）录入环与恢复/回访环
// 契约：docs/design/02-epub-engine-reading.md §4/§5（方案甲冻结）。
//   录入环（reader_locator_select）：会话/书/源版本/资源/逐字 quote/
//   occurrence 七级校验（029 语义继承）；canonical context 由服务器从
//   章缓存正文计算（不信任引擎自述）；CFI 只做形状核验（受管 adapter
//   是唯一 CFI 转换面，此处不引入第二个解析器）。
//   恢复/回访环（locator_verify_str）：身份链 + 逐字 quote + 作用域位次
//   + 上下文窗口重算比对——「CFI 指向另一处重复句但 quote 相同」经
//   context 重算失配识别为 needs_relocate，不静默跳第一处。
// 版本：locator 对象 reader-locator v1；书/注释文件版本化在 annotations/
// reading 写侧；书库 import_version 不变。
// ═══════════════════════════════════════════════════════════

/// 错误响应（与会话拒绝面同构：{"ok":false,"error":...,"detail":...}）。
fn loc_err(msg str) str {
    var out str = "{\"ok\":false,\"error\":\""
    out = out + json_escape(msg)
    out = out + "\"}"
    return out
}

/// 章缓存正文（trim 后）；缺书/缺 meta/占位章/越界 → ""。
fn chapter_body_or_empty(book_id str, ch int) str {
    if ch < 1 {
        return ""
    }
    let cj str = chapter_json(book_id, ch)
    let c = json.parse(cj)
    let t str = "" + c.title
    if t == "内容缺失" {
        return ""
    }
    if t == "章节不存在" {
        return ""
    }
    let b str = "" + c.body
    return b.trim()
}

/// spine 权威 href（epub meta 派生，不信 adapter 自报 resource_href）。
fn spine_href_of(book_id str, spine int) str {
    let meta str = load_epub_meta(book_id)
    if meta == "" {
        return ""
    }
    let m = json.parse(meta)
    let hrefs str = "" + m.spine
    return epub_href_at(hrefs, spine)
}

/// quote 在 1..limit_ch 章缓存正文中的出现总数（章扫描 ≤2000，同搜索面上限）。
fn book_count_before(book_id str, quote str, limit_ch int) int {
    var scan int = limit_ch
    if scan > 2000 {
        scan = 2000
    }
    var total int = 0
    var ch int = 1
    while ch <= scan {
        let body str = chapter_body_or_empty(book_id, ch)
        if body != "" {
            total = total + count_occurrences_fast(body, quote)
        }
        ch = ch + 1
    }
    return total
}

/// 全书作用域第 occ 次出现的 canonical 上下文窗口（章缓存正文坐标；
/// before/after 各 ≤64，多字节 substr 同族自洽口径）。
/// 返回 {"before":"…","after":"…"}；定位失败 → ""。
fn ctx_at_occurrence(book_id str, quote str, occ int, ch_total int) str {
    var scan int = ch_total
    if scan > 2000 {
        scan = 2000
    }
    var before_count int = 0
    var ch int = 1
    while ch <= scan {
        let body str = chapter_body_or_empty(book_id, ch)
        if body != "" {
            let in_ch int = count_occurrences_fast(body, quote)
            if occ > before_count {
                if before_count + in_ch >= occ {
                    let k int = occ - before_count
                    let hit str = nth_occurrence_window(body, quote, k)
                    return hit
                }
            }
            before_count = before_count + in_ch
        }
        ch = ch + 1
    }
    return ""
}

/// 正文串内第 k 次出现的 ±64 窗口（canonical ctx JSON）；未命中 → ""。
/// N-r007-xlines1 同源（步数预算）：k-th 定位改 split(quote) 累计——
/// 与 count_occurrences_fast 同口径（非重叠），长章免 O(正文长) 滑窗。
fn nth_occurrence_window(body str, quote str, k int) str {
    let hl int = body.len()
    let nl int = quote.len()
    if nl == 0 {
        return ""
    }
    if nl > hl {
        return ""
    }
    let parts = body.split(quote)
    var i int = 0
    var pos int = 0
    var ok bool = false
    for p in parts {
        i = i + 1
        if i == k {
            ok = true
            break
        }
        pos = pos + p.len() + nl
    }
    if !ok {
        return ""
    }
    if pos + nl > hl {
        return ""
    }
    var bstart int = pos - 64
    if bstart < 0 {
        bstart = 0
    }
    var blen int = pos - bstart
    let before str = body.substr(bstart, blen)
    var astart int = pos + nl
    var alen int = hl - astart
    if alen < 0 {
        alen = 0
    }
    if alen > 64 {
        alen = 64
    }
    var after str = ""
    if alen > 0 {
        after = body.substr(astart, alen)
    }
    var out str = "{\"before\":\""
    out = out + json_escape(before)
    out = out + "\",\"after\":\""
    out = out + json_escape(after)
    out = out + "\"}"
    return out
}

/// 录入环：adapter locator_select 消息 → 七级校验 → canonical reader-locator。
/// session/book/hash/quote/occurrence/cfi 形状/资源身份任一失败具名拒绝，
/// 零写入。occurrence 口径 = 全书 spine 序（adapter 回传面冻结），
/// resource.spine_index = resource_index + 1（0-based spine → 1-based 章），
/// href 由 epub meta 权威派生。返回 {"ok":true,"locator":{…}}。
pub fn reader_locator_select(kind str, session_id str, book_id str, source_hash str, engine str, resource_index int, cfi str, range_cfi str, text_quote str, occurrence int) str {
    if kind == "input_probe" {
        // 输入可达性探针（iframe 无 window.ipc 的 HTTP 回报面，T-03 建立）：
        // 只 ack 不装配不写盘。
        return "{\"ok\":true,\"ack\":\"input_probe\"}"
    }
    if kind != "locator_select" {
        return loc_err("rejected_bad_kind")
    }
    if !session_id_ok(session_id) {
        return loc_err("rejected_bad_session: shape")
    }
    let sj str = find_session_json(session_id)
    if sj == "" {
        return loc_err("rejected_bad_session: unknown session")
    }
    var s_book str = ""
    var s_hash str = ""
    var s_engine str = ""
    try {
        let s = json.parse(sj)
        s_book = "" + s.book_id
        s_hash = "" + s.source_hash
        s_engine = "" + s.engine
    } catch {
        return loc_err("rejected_bad_session: parse")
    }
    if s_book != book_id {
        return loc_err("rejected_bad_session: book mismatch (stale event)")
    }
    if s_hash != source_hash {
        return loc_err("rejected_bad_session: source_hash mismatch (stale event)")
    }
    if engine != s_engine {
        return loc_err("rejected_bad_engine: mismatch")
    }
    let at int = engine.find("@")
    if at < 1 {
        return loc_err("rejected_bad_engine: shape")
    }
    let ename str = engine.substr(0, at)
    let erev str = engine.substr(at + 1, engine.len() - at - 1)
    let rj str = book_json(book_id)
    if rj == "" {
        return loc_err("rejected_bad_document: book not found")
    }
    let rec = json.parse(rj)
    let cur_hash str = "" + rec.source_hash
    if cur_hash != source_hash {
        return loc_err("rejected_bad_document: source_hash mismatch (source revised)")
    }
    let fmt str = "" + rec.format
    if fmt != "epub" {
        return loc_err("rejected_bad_document: locator v2 anchors are epub-only (TXT/MD stay v1)")
    }
    let ch_total int = rec.chapter_count
    let ql int = text_quote.len()
    if ql < 2 {
        return loc_err("rejected_bad_quote: too short")
    }
    if ql > 8192 {
        return loc_err("rejected_bad_quote: too long (<=8192)")
    }
    if resource_index < 0 {
        return loc_err("rejected_bad_resource: index")
    }
    if resource_index >= ch_total {
        return loc_err("rejected_bad_resource: spine out of range")
    }
    let spine int = resource_index + 1
    if !cfi.starts_with("epubcfi(") {
        return loc_err("rejected_bad_cfi: shape")
    }
    if cfi.len() > 512 {
        return loc_err("rejected_bad_cfi: too long")
    }
    if range_cfi != "" {
        if !range_cfi.starts_with("epubcfi(") {
            return loc_err("rejected_bad_cfi: range shape")
        }
        if range_cfi.len() > 512 {
            return loc_err("rejected_bad_cfi: range too long")
        }
    }
    if occurrence < 1 {
        return loc_err("rejected_bad_occurrence: must be >= 1")
    }
    let href str = spine_href_of(book_id, spine)
    if href == "" {
        return loc_err("rejected_bad_resource: spine unavailable")
    }
    let body str = chapter_body_or_empty(book_id, spine)
    if body == "" {
        return loc_err("rejected_bad_resource: content unavailable")
    }
    if count_occurrences_fast(body, text_quote) < 1 {
        return loc_err("rejected_bad_quote: not in resource (verbatim)")
    }
    let total int = book_count_before(book_id, text_quote, ch_total)
    if occurrence > total {
        return loc_err("rejected_bad_occurrence: out of range (book scope)")
    }
    let ctx str = ctx_at_occurrence(book_id, text_quote, occurrence, ch_total)
    if ctx == "" {
        return loc_err("rejected_bad_occurrence: not locatable")
    }
    let c = json.parse(ctx)
    let ctx_b str = "" + c.before
    let ctx_a str = "" + c.after
    let now int = time.now_sec()
    let loc str = locator_canonical("epub_range", book_id, source_hash, spine, href, ename, erev, cfi, range_cfi, text_quote, ctx_b, ctx_a, "book", occurrence, now)
    var out str = "{\"ok\":true,\"locator\":"
    out = out + loc
    out = out + "}"
    return out
}

/// 恢复/回访环核心（纯函数面）：locator 文档 → 身份链/资源身份/逐字
/// quote/作用域位次/上下文窗口重算比对。返回 "" = 通过；非空 = 具名原因
/// （"rejected_*" = 结构/身份拒；"needs_relocate:…" = 位置失配——原摘录
/// 保留语义由调用方承担，此处零写入）。
pub fn locator_verify_str(book_id str, locator_raw str) str {
    let verr str = valid_locator_document(locator_raw)
    if verr != "" {
        return "rejected_bad_locator: " + verr
    }
    var parsed = null
    try {
        parsed = json.parse(locator_raw)
    } catch {
        return "rejected_bad_locator: parse"
    }
    let canonical str = locator_emit(parsed)
    if canonical == "" {
        return "rejected_bad_locator: canonical rebuild failed"
    }
    var lbid str = ""
    var lhash str = ""
    var kind str = ""
    var spine int = 0
    var href str = ""
    var cfi str = ""
    var quote str = ""
    var scope str = ""
    var oidx int = 0
    try {
        lbid = "" + parsed.book_id
        lhash = "" + parsed.source_hash
        kind = "" + parsed.kind
        quote = "" + parsed.quote
        scope = "" + parsed.occurrence.scope
        let rs str = "" + parsed.resource.spine_index
        spine = rs.to_int()
        href = "" + parsed.resource.href
        let rg = parsed.range
        let st = rg.start
        cfi = "" + st.cfi
        let os str = "" + parsed.occurrence.index
        oidx = os.to_int()
    } catch {
        return "rejected_bad_locator: fields"
    }
    if lbid != book_id {
        return "rejected_book_mismatch"
    }
    let rj str = book_json(book_id)
    if rj == "" {
        return "rejected_bad_document: book not found"
    }
    let rec = json.parse(rj)
    let cur_hash str = "" + rec.source_hash
    if lhash != cur_hash {
        return "needs_relocate: source_hash mismatch (source revised)"
    }
    let ch_total int = rec.chapter_count
    if spine < 1 {
        return "rejected_bad_resource: spine"
    }
    if spine > ch_total {
        return "rejected_bad_resource: spine out of range"
    }
    let want_href str = spine_href_of(book_id, spine)
    if want_href == "" {
        return "rejected_bad_resource: spine unavailable"
    }
    if want_href != href {
        return "needs_relocate: resource href mismatch at spine"
    }
    if kind == "epub_range" {
        if !cfi.starts_with("epubcfi(") {
            return "rejected_bad_cfi: shape"
        }
    }
    if quote == "" {
        return "rejected_bad_quote: empty"
    }
    if oidx < 1 {
        return "rejected_bad_occurrence: must be >= 1"
    }
    let body str = chapter_body_or_empty(book_id, spine)
    if body == "" {
        return "rejected_bad_resource: content unavailable"
    }
    if count_occurrences_fast(body, quote) < 1 {
        return "needs_relocate: quote not in resource (verbatim)"
    }
    // 作用域位次：book = 全书 spine 序；resource/section = 章内序
    // （换算为全书位次后统一走上下文重算）。
    var book_occ int = oidx
    if scope != "book" {
        let earlier int = book_count_before(book_id, quote, spine - 1)
        book_occ = earlier + oidx
    }
    let available int = book_count_before(book_id, quote, ch_total)
    if book_occ > available {
        return "needs_relocate: occurrence out of range"
    }
    let ctx str = ctx_at_occurrence(book_id, quote, book_occ, ch_total)
    if ctx == "" {
        return "needs_relocate: claimed occurrence not locatable"
    }
    let c = json.parse(ctx)
    let want_b str = "" + c.before
    let want_a str = "" + c.after
    var got_b str = ""
    var got_a str = ""
    try {
        let stored = parsed.context
        got_b = "" + stored.before
        got_a = "" + stored.after
    } catch {
        return "rejected_bad_locator: context"
    }
    if got_b != want_b {
        return "needs_relocate: context.before mismatch at claimed occurrence (may point at another occurrence)"
    }
    if got_a != want_a {
        return "needs_relocate: context.after mismatch at claimed occurrence (may point at another occurrence)"
    }
    return ""
}

/// POST /api/library/locator/verify — 恢复/回访环 oracle（只读比对，零写入）。
/// body: { book_id, locator }。返回
/// {"ok":true,"match":true} 或 {"ok":true,"match":false,"reason":"…"}
/// 或 {"ok":false,"error":"…"}（结构/词法拒—— forged 形态非 relocate）。
pub fn locator_verify_json(book_id str, locator_raw str) str {
    if book_id == "" {
        return loc_err("book_id required")
    }
    if locator_raw == "" {
        return loc_err("locator required")
    }
    let vr str = locator_verify_str(book_id, locator_raw)
    if vr == "" {
        return "{\"ok\":true,\"match\":true,\"reason\":\"\"}"
    }
    var out str = "{\"ok\":true,\"match\":false,\"reason\":\""
    out = out + json_escape(vr)
    out = out + "\"}"
    return out
}

// ---- 单测说明 ----
// library 级事务测试不放 #[test]：VM 测试装置在「跨模块调用 + var 局部
// 字符串累积」时会把模块变量名混入局部值（T-01 实测记录，pathx/hashx/
// importers 自包含测试不受影响）。
// 本模块行为由 tests/spec/t01_library_spec.as（脚本模式，跨模块无此缺陷）
// 与运行中应用的 HTTP 端点验证共同覆盖。
