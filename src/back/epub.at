// epub.at — READER-003 EPUB 导入事务（zip natives + 纯 .at XML 扫描）。
// 架构（capability-decision.md 2026-10-31 修订）：
//   - ZIP/解压走 PLAN-897 zip natives（zip.list_json/read_text）；预算直传：
//     container/OPF/nav 清单类 4MiB，章 XHTML 12MiB（CAP-03 单条目上限）。
//   - XML 扫描 = 纯 .at str 操作（find/substr 字节索引，find 保多字节），
//     只取 container/OPF/nav 所需子集；未支持形态（百分号编码 href、
//     DTD/实体表）诚实拒绝——能力表（SD-01）如实记录。
//   - 书版本身份 = hash.file_sha256 整文件真摘要（无 ph1 碰撞面）。
//   - 惰性按章解压：导入期只做结构性校验（container/OPF/nav + spine 目标
//     存在），章体首读时解压转换并缓存（epub_chapter_json，T-02 交付）。
//   - 提交全有或全无：任何解析/预算失败不落受管资产与记录；受管副本写入
//     后 sha256 读回对账（F-03 的二进制等价物）。
use pathx: join, mkdirs, json_escape
use library: books_json, data_dir, record_json, write_library_file, hash_dir_of, write_epub_meta_file

/// 在 xml 中自 from 起查找 needle 首现（字节索引；-1 未命中）。
/// 用后缀 substr + find 实现（find 自 0 起；OPF/nav 尺寸 KB 级可接受）。
fn find_after(xml str, needle str, from int) int {
    if from <= 0 {
        return xml.find(needle)
    }
    if from >= xml.len() {
        return -1
    }
    let tail str = xml.substr(from, xml.len() - from)
    let p int = tail.find(needle)
    if p < 0 {
        return -1
    }
    return p + from
}

/// 标签内属性值：自 from 起 tag_name（形如 "item"）首现的标签体内
/// attr="value"。未命中 ""。
fn xml_attr(xml str, from int, tag_name str, attr str) str {
    // 名称边界守卫："<rootfile" 不得命中 "<rootfiles"——匹配后随字符须为
    // 空白/'>'/'/'（标签名终止符），否则继续找下一处。
    let open str = "<" + tag_name
    var t int = find_after(xml, open, from)
    var guard int = 0
    while guard < 4096 {
        guard = guard + 1
        if t < 0 {
            return ""
        }
        let nxt int = t + open.len()
        if nxt >= xml.len() {
            break
        }
        let c str = xml.substr(nxt, 1)
        if c == " " {
            break
        }
        if c == ">" {
            break
        }
        if c == "/" {
            break
        }
        if c == "	" {
            break
        }
        if c == "
" {
            break
        }
        t = find_after(xml, open, t + 1)
    }
    let gt int = find_after(xml, ">", t)
    if gt < 0 {
        return ""
    }
    let seg str = xml.substr(t, gt - t)
    let pat str = attr + "=\""
    let a int = seg.find(pat)
    if a < 0 {
        return ""
    }
    let vs int = a + pat.len()
    let ve int = seg.find("\"", vs)
    if ve < 0 {
        return ""
    }
    return seg.substr(vs, ve - vs)
}

/// <open>…</close> 首现文本（自 from 起）。未命中 ""。
fn xml_text(xml str, from int, open str, close str) str {
    let s int = find_after(xml, open, from)
    if s < 0 {
        return ""
    }
    // 跳到本标签的 '>' 之后（属性/命名空间后缀在开标签内）
    let gt int = find_after(xml, ">", s)
    if gt < 0 {
        return ""
    }
    let vs int = gt + 1
    let ve int = find_after(xml, close, vs)
    if ve < 0 {
        return ""
    }
    return xml.substr(vs, ve - vs)
}

/// href 安全性（CAP-03/T-03）：非空、无反斜杠、无盘符冒号、无 ".."、
/// 无 "//"、不以 "/" 起、无百分号（百分号编码 v1 诚实拒绝——能力表记录）。
/// 通过返回原串，否则 ""。
pub fn epub_href_ok(href str) str {
    if href == "" {
        return ""
    }
    if href.find("\\") >= 0 {
        return ""
    }
    if href.find(":") >= 0 {
        return ""
    }
    if href.find("%") >= 0 {
        return ""
    }
    if href.find("`") >= 0 {
        return ""
    }
    if href.find("|") >= 0 {
        return ""
    }
    if href.find("..") >= 0 {
        return ""
    }
    if href.find("//") >= 0 {
        return ""
    }
    if href.substr(0, 1) == "/" {
        return ""
    }
    return href
}

/// 相对 href → ZIP 内路径（base_dir 为 OPF 目录，含尾 "/" 或 ""）。
pub fn epub_zip_path(base_dir str, href str) str {
    let h str = epub_href_ok(href)
    if h == "" {
        return ""
    }
    return base_dir + h
}

/// container.xml → rootfile full-path（OPF 路径）。
pub fn epub_opf_path_from_container(container str) str {
    let fp str = xml_attr(container, 0, "rootfile", "full-path")
    return epub_href_ok(fp)
}

/// manifest 内 properties 含 "nav" 的条目 href（OPF 相对）。
pub fn epub_nav_href(opf str) str {
    var from int = 0
    var guard int = 0
    while guard < 4096 {
        guard = guard + 1
        let t int = find_after(opf, "<item ", from)
        if t < 0 {
            return ""
        }
        let gt int = find_after(opf, ">", t)
        if gt < 0 {
            return ""
        }
        let seg str = opf.substr(t, gt - t)
        if seg.find("properties=\"nav\"") >= 0 {
            let pat str = "href=\""
            let a int = seg.find(pat)
            if a >= 0 {
                let vs int = a + pat.len()
                let ve int = seg.find("\"", vs)
                if ve > vs {
                    return seg.substr(vs, ve - vs)
                }
            }
        }
        from = gt
    }
    return ""
}

// ═══════════════════════════════════════════════════════════
// 导入结果 JSON（与 library.import_book_json 同构）
// ═══════════════════════════════════════════════════════════

fn epub_err(code str, msg str) str {
    var m str = "{\"code\":\""
    m = m + code
    m = m + "\",\"message\":\""
    m = m + json_escape(msg)
    m = m + "\",\"book_id\":\"\",\"existing_id\":\"\"}"
    return m
}

/// EPUB 导入主入口。path 已由调用方做存在性/扩展名分派。
/// 返回与 import_book_json 同构的结果 JSON；错误码以 "epub_" 前缀区分。
/// library 注入的共享助手以 pub（library 端 pub 化）提供。
pub fn epub_import_json(path str, author str, force bool) str {
    let size int = fs.file_size(path)
    if size <= 0 {
        return epub_err("epub_invalid", "EPUB 文件为空或不可读")
    }
    // CAP-03：输入 ≤ 30 MiB
    if size > 31457280 {
        return epub_err("epub_too_large", "EPUB 超过 30MiB 上限")
    }
    // 身份：整文件 sha256
    let sha str = hash.file_sha256(path)
    let source_hash str = "sha256:" + sha
    // 去重：同 sha256 = 同内容（密码学摘要即内容证明，无 ph1 碰撞面）
    let cur str = books_json()
    if cur == "" {
        return epub_err("io_error", "书库索引版本不受支持：已保留原文件，需人工迁移")
    }
    let parsed = json.parse(cur)
    let books = parsed.books
    var dup_id str = ""
    var dup_title str = ""
    for b in books {
        let bsh str = "" + b.source_hash
        if bsh == source_hash {
            dup_id = "" + b.book_id
            dup_title = "" + b.title
        }
    }
    if dup_id != "" {
        if !force {
            var dm str = "{\"code\":\"duplicate\",\"message\":\"已存在相同内容的书: "
            dm = dm + json_escape(dup_title)
            dm = dm + "\",\"book_id\":\"\",\"existing_id\":\""
            dm = dm + json_escape(dup_id)
            dm = dm + "\"}"
            return dm
        }
    }
    // container.xml → OPF 路径
    let container str = zip.read_text(path, "META-INF/container.xml", 4194304)
    if container == "" {
        return epub_err("epub_invalid", "缺少 META-INF/container.xml（不是合法 EPUB 容器）")
    }
    let opf_path str = epub_opf_path_from_container(container)
    if opf_path == "" {
        return epub_err("epub_invalid", "container.xml 未声明有效的 rootfile")
    }
    // OPF：元数据 + manifest + spine（结构校验 = 导入期全部必需面）
    let opf str = zip.read_text(path, opf_path, 4194304)
    if opf == "" {
        return epub_err("epub_invalid", "OPF 包文档缺失或超预算: " + opf_path)
    }
    let title str = xml_text(opf, 0, "<dc:title", "</dc:title>")
    if title == "" {
        return epub_err("epub_invalid", "OPF 缺少 dc:title")
    }
    let creator str = xml_text(opf, 0, "<dc:creator", "</dc:creator>")
    // spine idref 序列（数量 = 章数）
    // spine idref 集合（"|id1|id2|…"，首尾管道便于 find 精确命中）
    var spine_refs str = "|"
    var spine_n int = 0
    var from int = 0
    var spine_end int = find_after(opf, "</spine>", 0)
    if spine_end < 0 {
        return epub_err("epub_invalid", "OPF 缺少 spine")
    }
    var guard int = 0
    while guard < 4096 {
        guard = guard + 1
        if from >= spine_end {
            break
        }
        let t int = find_after(opf, "<itemref", from)
        if t < 0 {
            break
        }
        if t >= spine_end {
            break
        }
        let gt int = find_after(opf, ">", t)
        if gt < 0 {
            break
        }
        let seg str = opf.substr(t, gt - t)
        let pat str = "idref=\""
        let a int = seg.find(pat)
        if a >= 0 {
            let vs int = a + pat.len()
            let ve int = seg.find("\"", vs)
            if ve > vs {
                let idref str = seg.substr(vs, ve - vs)
                let fenced str = "|" + idref + "|"
                if spine_refs.find(fenced) < 0 {
                    spine_refs = spine_refs + idref
                    spine_refs = spine_refs + "|"
                    spine_n = spine_n + 1
                }
            }
        }
        from = gt
    }
    if spine_n == 0 {
        return epub_err("epub_invalid", "spine 为空（无可阅读内容）")
    }
    if spine_n > 4096 {
        return epub_err("epub_too_many", "spine 条目超过 4096 上限")
    }
    // 单遍 manifest 扫描：id 命中 spine 集合 → 直接累积 href（顺序=manifest
    // 顺序；章序由 meta 侧按 href→spine 索引还原，读侧用 href 寻章）。
    var hrefs str = "|"
    var hit_n int = 0
    var mfrom int = 0
    var mguard int = 0
    while mguard < 8192 {
        mguard = mguard + 1
        if mfrom >= spine_end {
            break
        }
        let t int = find_after(opf, "<item ", mfrom)
        if t < 0 {
            break
        }
        if t >= spine_end {
            break
        }
        let gt int = find_after(opf, ">", t)
        if gt < 0 {
            break
        }
        let seg str = opf.substr(t, gt - t)
        let ip str = "id=\""
        let hp str = "href=\""
        let ia int = seg.find(ip)
        let ha int = seg.find(hp)
        if ia >= 0 {
            if ha >= 0 {
                let ivs int = ia + ip.len()
                let ive int = seg.find("\"", ivs)
                let hvs int = ha + hp.len()
                let hve int = seg.find("\"", hvs)
                if ive > ivs {
                    if hve > hvs {
                        let mid str = seg.substr(ivs, ive - ivs)
                        let fenced str = "|" + mid + "|"
                        if spine_refs.find(fenced) >= 0 {
                            let mh str = seg.substr(hvs, hve - hvs)
                            if epub_href_ok(mh) == "" {
                                return epub_err("epub_invalid", "manifest href 未通过安全检查: " + mh)
                            }
                            hrefs = hrefs + mh
                            hrefs = hrefs + "|"
                            hit_n = hit_n + 1
                        }
                    }
                }
            }
        }
        mfrom = gt
    }
    if hit_n != spine_n {
        var dbg str = "spine 引用数与 manifest 命中数不一致: spine="
        dbg = dbg + spine_n.to_string()
        dbg = dbg + " hit="
        dbg = dbg + hit_n.to_string()
        return epub_err("epub_invalid", dbg)
    }
    // OPF 目录（用于相对 href → ZIP 路径）
    var opf_dir str = ""
    var slash int = opf_path.len() - 1
    while slash >= 0 {
        if opf_path.substr(slash, 1) == "/" {
            opf_dir = opf_path.substr(0, slash + 1)
            slash = -1
        } else {
            slash = slash - 1
        }
    }
    // nav（EPUB3 必需；缺失诚实拒绝）
    let nav_href str = epub_nav_href(opf)
    if nav_href == "" {
        return epub_err("epub_invalid", "manifest 缺少 properties=\"nav\" 的导航文档（EPUB3 必需）")
    }
    let nav_zip str = epub_zip_path(opf_dir, nav_href)
    if nav_zip == "" {
        return epub_err("epub_invalid", "nav href 未通过安全检查: " + nav_href)
    }
    let nav str = zip.read_text(path, nav_zip, 2097152)
    if nav == "" {
        return epub_err("epub_invalid", "导航文档缺失或超预算: " + nav_zip)
    }
    // 目录条目：<a href="...">label</a> 顺序提取（h 段锚点 v1 不拆——能力表记录）
    var toc str = "|"
    var tfrom int = 0
    var tguard int = 0
    var tcount int = 0
    while tguard < 4096 {
        tguard = tguard + 1
        let at int = find_after(nav, "<a ", tfrom)
        if at < 0 {
            break
        }
        let label int = find_after(nav, ">", at)
        if label < 0 {
            break
        }
        let ac int = find_after(nav, "</a>", label)
        if ac < 0 {
            break
        }
        let seg str = nav.substr(at, label - at + 1)
        let hp str = "href=\""
        let ha int = seg.find(hp)
        if ha >= 0 {
            let hvs int = ha + hp.len()
            let hve int = seg.find("\"", hvs)
            if hve > hvs {
                let hh str = seg.substr(hvs, hve - hvs)
                if epub_href_ok(hh) != "" {
                    let lbl str = nav.substr(label + 1, ac - label - 1)
                    var trec str = hh + "`"
                    trec = trec + lbl
                    trec = trec + "|"
                    toc = toc + trec
                    tcount = tcount + 1
                }
            }
        }
        tfrom = label
    }
    // 受管资产：books/<hashdir>/original.epub（file.copy + sha256 读回对账）
    let dd str = data_dir()
    let books_root str = join(dd, "books")
    let hdir str = hash_dir_of(source_hash)
    let dir str = join(books_root, hdir)
    let mrc int = mkdirs(dir)
    if mrc != 0 {
        return epub_err("io_error", "书库目录创建失败 rc=" + mrc.to_string())
    }
    let managed str = join(dir, "original.epub")
    if !file.exists(managed) {
        let crc int = file.copy(path, managed)
        if crc != 0 {
            return epub_err("io_error", "受管副本拷贝失败 rc=" + crc.to_string())
        }
        let back_sha str = hash.file_sha256(managed)
        if back_sha != sha {
            return epub_err("io_error", "受管副本校验失败（sha256 与源不一致）")
        }
    }
    // epubmeta 边车（T-02 章读取/目录消费；导入期一次写就）
    let bid str = str.uuid()
    var meta str = "{\"version\":1,\"kind\":\"epub\",\"source_sha256\":\""
    meta = meta + json_escape(source_hash)
    meta = meta + "\",\"opf_dir\":\""
    meta = meta + json_escape(opf_dir)
    meta = meta + "\",\"spine\":\""
    meta = meta + json_escape(hrefs)
    meta = meta + "\",\"toc\":\""
    meta = meta + json_escape(toc)
    meta = meta + "\",\"title\":\""
    meta = meta + json_escape(title)
    meta = meta + "\",\"author\":\""
    meta = meta + json_escape(creator)
    meta = meta + "\",\"spine_n\":"
    meta = meta + spine_n.to_string()
    meta = meta + ",\"toc_n\":"
    meta = meta + tcount.to_string()
    meta = meta + "}"
    let mwrc int = write_epub_meta_file(bid, meta)
    if mwrc != 0 {
        return epub_err("io_error", "EPUB 索引写入失败 rc=" + mwrc.to_string())
    }
    // 库记录（format "epub"；created_at 恒 0——a2r_std 无 time，框架债）
    var who str = author
    if who.trim() == "" {
        who = "未知"
    }
    let nrj str = record_json(bid, source_hash, title, who, "epub", path, managed, size, spine_n, 1, 0)
    var payload str = "{\"version\":1,\"books\":["
    var i int = 0
    for b in books {
        if i > 0 {
            payload = payload + ","
        }
        let v1 str = "" + b.book_id
        let v2 str = "" + b.source_hash
        let v3 str = "" + b.title
        let v4 str = "" + b.author
        let v5 str = "" + b.format
        let v6 str = "" + b.original_path
        let v7 str = "" + b.managed_path
        let n1 int = b.size
        let n2 int = b.chapter_count
        let n3 int = b.import_version
        let n4 int = b.created_at
        let rj str = record_json(v1, v2, v3, v4, v5, v6, v7, n1, n2, n3, n4)
        payload = payload + rj
        i = i + 1
    }
    if i > 0 {
        payload = payload + ","
    }
    payload = payload + nrj
    payload = payload + "]}"
    let src_rc int = write_library_file(payload)
    if src_rc != 0 {
        return epub_err("io_error", "书库索引写入失败 rc=" + src_rc.to_string())
    }
    var okm str = "{\"code\":\"ok\",\"message\":\"导入成功\",\"book_id\":\""
    okm = okm + json_escape(bid)
    okm = okm + "\",\"existing_id\":\""
    okm = okm + json_escape(dup_id)
    okm = okm + "\"}"
    return okm
}


// ═══════════════════════════════════════════════════════════
// T-02：章读取（惰性解压 + 缓存）与目录
// 章 XHTML 首读解压 → 文本行（段落/图片标记行）→ 落盘
// <managed>.chapters/<n>.txt 永久缓存；后续读直接文件。
// ═══════════════════════════════════════════════════════════

/// hrefs（"|h1|h2|…"）取第 n（1 基）个 href；越界 ""。
pub fn epub_href_at(hrefs str, n int) str {
    var idx int = 1
    var pos int = 1
    while idx < n {
        let nxt int = find_after(hrefs, "|", pos)
        if nxt < 0 {
            return ""
        }
        pos = nxt + 1
        idx = idx + 1
    }
    let end int = find_after(hrefs, "|", pos)
    if end < 0 {
        return ""
    }
    return hrefs.substr(pos, end - pos)
}

// ═══════════════════════════════════════════════════════════
// READER-005 T-02：图片资源身份（双射扁平化 + 稳定媒体 URI）
// ═══════════════════════════════════════════════════════════

/// zip 资源路径 → 双射 URL 安全扁平名（T-00 决策 §3）：
/// `_`→`__`、`/`→`_`、URL 不安全字符→具名转义（`_s_` 等）；
/// 其余非 ASCII/未收编字符 → ""（诚实不支持，不产生碰撞面）。
/// 字面字母集 = [A-Za-z0-9.-]，永不与 `_` 起始的转义序列混淆——
/// `a/b_c.png`→`a_b__c.png` 与 `a_b/c.png`→`a__b_c.png` 不同槽。
pub fn epub_flat_res(zpath str) str {
    var flat str = ""
    var i int = 0
    while i < zpath.len() {
        let c str = zpath.substr(i, 1)
        var esc str = ""
        if c == "_" {
            esc = "__"
        }
        if c == "/" {
            esc = "_"
        }
        if c == " " {
            esc = "_s_"
        }
        if c == "#" {
            esc = "_h_"
        }
        if c == "?" {
            esc = "_q_"
        }
        if c == "&" {
            esc = "_a_"
        }
        if c == "=" {
            esc = "_e_"
        }
        if c == "+" {
            esc = "_p_"
        }
        if c == ";" {
            esc = "_sc_"
        }
        if c == "@" {
            esc = "_at_"
        }
        if c == "," {
            esc = "_cm_"
        }
        if c == "'" {
            esc = "_sq_"
        }
        if c == "(" {
            esc = "_op_"
        }
        if c == ")" {
            esc = "_cp_"
        }
        if c == "[" {
            esc = "_ob_"
        }
        if c == "]" {
            esc = "_cb_"
        }
        if c == "!" {
            esc = "_ex_"
        }
        if c == "~" {
            esc = "_tl_"
        }
        if c == "^" {
            esc = "_c_"
        }
        if c == "{" {
            esc = "_lb_"
        }
        if c == "}" {
            esc = "_rb_"
        }
        if c == "*" {
            esc = "_as_"
        }
        if esc == "" {
            var keep bool = false
            if "0123456789".find(c) >= 0 {
                keep = true
            }
            if "abcdefghijklmnopqrstuvwxyz".find(c) >= 0 {
                keep = true
            }
            if "ABCDEFGHIJKLMNOPQRSTUVWXYZ".find(c) >= 0 {
                keep = true
            }
            if c == "." {
                keep = true
            }
            if c == "-" {
                keep = true
            }
            if keep {
                esc = c
            }
        }
        if esc == "" {
            return ""
        }
        flat = flat + esc
        i = i + 1
    }
    return flat
}

/// 资源扩展名 → content type（"" = 不支持；T-00 冻结 profile：
/// png/jpg/jpeg/gif/bmp/webp——浏览器与 iced 公共分母）。
pub fn epub_img_type_of(name str) str {
    let n int = name.len()
    if n < 4 {
        return ""
    }
    let e4 str = name.substr(n - 4, 4)
    if e4 == ".png" {
        return "image/png"
    }
    if e4 == ".PNG" {
        return "image/png"
    }
    if e4 == ".jpg" {
        return "image/jpeg"
    }
    if e4 == ".JPG" {
        return "image/jpeg"
    }
    if e4 == ".gif" {
        return "image/gif"
    }
    if e4 == ".GIF" {
        return "image/gif"
    }
    if e4 == ".bmp" {
        return "image/bmp"
    }
    if e4 == ".BMP" {
        return "image/bmp"
    }
    if n < 5 {
        return ""
    }
    let e5 str = name.substr(n - 5, 5)
    if e5 == ".jpeg" {
        return "image/jpeg"
    }
    if e5 == ".JPEG" {
        return "image/jpeg"
    }
    if e5 == ".webp" {
        return "image/webp"
    }
    if e5 == ".WEBP" {
        return "image/webp"
    }
    return ""
}

/// images[] 条目：{k, uri, err}（err 恒在位，空串 = 正常——前端单形解析）。
fn img_entry_json(k str, uri str, err str) str {
    var s str = "{\"k\":\""
    s = s + json_escape(k)
    s = s + "\",\"uri\":\""
    s = s + json_escape(uri)
    s = s + "\",\"err\":\""
    s = s + json_escape(err)
    s = s + "\"}"
    return s
}

/// XHTML → 文本行（段落/标题/图片标记行），"\n" 连接。
/// 图片：<img src> → "img:<zip 内路径>" 行。实体五预定义解码。
/// script/style 剥离。v1 边界（能力表记录）：行内链接不拆段。
/// 开标签文本内属性取值（`attr="value"` 首现；未命中 ""）。
/// N-r007-xlinks1（READER-007 T-05 缺陷修复）：章链接解析原经
/// xml_attr(body, pos, …) 对剩余整段正文做 find_after——每块一次
/// O(剩余正文) 尾复制，长章（12000 块）退化为 O(块数×正文长)
/// （>300s + GB 级瞬存，product-alpha ch2→ch3 级联/ch3 自身实测挂起，
/// 2026-11-03）。调用点已在手标签 span（tag），属性取值改为标签内
/// 局部查找——取值语义不变（同标签同 attr 同值），复杂度 O(标签长)。
fn tag_attr_of(seg str, attr str) str {
    let pat str = attr + "=\""
    let a int = seg.find(pat)
    if a < 0 {
        return ""
    }
    let vs int = a + pat.len()
    let ve int = seg.find("\"", vs)
    if ve < 0 {
        return ""
    }
    return seg.substr(vs, ve - vs)
}

fn xhtml_to_lines(xhtml str, opf_dir str) str {
    var body str = xml_text(xhtml, 0, "<body", "</body>")
    if body == "" {
        body = xhtml
    }
    body = strip_block(body, "<script", "</script>")
    body = strip_block(body, "<style", "</style>")
    let parts = body.split("<")
    // N-r007-xlines1（READER-007 T-05 缺陷修复）：扫描改 split("<") 一次 +
    // 逐段局部处理。原实现逐 tag find_after——每次调用 substr 复制剩余整段
    // 正文（O(块数×正文长)），长章（12000 块）实测 >300s 不终止（2026-11-03
    // product-alpha ch2→ch3 级联/ch3 自身挂起，搜索/注释/locator 全被拖住）。
    // 步数预算面：实体/图片探测提升到全书一次（正文无 "&"/"<img" 时每段免
    // find native）；512 段计数 spills（免每段 len native）把不可变串重建
    // 降到 O(正文长×常数)。语义逐点等价：文本/标签交替序、img/block flush、
    // 无 ">" 段与超 65536 段守卫按原 break 语义把余段原文并入。
    let has_ent bool = body.find("&") >= 0
    let has_img bool = body.find("<img") >= 0
    var out str = ""
    var cur str = ""
    var batch str = ""
    var first bool = true
    var processed int = 0
    var spilled int = 0
    var broken bool = false
    for seg in parts {
        if first {
            first = false
            cur = cur + decode_entities(seg)
            continue
        }
        if broken {
            cur = cur + decode_entities("<" + seg)
            continue
        }
        if processed >= 65536 {
            broken = true
            cur = cur + decode_entities("<" + seg)
            continue
        }
        let gt int = seg.find(">")
        if gt < 0 {
            broken = true
            cur = cur + decode_entities("<" + seg)
            continue
        }
        processed = processed + 1
        var tag str = "<"
        tag = tag + seg.substr(0, gt + 1)
        let text str = seg.substr(gt + 1, seg.len() - gt - 1)
        if has_img {
            if tag.find("<img") == 0 {
                // img src 标签内局部取值（同 N-r007-xlinks1 缺陷类）
                let src str = tag_attr_of(tag, "src")
                if cur.trim() != "" {
                    batch = batch + cur.trim()
                    batch = batch + "\n"
                    cur = ""
                }
                let imgpath str = epub_zip_path(opf_dir, src)
                if imgpath != "" {
                    var il str = "img:"
                    il = il + imgpath
                    batch = batch + il
                    batch = batch + "\n"
                }
            } else {
                if is_block_tag(tag) {
                    if cur.trim() != "" {
                        batch = batch + cur.trim()
                        batch = batch + "\n"
                        cur = ""
                    }
                }
            }
        } else {
            if is_block_tag(tag) {
                if cur.trim() != "" {
                    batch = batch + cur.trim()
                    batch = batch + "\n"
                    cur = ""
                }
            }
        }
        if has_ent {
            cur = cur + decode_entities(text)
        } else {
            cur = cur + text
        }
        spilled = spilled + 1
        if spilled >= 512 {
            out = out + batch
            batch = ""
            spilled = 0
        }
    }
    if cur.trim() != "" {
        batch = batch + cur.trim()
        batch = batch + "\n"
    }
    out = out + batch
    return out
}

// ═══════════════════════════════════════════════════════════
// READER-005 T-03：书内链接/脚注（正文行字节零变更；链接表旁路缓存）
// ═══════════════════════════════════════════════════════════

/// 剥内联标签（<sup>/<em> 等嵌套在 <a> 内时取纯文本）。
fn strip_tags(s str) str {
    var out str = ""
    var pos int = 0
    var guard int = 0
    while guard < 4096 {
        guard = guard + 1
        let lt int = find_after(s, "<", pos)
        if lt < 0 {
            out = out + s.substr(pos, s.len() - pos)
            return out
        }
        if lt > pos {
            out = out + s.substr(pos, lt - pos)
        }
        let gt int = find_after(s, ">", lt)
        if gt < 0 {
            return out
        }
        pos = gt + 1
    }
    return out
}

/// 路径目录部（含尾 "/"；无 "/" → ""）。
fn epub_dir_of(p str) str {
    var i int = p.len() - 1
    while i >= 0 {
        if p.substr(i, 1) == "/" {
            return p.substr(0, i + 1)
        }
        i = i - 1
    }
    return ""
}

/// XHTML → 链接/锚点表 JSON。与 xhtml_to_lines 逐 tag 同步进（含 img 行
/// 占位）：nline = 已产出正文行数 = 当前段最终行号（两函数对同一输入必
/// 须给出同一行号——R-03 以目标段文本逐字断言钉死对齐）。
/// links: [{line,href,label}]（href 原样，目标解析在章 JSON 构建期）；
/// ids: {id: line}（块级元素 id → 其内容 flush 行号；嵌套取首个内层
/// flush 行——div 包多段时锚其首段，能力表记录）。
/// 空 label（如纯图链接）不收录（v1 边界）。
/// N-r007-xlinks1（READER-007 T-05 缺陷修复）：扫描改 split("<") 一次 +
/// 逐段局部处理（原逐 tag/逐 link find_after 各复制一次剩余正文尾——
/// O(块数×正文长)，长章挂起实证同 xhtml_to_lines）。行号/ids/links 记录
/// 判定与原一致；label 由「</a> 前原文 strip_tags」等价改为「顺序累积
/// 文本部、</a> 截断、4096 同界放弃」（strip_tags(raw) ≡ 文本部拼接，
/// 标签内嵌文本经分段自然扁平化；嵌套 <a>/异常嵌套边界随 v1 能力表）。
fn xhtml_links(xhtml str, base_dir str) str {
    var body str = xml_text(xhtml, 0, "<body", "</body>")
    if body == "" {
        body = xhtml
    }
    body = strip_block(body, "<script", "</script>")
    body = strip_block(body, "<style", "</style>")
    let parts = body.split("<")
    var links str = "["
    var lkn int = 0
    var ids str = "{"
    var idn int = 0
    var pending str = ""
    var nline int = 0
    var cur str = ""
    var first bool = true
    var processed int = 0
    var broken bool = false
    var in_link bool = false
    var link_href str = ""
    var link_line int = 0
    var label str = ""
    for seg in parts {
        if first {
            first = false
            cur = cur + decode_entities(seg)
            continue
        }
        if broken {
            cur = cur + decode_entities("<" + seg)
            continue
        }
        if processed >= 65536 {
            broken = true
            cur = cur + decode_entities("<" + seg)
            continue
        }
        let gt int = seg.find(">")
        if gt < 0 {
            broken = true
            cur = cur + decode_entities("<" + seg)
            continue
        }
        processed = processed + 1
        var tag str = "<"
        tag = tag + seg.substr(0, gt + 1)
        let text str = seg.substr(gt + 1, seg.len() - gt - 1)
        if tag.find("<img") == 0 {
            // 与 xhtml_to_lines 同形：flush 当前段（可能记 pending id），
            // 再产出 img: 行占位
            if cur.trim() != "" {
                if pending != "" {
                    if idn > 0 {
                        ids = ids + ","
                    }
                    ids = ids + "\"" + json_escape(pending) + "\":" + nline.to_string()
                    idn = idn + 1
                    pending = ""
                }
                nline = nline + 1
                cur = ""
            }
            nline = nline + 1
        } else {
            if is_block_tag(tag) {
                if cur.trim() != "" {
                    if pending != "" {
                        if idn > 0 {
                            ids = ids + ","
                        }
                        ids = ids + "\"" + json_escape(pending) + "\":" + nline.to_string()
                        idn = idn + 1
                        pending = ""
                    }
                    nline = nline + 1
                    cur = ""
                }
                if tag.substr(1, 1) != "/" {
                    // 块级开标签可携带 id（锚点目标）——标签内局部取值
                    let idv str = tag_attr_of(tag, "id")
                    if idv != "" {
                        if pending == "" {
                            pending = idv
                        }
                    }
                }
            }
        }
        // 在链状态：本段是否关闭（</a> 为独立 tag 段，或落在 text 内）
        if in_link {
            if tag == "</a>" {
                let lbl str = label.trim()
                if lbl != "" {
                    if lkn > 0 {
                        links = links + ","
                    }
                    var rec str = "{\"line\":"
                    rec = rec + link_line.to_string()
                    rec = rec + ",\"href\":\""
                    rec = rec + json_escape(link_href)
                    rec = rec + "\",\"label\":\""
                    rec = rec + json_escape(lbl)
                    rec = rec + "\"}"
                    links = links + rec
                    lkn = lkn + 1
                }
                in_link = false
            } else {
                let cp int = text.find("</a>")
                if cp >= 0 {
                    let part str = text.substr(0, cp)
                    if label.len() <= 4096 {
                        label = label + part
                    }
                    let lbl2 str = label.trim()
                    if lbl2 != "" {
                        if lkn > 0 {
                            links = links + ","
                        }
                        var rec2 str = "{\"line\":"
                        rec2 = rec2 + link_line.to_string()
                        rec2 = rec2 + ",\"href\":\""
                        rec2 = rec2 + json_escape(link_href)
                        rec2 = rec2 + "\",\"label\":\""
                        rec2 = rec2 + json_escape(lbl2)
                        rec2 = rec2 + "\"}"
                        links = links + rec2
                        lkn = lkn + 1
                    }
                    in_link = false
                } else {
                    if label.len() <= 4096 {
                        label = label + text
                    }
                }
            }
        }
        // <a href>：行内不拆段（文本照常入段），登记在链状态
        var is_a bool = false
        if tag.len() > 3 {
            if tag.substr(0, 3) == "<a " {
                is_a = true
            }
        }
        if tag == "<a>" {
            is_a = true
        }
        if is_a {
            if !in_link {
                let href str = tag_attr_of(tag, "href")
                if href != "" {
                    in_link = true
                    link_href = href
                    link_line = nline
                    // label 种子 = 本段 text（</a> 前文本；同段闭合则截断）
                    label = text
                    let cp2 int = text.find("</a>")
                    if cp2 >= 0 {
                        label = text.substr(0, cp2)
                        let lbl3 str = label.trim()
                        if lbl3 != "" {
                            if lkn > 0 {
                                links = links + ","
                            }
                            var rec3 str = "{\"line\":"
                            rec3 = rec3 + link_line.to_string()
                            rec3 = rec3 + ",\"href\":\""
                            rec3 = rec3 + json_escape(link_href)
                            rec3 = rec3 + "\",\"label\":\""
                            rec3 = rec3 + json_escape(lbl3)
                            rec3 = rec3 + "\"}"
                            links = links + rec3
                            lkn = lkn + 1
                        }
                        in_link = false
                    }
                }
            }
        }
        cur = cur + decode_entities(text)
    }
    if cur.trim() != "" {
        if pending != "" {
            if idn > 0 {
                ids = ids + ","
            }
            ids = ids + "\"" + json_escape(pending) + "\":" + nline.to_string()
            idn = idn + 1
            pending = ""
        }
        nline = nline + 1
    }
    links = links + "]"
    ids = ids + "}"
    var out str = "{\"links\":"
    out = out + links
    out = out + ",\"ids\":"
    out = out + ids
    out = out + "}"
    return out
}

/// 第 number 章链接/锚点表（旁路边车 <managed>.chapters/<n>.links.json；
/// 缺失时按需解压 XHTML 构建——正文 .txt 缓存命中与否无关，12MiB 闸同源；
/// 写失败不阻塞阅读）。章节内容相对 href 的基准 = 该章所在 ZIP 目录。
pub fn epub_links_json(managed str, opf_dir str, hrefs str, number int) str {
    if number < 1 {
        return "{\"links\":[],\"ids\":{}}"
    }
    let chapter_dir str = managed + ".chapters"
    mkdirs(chapter_dir)
    let cpath str = join(chapter_dir, number.to_string() + ".links.json")
    if file.exists(cpath) {
        let cached str = fs.read_text(cpath)
        if cached != "" {
            if cached.find("\"links\":") == 0 {
                return cached
            }
        }
    }
    var out str = "{\"links\":[],\"ids\":{}}"
    let href str = epub_href_at(hrefs, number)
    if href != "" {
        let zip_path str = epub_zip_path(opf_dir, href)
        if zip_path != "" {
            let xhtml str = zip.read_text(managed, zip_path, 12582912)
            if xhtml != "" {
                out = xhtml_links(xhtml, opf_dir + epub_dir_of(href))
                fs.write_text(cpath, out)
            }
        }
    }
    return out
}

fn strip_block(s str, open str, close str) str {
    var out str = ""
    var pos int = 0
    var guard int = 0
    while guard < 4096 {
        guard = guard + 1
        let a int = find_after(s, open, pos)
        if a < 0 {
            out = out + s.substr(pos, s.len() - pos)
            return out
        }
        out = out + s.substr(pos, a - pos)
        let b int = find_after(s, close, a)
        if b < 0 {
            return out
        }
        pos = b + close.len()
    }
    return out
}

fn is_block_tag(tag str) bool {
    // N-r007-xlinks1（步数预算面）：前缀集 {p,/p,h1..h6,/h1../h6,li,/li,
    // div,/div,br,tr} 经 2-3 次 substr + 等值链判别（原 10-22 次 find；
    // 语义逐点等价——前缀匹配含 <pre 等由 "<p" 二字符前缀天然覆盖）。
    let h2 str = tag.substr(0, 2)
    if h2 == "<p" {
        return true
    }
    if h2 == "<h" {
        let h3 str = tag.substr(0, 3)
        if h3 == "<h1" {
            return true
        }
        if h3 == "<h2" {
            return true
        }
        if h3 == "<h3" {
            return true
        }
        if h3 == "<h4" {
            return true
        }
        if h3 == "<h5" {
            return true
        }
        if h3 == "<h6" {
            return true
        }
        return false
    }
    if h2 == "<l" {
        let h3b str = tag.substr(0, 3)
        if h3b == "<li" {
            return true
        }
        return false
    }
    if h2 == "<d" {
        let h4 str = tag.substr(0, 4)
        if h4 == "<div" {
            return true
        }
        return false
    }
    if h2 == "<b" {
        let h3c str = tag.substr(0, 3)
        if h3c == "<br" {
            return true
        }
        return false
    }
    if h2 == "<t" {
        let h3d str = tag.substr(0, 3)
        if h3d == "<tr" {
            return true
        }
        return false
    }
    if h2 == "</" {
        let h3e str = tag.substr(0, 3)
        if h3e == "</p" {
            return true
        }
        if h3e == "</h" {
            let h4b str = tag.substr(0, 4)
            if h4b == "</h1" {
                return true
            }
            if h4b == "</h2" {
                return true
            }
            if h4b == "</h3" {
                return true
            }
            if h4b == "</h4" {
                return true
            }
            if h4b == "</h5" {
                return true
            }
            if h4b == "</h6" {
                return true
            }
            return false
        }
        if h3e == "</l" {
            let h4c str = tag.substr(0, 4)
            if h4c == "</li" {
                return true
            }
            return false
        }
        if h3e == "</d" {
            let h4d str = tag.substr(0, 5)
            if h4d == "</div" {
                return true
            }
            return false
        }
        return false
    }
    return false
}

fn decode_entities(s str) str {
    // N-r007-xlines1 同源（VM 步数预算）：无 "&" 文本占绝对多数——
    // 单次 find 短路，免 5 次 replace（每段 ~10 native 调用 → 1）。
    if s.find("&") < 0 {
        return s
    }
    var out str = s
    out = out.replace("&amp;", "&")
    out = out.replace("&lt;", "<")
    out = out.replace("&gt;", ">")
    out = out.replace("&quot;", "\"")
    out = out.replace("&apos;", "'")
    return out
}

/// 章 JSON：缓存命中读文件；未命中解压转换写缓存（写失败不阻塞阅读）。
/// 返回 {number,title,body,word_count,images[]}；缺章占位 "章节不存在"。
/// READER-005 T-02：bid = 书目 id（媒体 URI 组成部分）；images[] 恒在位，
/// 每项 {k,uri,err}——首读/缓存命中/冷重启同 URI（应用自有稳定服务面，
/// 不再用进程局所的 image.thumb 票据）；err 非空 = 诚实错误（不静默丢）。
pub fn epub_chapter_json(bid str, managed str, opf_dir str, hrefs str, number int, titles str) str {
    if number < 1 {
        return chap_json(number, "章节不存在", "", 0)
    }
    let chapter_dir str = managed + ".chapters"
    mkdirs(chapter_dir)
    var body_lines str = ""
    let cn str = number.to_string()
    let cpath str = join(chapter_dir, cn + ".txt")
    if file.exists(cpath) {
        body_lines = fs.read_text(cpath)
    }
    if body_lines == "" {
        let href str = epub_href_at(hrefs, number)
        if href == "" {
            return chap_json(number, "章节不存在", "", 0)
        }
        let zip_path str = epub_zip_path(opf_dir, href)
        if zip_path == "" {
            return chap_json(number, "内容缺失", "", 0)
        }
        let xhtml str = zip.read_text(managed, zip_path, 12582912)
        if xhtml == "" {
            return chap_json(number, "内容缺失", "", 0)
        }
        body_lines = xhtml_to_lines(xhtml, opf_dir)
        if body_lines != "" {
            let wrc int = fs.write_text(cpath, body_lines)
            if wrc != 0 {
                body_lines = body_lines
            }
        }
    }
    let title str = epub_title_at(titles, number)
    let t str = body_lines.trim()
    // 图片解析（T-02 全路径）：img:<zip 路径> 行 → 双射扁平名 → 12MiB 闸
    // 提取（失败无半写残留）→ 应用自有媒体 URI（/api/reader/media，传输层
    // GET/HEAD/区间 + root 越界 403）；缓存命中同样返回 URI。错误项带
    // 拒绝码诚实可见，不删行不静默（书与位置不受损）。
    // N-r007-xlines2（READER-007 T-05 缺陷修复）：图片扫描改 split 一次 +
    // for-in。原 find_after(lines, "\n", lpos) 每行复制剩余正文尾
    // （O(行数×正文长)，长章 4096 行守卫内即 ~GB 级复制、实测挂起）；
    // 顺带移除 4096 行处理上限（守卫是防死锁面而非语义面——超限行静默
    // 丢图与「不静默丢内容」相悖，长章尾部插图因此曾被漏处理）。
    var images str = "["
    var lines str = t
    var img_n int = 0
    let lns = lines.split("\n")
    for line in lns {
        if line.find("img:") == 0 {
            let zpath str = line.substr(4, line.len() - 4)
            let ctype str = epub_img_type_of(zpath)
            var entry str = ""
            if ctype == "" {
                entry = img_entry_json(zpath, "", "img_unsupported_type")
            } else {
                let flat str = epub_flat_res(zpath)
                if flat == "" {
                    entry = img_entry_json(zpath, "", "img_name_unsupported")
                } else {
                    let dest str = join(chapter_dir, "res_" + flat)
                    if !file.exists(dest) {
                        let zrc int = zip.extract_entry(managed, zpath, dest, 12582912)
                        if zrc == -2 {
                            entry = img_entry_json(zpath, "", "img_too_large")
                        } else {
                            if zrc != 0 {
                                entry = img_entry_json(zpath, "", "img_extract_failed")
                            }
                        }
                    }
                    if entry == "" {
                        if !file.exists(dest) {
                            entry = img_entry_json(zpath, "", "img_missing")
                        } else {
                            var uri str = "/api/reader/media/"
                            uri = uri + bid
                            uri = uri + "/res_"
                            uri = uri + flat
                            entry = img_entry_json(zpath, uri, "")
                        }
                    }
                }
            }
            if img_n > 0 {
                images = images + ","
            }
            images = images + entry
            img_n = img_n + 1
        }
    }
    images = images + "]"
    // ── T-03 链接目标解析 ──
    // 自章链接/锚点表（旁路缓存）；内容相对 href 基准 = 自章所在 ZIP 目录
    // （非 OPF 目录——子目录书会产生错链，T-03 探针覆盖）。
    let lj str = epub_links_json(managed, opf_dir, hrefs, number)
    let self_href str = epub_href_at(hrefs, number)
    let self_dir str = opf_dir + epub_dir_of(self_href)
    var lres str = "["
    var ln2 int = 0
    var lpok bool = false
    var lparsed = null
    try {
        lparsed = json.parse(lj)
        lpok = true
    } catch {
        lpok = false
    }
    if lpok {
        let larr = lparsed.links
        for r in larr {
            let rh str = "" + r.href
            let rline int = r.line
            let rlbl str = "" + r.label
            // href 切分：资源部 + "#fragment"
            var res str = rh
            var frag str = ""
            let hp int = rh.find("#")
            if hp >= 0 {
                res = rh.substr(0, hp)
                frag = rh.substr(hp + 1, rh.len() - hp - 1)
            }
            var tch int = 0
            if res == "" {
                tch = number
            } else {
                let cand str = epub_zip_path(self_dir, res)
                if cand != "" {
                    // spine 全表精确匹配（zip 路径口径）
                    var idx int = 1
                    var g3 int = 0
                    while g3 < 4096 {
                        g3 = g3 + 1
                        let sp str = epub_href_at(hrefs, idx)
                        if sp == "" {
                            g3 = 4096
                        } else {
                            if opf_dir + sp == cand {
                                tch = idx
                                g3 = 4096
                            }
                        }
                        idx = idx + 1
                    }
                }
            }
            var tpara int = -1
            if tch > 0 {
                if frag != "" {
                    // fragment → 目标章 ids 表（自章直接查；他章旁路缓存）
                    var idsrc str = lj
                    if tch != number {
                        idsrc = epub_links_json(managed, opf_dir, hrefs, tch)
                    }
                    let idline int = json_ids_member(idsrc, frag)
                    if idline >= 0 {
                        tpara = idline
                    } else {
                        tch = 0
                        tpara = -1
                    }
                }
            }
            if ln2 > 0 {
                lres = lres + ","
            }
            var le str = "{\"line\":"
            le = le + rline.to_string()
            le = le + ",\"href\":\""
            le = le + json_escape(rh)
            le = le + "\",\"label\":\""
            le = le + json_escape(rlbl)
            le = le + "\",\"ch\":"
            le = le + tch.to_string()
            le = le + ",\"para\":"
            le = le + tpara.to_string()
            le = le + "}"
            lres = lres + le
            ln2 = ln2 + 1
        }
    }
    lres = lres + "]"
    return chap_json_full(number, title, t, t.len(), images, lres)
}

/// ids JSON 文本（{"k":int,...}）成员精确取值（键含引号定界——"fn1" 不碰
/// "fn10"）；缺失 -1。文本扫描避免对 map 动态键访问的双轨不确定面。
fn json_ids_member(objjson str, key str) int {
    let pat str = "\"" + key + "\":"
    let p int = objjson.find(pat)
    if p < 0 {
        return -1
    }
    let vs int = p + pat.len()
    var e int = vs
    while e < objjson.len() {
        let c str = objjson.substr(e, 1)
        if "0123456789".find(c) < 0 {
            break
        }
        e = e + 1
    }
    if e == vs {
        return -1
    }
    return objjson.substr(vs, e - vs).to_int()
}

/// titles（与 hrefs 同序 "|t1|t2|"）取第 n 个标题；空位回退 "第 N 章"。
pub fn epub_title_at(titles str, n int) str {
    let t str = epub_href_at(titles, n)
    if t == "" {
        var fallback str = "第 "
        fallback = fallback + n.to_string()
        fallback = fallback + " 章"
        return fallback
    }
    return t
}

fn chap_json_full(n int, title str, body str, wc int, images str, links str) str {
    var out str = "{\"number\":"
    out = out + n.to_string()
    out = out + ",\"title\":\""
    out = out + json_escape(title)
    out = out + "\",\"body\":\""
    out = out + json_escape(body)
    out = out + "\",\"word_count\":"
    out = out + wc.to_string()
    out = out + ",\"images\":"
    out = out + images
    out = out + ",\"links\":"
    out = out + links
    out = out + "}"
    return out
}

fn chap_json_with_images(n int, title str, body str, wc int, images str) str {
    return chap_json_full(n, title, body, wc, images, "[]")
}

fn chap_json(n int, title str, body str, wc int) str {
    return chap_json_with_images(n, title, body, wc, "[]")
}

/// 目录 JSON：[{"number":spine_idx,"title":label},...]（nav 顺序；
/// href 经 hrefs 定位 spine 序号）。
pub fn epub_toc_json(hrefs str, toc str) str {
    var out str = "["
    var pos int = 1
    var n int = 0
    var guard int = 0
    while guard < 4096 {
        guard = guard + 1
        // pos = 当前记录首字节（首管道之后）；s = 记录尾管道
        let s int = find_after(toc, "|", pos)
        if s < 0 {
            break
        }
        if s <= pos {
            pos = pos + 1
            continue
        }
        let rec str = toc.substr(pos, s - pos)
        pos = s + 1
        let sep int = rec.find("`")
        if sep > 0 {
            let href str = rec.substr(0, sep)
            let label str = rec.substr(sep + 1, rec.len() - sep - 1)
            var num int = 0
            var idx int = 1
            var g2 int = 0
            while g2 < 4096 {
                g2 = g2 + 1
                let h str = epub_href_at(hrefs, idx)
                if h == "" {
                    break
                }
                if h == href {
                    num = idx
                    g2 = 4096
                }
                idx = idx + 1
            }
            if num > 0 {
                if n > 0 {
                    out = out + ","
                }
                var ej str = "{\"number\":"
                ej = ej + num.to_string()
                ej = ej + ",\"title\":\""
                ej = ej + json_escape(label)
                ej = ej + "\"}"
                out = out + ej
                n = n + 1
            }
        }
    }
    out = out + "]"
    return out
}
