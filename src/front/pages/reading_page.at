// reading_page.at — "/book/:id/chapter/:ch" 沉浸式阅读页。
// 原模块名 reading：当前 CLI VM 轨下该名模块经 outlet 无法挂载（路由
// 更新、Init 不触发、零诊断输出；同形内容改名即恢复——r8 实测，登记
// 计划 §10 跨仓债务 N-r8-2，框架侧以最小复现排查）。
// PLAN-684 F-4：TOC 抽屉（容器内 absolute，非 fixed）+ 真实排版偏好
// （storage: br-font-size / br-line-height）+ 精简顶/底栏。
// NOTE: book + progress are stored as model fields (set in .Init), NOT
// multi-statement `computed` blocks — the vue codegen does not emit `return`
// for a block-bodied computed, so it would yield undefined.
// PLAN-043 走查修复（2026-09-24）：`use back.api` 直接导入 VM 轨不可解析
// ——章节/书目改 Http.get_json 拉（/api/chapters?book_id=&number= 与
// /api/books/:id(/chapters)，lazy back 随请求孵化）。
// READER-001 T-03：真实书模式——/book/<uuid>/chapter/<n>（id 为字符串）。
// 探测 /api/library/books/:id 命中即真实书：目录/章节/进度走 /api/library/*，
// 正文按段渲染。Phase 3（F-08/F-10）：点段保存携带顶层 para_text 内容
// 锚点（外层 JSON 传输零转义；后端与原文行逐字核对）；恢复以存储态
// para_text 与当前段落逐字验证，缺失/失配诚实提示。
// Phase 3（F-12→T-25）：正文列 scroll-pane（PLAN-656 controller）。恢复定
// 位自 Phase 7 起改 PLAN-781 子内容锚点（scroll-anchor + auto.scroll.to_child，
// 双轨同源 nearest 公式、真实布局定位）：每段带稳定子 key（p<idx>），恢复
// 时入队元素级定位，取代原「溢出滚动 + onscroll 字符占比估算」两段式——
// 估算对混排段失准（F-12），锚点按真实布局顶/底对齐入 pane。
// 逻辑内联于 handler（widget 内局部 fn 不支持——T-03 实测 parse error）；
// 纯计算下沉文件级 fn。/api/library/* 响应双层编码——统一经 parse_lib
// 二次解析（缺书/失败回 null，守卫跨 Vue/VM 双轨安全）。
// READER-002 阶段A（T-01/T-03/T-05）：全文搜索抽屉、注释/书签/高亮
// （对话框创建 quote=段文本可编辑+出现序，锚核验在服务端）、注释抽屉
// （回访跳转/删除/需重定位徽标/Markdown 导出）、排版偏好扩展
// （layout narrow|medium|wide + theme light|sepia|dark 随 reading 状态
// 持久化——SD-02 可选键，缺位=默认）。快捷键裁决（T-00）：无全局键盘
// handler，搜索 onenter / 对话框按钮 widget 级触发，不抢输入框/IME。
use store: BooksStore
use fmt: pct1
// READER-007 T-03：产品引擎表面宿主（vue 轨页面自身装载；VM 轨空实现——
// doc-surface 由组件 + surface-url 自动装载 native-host.html）。
use.web mountProductEngine from "src/front/ports/engine_host.at"

style page_btn = "inline-flex items-center gap-1 px-3 py-1.5 text-sm text-foreground hover:bg-accent rounded-lg transition-colors disabled:opacity-40"

/// 进度百分比（floor）。经 fn 形参计算——`as int` 套在 model 字段表达式上时
/// vue codegen 漏 `.value` 解包（生成 `chapter_num * 100` 而非
/// `chapter_num.value * 100`），fn 形参无此问题。
/// 除法自由环：vue 轨文件级 fn 形参不进 int 证明集，`/` 裸发射且 `as int`
/// 退化为 Number() 不截断（新 CLI 实测；后端 int 参数严格拒 float →
/// PUT progress 400）——floor(cur*100/total) 用纯整乘加比较环等价实现，
/// 双轨同义（codegen 债务登记计划 §10）。
fn pct_of(cur int, total int) int {
    if total <= 0 {
        return 0
    }
    if cur <= 0 {
        return 0
    }
    if cur >= total {
        return 100
    }
    var p int = 0
    while ((p + 1) * total <= cur * 100) {
        p = p + 1
    }
    return p
}

/// 段文本校验签名（Locator v1 兼容位）。
/// v1 = 字节长 + 行数（ASCII 输出）。内容证明自 Phase 3 起由 para_text
/// 承担（字符串相等，跨轨安全）；para_hash 仅作格式兼容位随 payload 发送。
fn para_hash(text str) str {
    let lines = text.split("
")
    return "sig1:" + text.len().to_string() + ":" + lines.len().to_string()
}

/// 正文 → 段落数组 [{idx, text, key, mark_n, mark_bad, kind, img_uri,
/// img_err}]（去空行；idx = 原行号；key = 稳定子锚点 key，scroll-anchor
/// 寻址用——pane 内唯一，跨章节同构）。READER-005 T-02：img: 行不再以
/// 标记文本呈现——kind="img"（uri 就绪）/ "imgerr"（诚实错误，拒绝码
/// 可见）/ "text"；段序号与行号口径不变（注释锚/Locator 兼容）。
/// READER-002：并入本章注释标记数 mark_n 与需重定位位 mark_bad
/// （quote 非空且在本段出现序不足 = bad——与后端核验同式，展示面诚实
/// 预判，终判在服务端）。入参全标量（anns_resp 为注释 GET 原文，csrc 为
/// 章 JSON 原文——images[]/links[] 单源，函数内解析——规避 List/struct 作
/// fn 参数的双轨缺陷面；参数名避开 model 同名——vue codegen 对同名参数
/// 误加 .value 致 undefined，T-03 实测）。
fn merge_marks(body str, anns_resp str, ch int, csrc str) List {
    let lines = body.split("\n")
    var out List = []
    var anns = json.parse("[]")
    if anns_resp != "" {
        if anns_resp.find("\"annotations\":[") >= 0 {
            var okp bool = false
            var wrap = null
            try {
                wrap = json.parse(anns_resp)
                okp = true
            } catch {
                okp = false
            }
            if okp {
                anns = wrap.annotations
            }
        }
    }
    // 章图身份表（后端 images[] 单源：{k,uri,err}）+ 链接表（后端已解析
    // 目标 ch/para；ch<=0 = 诚实拒绝面，T-03）
    var imgs = json.parse("[]")
    var larr2 = json.parse("[]")
    if csrc != "" {
        var need bool = false
        if csrc.find("\"images\":[") >= 0 {
            need = true
        }
        if csrc.find("\"links\":[") >= 0 {
            need = true
        }
        if need {
            var okc bool = false
            var cw = null
            try {
                cw = json.parse(csrc)
                okc = true
            } catch {
                okc = false
            }
            if okc {
                if cw.images != nil {
                    imgs = cw.images
                }
                if cw.links != nil {
                    larr2 = cw.links
                }
            }
        }
    }
    var i int = 0
    while i < lines.len() {
        let t str = ("" + lines[i]).trim()
        if t != "" {
            var n int = 0
            var bad int = 0
            for a in anns {
                let ach int = a.chapter_number
                if ach == ch {
                    let apx int = a.para_idx
                    if apx == i {
                        n = n + 1
                        let q str = "" + a.quote
                        if q != "" {
                            let occ int = a.occurrence
                            let live int = count_sub(t, q)
                            if live < occ {
                                bad = 1
                            }
                        }
                    }
                }
            }
            let k str = "p" + i.to_string()
            var kind str = "text"
            var img_uri str = ""
            var img_err str = ""
            if t.find("img:") == 0 {
                let zp str = t.substr(4, t.len() - 4)
                for g in imgs {
                    let gk str = "" + g.k
                    if gk == zp {
                        img_uri = "" + g.uri
                        img_err = "" + g.err
                    }
                }
                if img_uri != "" {
                    kind = "img"
                } else {
                    kind = "imgerr"
                }
            }
            // T-03：本行链接 chips（后端已解析目标）；lk_n 标量计数供
            // view 守卫（VM 轨模板对动态成员方法求值不可靠——实测回避）
            var lks List = []
            var lkn int = 0
            for lk in larr2 {
                let ll int = lk.line
                if ll == i {
                    lks.push({ lch: lk.ch, lpara: lk.para, lbl: ("" + lk.label) })
                    lkn = lkn + 1
                }
            }
            out.push({ idx: i, text: t, key: k, mark_n: n, mark_bad: bad, kind: kind, img_uri: img_uri, img_err: img_err, lks: lks, lk_n: lkn })
        }
        i = i + 1
    }
    return out
}

/// READER-002：注释集富化（抽屉渲染面）——注释 GET 原文 + 当前章正文
/// → [{annotation_id, kind, chapter_number, para_idx, quote, occurrence,
/// comment, bad}]。bad 仅对当前章核对（quote 出现序不足 = 需重定位；
/// 其他章未核 = 不显示徽标，不做未证断言）。入参全标量。
fn enrich_ann(ann_src str, body str, ch int) List {
    var out List = []
    if ann_src == "" {
        return out
    }
    if ann_src.find("\"annotations\":[") < 0 {
        return out
    }
    var okp bool = false
    var wrap = null
    try {
        wrap = json.parse(ann_src)
        okp = true
    } catch {
        okp = false
    }
    if !okp {
        return out
    }
    let lines = body.split("\n")
    let arr = wrap.annotations
    for a in arr {
        let aid str = "" + a.annotation_id
        let akind str = "" + a.kind
        let ach int = a.chapter_number
        let apx int = a.para_idx
        let q str = "" + a.quote
        let aocc int = a.occurrence
        let acm str = "" + a.comment
        var badv int = 0
        if ach == ch {
            if q != "" {
                if apx < lines.len() {
                    let ln str = ("" + lines[apx]).trim()
                    if count_sub(ln, q) < aocc {
                        badv = 1
                    }
                } else {
                    badv = 1
                }
            }
        }
        out.push({ annotation_id: aid, kind: akind, chapter_number: ach, para_idx: apx, quote: q, occurrence: aocc, comment: acm, bad: badv })
    }
    return out
}

/// /api/library/* 响应二次解析（双层编码）；缺书（""）或解析失败回 null。
fn parse_lib(text str) JsonValue? {
    var out JsonValue? = null
    if text != "" {
        let v = json.parse(text)
        if v != null {
            if v != "" {
                out = v
            }
        }
    }
    return out
}

/// Locator v1 保存载荷（纯 ASCII：uuid/整数/ph1 指纹——VM HTTP 请求体
/// 多字节损坏规避）。段文本指纹由调用方算好传入。
/// 参数名禁与 widget model 变量同名（vue codegen 会对同名参数误加
/// .value 致 undefined——T-03 实测），故用 rid。
/// READER-002：layout/theme 为可选枚举（SD-02）；缺省串为空时不写键
/// （旧存储形态兼容，后端按缺位处理）。
fn real_payload(rid str, ch int, para int, ph str, font str, line str, lay str, thm str) str {
    var payload str = "{\"book_id\":\""
    payload = payload + rid
    payload = payload + "\",\"chapter_number\":"
    payload = payload + ch.to_string()
    payload = payload + ",\"paragraph_index\":"
    payload = payload + para.to_string()
    payload = payload + ",\"para_hash\":\""
    payload = payload + ph
    payload = payload + "\",\"font_size\":\""
    payload = payload + font
    payload = payload + "\",\"line_height\":\""
    payload = payload + line
    payload = payload + "\""
    if lay != "" {
        payload = payload + ",\"layout\":\""
        payload = payload + lay
        payload = payload + "\""
    }
    if thm != "" {
        payload = payload + ",\"theme\":\""
        payload = payload + thm
        payload = payload + "\""
    }
    payload = payload + ",\"updated_at\":0}"
    return payload
}

fn fill_pref(cur str, key str, def str) str {
    if cur != def {
        return cur
    }
    let v = storage.get(key)
    if v != nil {
        if v != "" {
            return v
        }
    }
    return cur
}

fn body_style_of(font str, line str) str {
    var size_cls str = "text-base"
    if font == "small" {
        size_cls = "text-sm"
    }
    if font == "large" {
        size_cls = "text-lg"
    }
    var lead_cls str = "leading-relaxed"
    if line == "compact" {
        lead_cls = "leading-snug"
    }
    return "text-foreground " + size_cls + " " + lead_cls
}

/// READER-002：阅读列宽（宽窄布局）。缺省 medium=max-w-2xl（001 原状）。
fn layout_cls_of(ly str) str {
    if ly == "narrow" {
        return "max-w-xl"
    }
    if ly == "wide" {
        return "max-w-4xl"
    }
    return "max-w-2xl"
}

/// READER-002：阅读主题（亮/米/暗）。作用于正文容器底色与文字色；
/// 页框（顶/底栏）保持应用主题——本地阅读偏好只覆盖沉浸面。
fn theme_body_of(th str) str {
    if th == "sepia" {
        return "bg-[#f4ecd8] text-[#5b4636]"
    }
    if th == "dark" {
        return "bg-[#1f2430] text-[#d6dae2]"
    }
    return "bg-background text-foreground"
}

/// 主题下段落悬停/标记的次级样式（与 theme_body_of 同枚举）。
fn theme_hover_of(th str) str {
    if th == "sepia" {
        return "hover:bg-[#eadfbd]"
    }
    if th == "dark" {
        return "hover:bg-[#2a3140]"
    }
    return "hover:bg-muted"
}

fn theme_marked_of(th str) str {
    if th == "sepia" {
        return "bg-[#eadfbd]"
    }
    if th == "dark" {
        return "bg-[#2a3140]"
    }
    return "bg-primary/10"
}

/// 段内出现计数（重叠口径，与后端 count_occurrences 同式——UI 侧
/// 「第 N 处」候选与锚点预判；终判在服务端）。
/// 段内出现计数（重叠口径，与后端 count_occurrences 同式——滑窗
/// substr 逐位比较，find 偏移不喂 substr，多字节口径错位防御）。
fn count_sub(hay str, needle str) int {
    if needle == "" {
        return 0
    }
    let hl int = hay.len()
    let nl int = needle.len()
    if nl > hl {
        return 0
    }
    var count int = 0
    var i int = 0
    while i + nl <= hl {
        if hay.substr(i, nl) == needle {
            count = count + 1
        }
        i = i + 1
    }
    return count
}
/// 标签输入消毒 + 规范 JSON 数组（"a, b" → ["a","b"]；空 → "[]"）。
/// 引号/反斜杠剥除（防 JSON 注入——服务端词法门兜底拒绝）。
fn tags_json_of(input str) str {
    let parts = input.split(",")
    var out str = "["
    var n int = 0
    while n < parts.len() {
        let raw str = ("" + parts[n]).trim()
        if raw != "" {
            let s str = raw.replace("\"", "").replace("\\", "")
            if s != "" {
                if n > 0 {
                    if out.len() > 1 {
                        out = out + ","
                    }
                }
                out = out + "\""
                out = out + s
                out = out + "\""
            }
        }
        n = n + 1
    }
    out = out + "]"
    return out
}

widget reading_page {
    msg { Init, Back, PrevChapter, NextChapter, ToggleToc, SelectChapter(int), TapParagraph(int), ToggleSearch, DoSearch, ToggleAnns, ToggleStyle, SetLayout(str), SetTheme(str), JumpTo(int, int), JumpLink(int, int), SearchInput(str), QuoteInput(str), OccInput(str), CommentInput(str), TagsInput(str), AnnDelete(str), OpenAnnDialog(int), AnnKind(str), AnnSubmit, AnnCancel, DoExport, NoOp, SetFontSize(str), SetFlow(str), SelAnnotate, AnnRevisit(str) }

    model {
        var book_id int = 0
        var route_id str = ""
        var is_real bool = false
        // READER-007 T-03：正式 EPUB 引擎表面（doc-surface 装载 URL/状态；
        // 非 EPUB 真实书保持既有 scroll-pane 文本行形态）
        var is_epub bool = false
        var surface_url str = ""
        var engine_note str = ""
        var chapter_num int = 1
        var chapter = { book_id: 0, number: 1, title: "", body: "", word_count: 0 }
        // 章 JSON 原文（images[]/links[] 单源输入——注释变更后重建段落复用）
        var chapter_src str = ""
        var chapters List = []
        var chapter_count int = 1
        var progress_pct int = 0
        var loaded bool = false
        var show_toc bool = false
        var font_size str = "medium"
        var line_height str = "comfy"
        var body_style str = "text-foreground text-base leading-relaxed"
        var progress_label str = "0.0%"
        // 真实书模式
        var paragraphs List = []
        var cur_paragraph int = -1
        var cur_para_text str = ""
        var restored_note str = ""
        // T-25 恢复定位：scroll-pane controller 锚柄（scroll_to_child 寻址）
        var rsc str = "reading-pane"
        // ── READER-002 A：排版偏好扩展（SD-02 可选键；缺省=001 原状）──
        var layout str = "medium"
        var theme str = "light"
        // auto-os/PLAN-059 T-03：Init 装载到显式主题（reading-state）时置真；
        // 无显式选择时引擎默认随应用模式（本页保留名 dark_mode 位，运行时
        // 种子链与宿主策略同源驱动），显式值始终优先。
        var theme_explicit bool = false
        // auto-os/PLAN-059 T-03：本页模式位（保留名；vue 轨由 458 种子链
        // 按窗引导播种，VM 轨并入统一状态与壳根同字段）。
        var dark_mode bool = false
        // ── 搜索（T-01）──
        var show_search bool = false
        var search_q str = ""
        var search_results List = []
        var search_note str = ""
        var search_total int = 0
        // ── 注释（T-03）──
        var show_anns bool = false
        var anns List = []
        var ann_marks List = []   // [{ch, pi, n, bad}] 当前章标记/需重定位
        var ann_note str = ""     // 抽屉级提示（导出/错误）
        // ── 注释对话框（创建/编辑）──
        var ann_dialog bool = false
        var ann_edit_id str = ""  // ""=新建；非空=编辑该 id
        var ann_kind str = "highlight"
        var ann_ch int = 0
        var ann_pi int = -1
        var ann_quote str = ""
        var ann_occ_str str = "1"
        var ann_comment str = ""
        var ann_tags str = ""
        var ann_dlg_note str = ""
        // ── 排版抽屉 ──
        var show_style bool = false
        // ── 派生样式（handlers 经文件级 fn 赋值——view 不做逻辑）──
        var theme_body_cls str = "bg-background text-foreground"
        var theme_hover_cls str = "hover:bg-muted"
        var theme_marked_cls str = "bg-primary/10"
        var layout_col_cls str = "max-w-2xl"
        var para_marked_cls str = "bg-primary/10 border-primary para-marked"
        var para_idle_cls str = "border-transparent hover:bg-muted"
        var ann_dlg_title str = "添加注释"
        // 注释 GET 原文（merge_marks/enrichment 共同标量输入）
        var ann_resp str = ""
        // READER-007 T-04：引擎表面会话 id（发 goto/settings/flow 命令用）
        var epub_sid str = ""
        // READER-007 T-06：引擎选区批注面——待保存 canonical locator
        //（annotations-v2 locator_json 直传）与选区工具状态文本
        var ann_locator str = ""
        var sel_note str = ""
        // READER-007 T-04：引擎表面流模式（分页/滚动；显示用）
        var epub_flow str = "paged"
    }

    view {
        col {
            style: "h-full min-h-screen bg-background relative overflow-hidden"

            // Top bar: back / chapter title / TOC toggle
            row {
                style: "h-14 border-b border-border bg-card items-center px-4 gap-3 shrink-0"
                button {
                    onclick: .Back
                    style: "p-2 hover:bg-accent rounded-lg transition-colors shrink-0"
                    text "←" { style: "text-lg text-foreground" }
                }
                if .loaded {
                    text .chapter.title { style: "font-medium text-foreground flex-1 truncate" }
                } else {
                    text "Loading…" { style: "font-medium text-muted-foreground flex-1 truncate" }
                }
                button {
                    onclick: .ToggleSearch
                    style: "px-3 py-1.5 text-sm text-foreground hover:bg-accent rounded-lg transition-colors shrink-0"
                    text "🔍 搜索" {}
                }
                button {
                    onclick: .ToggleAnns
                    style: "px-3 py-1.5 text-sm text-foreground hover:bg-accent rounded-lg transition-colors shrink-0"
                    text "✎ 注释" {}
                }
                button {
                    onclick: .ToggleStyle
                    style: "px-3 py-1.5 text-sm text-foreground hover:bg-accent rounded-lg transition-colors shrink-0"
                    text "Aa" {}
                }
                button {
                    onclick: .ToggleToc
                    style: "px-3 py-1.5 text-sm text-foreground hover:bg-accent rounded-lg transition-colors shrink-0"
                    text "☰ Contents" {}
                }
            }

            // Body: TOC drawer + search/annotations/style drawers + reading column
            row {
                style: "flex-1 min-h-0 items-stretch relative overflow-hidden"
                // TOC drawer — absolute 贴容器左，关闭时不占位
                if .show_toc {
                    col {
                        style: "absolute inset-y-0 left-0 z-30 w-64 border-r border-border bg-card p-3 gap-1 overflow-y-auto shadow-lg"
                        text "Contents" { style: "text-xs font-semibold text-muted-foreground uppercase tracking-wide px-2 py-1 shrink-0" }
                        for ch in .chapters {
                            row {
                                onclick: .SelectChapter(ch.number)
                                style: ["items-center gap-2 px-2 py-2 rounded-lg cursor-pointer transition-colors",
                                    if ch.number == .chapter_num {
                                        "bg-primary/15 text-foreground"
                                    } else {
                                        "hover:bg-accent text-foreground"
                                    }]
                                text f"${ch.number}" { style: "text-xs font-mono text-muted-foreground w-6 shrink-0" }
                                text ch.title { style: "text-sm truncate flex-1" }
                            }
                        }
                    }
                }
                // 搜索抽屉（READER-002 T-01）— absolute 贴容器右
                if .show_search {
                    col {
                        style: "absolute inset-y-0 right-0 z-30 w-80 border-l border-border bg-card p-3 gap-2 overflow-y-auto shadow-lg"
                        text "本书内搜索" { style: "text-xs font-semibold text-muted-foreground uppercase tracking-wide px-2 py-1 shrink-0" }
                        input {
                            value: .search_q
                            oninput: .SearchInput
                            onenter: .DoSearch
                            placeholder: "输入关键词（精确子串）"
                            style: "w-full px-3 py-2 bg-background border border-border rounded-lg text-sm text-foreground outline-none focus:border-primary"
                        }
                        button {
                            onclick: .DoSearch
                            style: "px-3 py-1.5 text-sm bg-primary text-primary-foreground rounded-lg hover:bg-primary/90 transition-colors"
                            text "搜索" {}
                        }
                        if .search_note != "" {
                            text .search_note { style: "text-xs text-muted-foreground px-2" }
                        }
                        for r in .search_results {
                            col {
                                onclick: .JumpTo(r.chapter_number, r.para_idx)
                                style: "items-start gap-1 px-2 py-2 rounded-lg cursor-pointer hover:bg-accent transition-colors"
                                text f"第 ${r.chapter_number} 章 · ¶${r.para_idx}" { style: "text-xs text-muted-foreground font-mono" }
                                text r.para_text { style: "text-sm text-foreground truncate w-full" }
                            }
                        }
                        if .search_total > 0 {
                            text f"共 ${.search_total} 处（点击跳转）" { style: "text-xs text-muted-foreground px-2 py-1" }
                        }
                    }
                }
                // 注释抽屉（READER-002 T-03/T-05）— absolute 贴容器右
                if .show_anns {
                    col {
                        style: "absolute inset-y-0 right-0 z-30 w-80 border-l border-border bg-card p-3 gap-2 overflow-y-auto shadow-lg"
                        text "注释与书签" { style: "text-xs font-semibold text-muted-foreground uppercase tracking-wide px-2 py-1 shrink-0" }
                        if .ann_note != "" {
                            text .ann_note { style: "text-xs text-muted-foreground px-2" }
                        }
                        if .anns.len() == 0 {
                            text "（暂无注释——点击段落后再点「＋ 注释」创建）" { style: "text-sm text-muted-foreground px-2 py-2" }
                        } else {
                            for a in .anns {
                                col {
                                    style: "items-start gap-1 px-2 py-2 rounded-lg border border-border/60"
                                    row {
                                        onclick: .JumpTo(a.chapter_number, a.para_idx)
                                        style: "items-center gap-2 cursor-pointer w-full"
                                        text a.kind { style: "text-xs font-mono text-primary shrink-0" }
                                        text f"第 ${a.chapter_number} 章 · ¶${a.para_idx}" { style: "text-xs text-muted-foreground font-mono flex-1" }
                                        if a.bad == 1 {
                                            text "需重定位" { style: "text-xs text-destructive shrink-0" }
                                        }
                                    }
                                    if a.quote != "" {
                                        text a.quote { style: "text-sm text-foreground truncate w-full" }
                                    }
                                    if a.comment != "" {
                                        text a.comment { style: "text-xs text-muted-foreground truncate w-full" }
                                    }
                                    row {
                                        style: "gap-2"
                                        button {
                                            onclick: .AnnEdit(a.annotation_id)
                                            style: "px-2 py-1 text-xs text-foreground hover:bg-accent rounded transition-colors"
                                            text "编辑" {}
                                        }
                                        button {
                                            onclick: .AnnDelete(a.annotation_id)
                                            style: "px-2 py-1 text-xs text-destructive hover:bg-destructive/10 rounded transition-colors"
                                            text "删除" {}
                                        }
                                        button {
                                            onclick: .AnnRevisit(a.annotation_id)
                                            style: "px-2 py-1 text-xs text-primary hover:bg-accent rounded transition-colors"
                                            text "回访" {}
                                        }
                                    }
                                }
                            }
                        }
                        button {
                            onclick: .DoExport
                            style: "px-3 py-1.5 text-sm bg-primary text-primary-foreground rounded-lg hover:bg-primary/90 transition-colors shrink-0"
                            text "导出 Markdown" {}
                        }
                    }
                }
                // 排版抽屉（READER-002 T-01）— absolute 贴容器右
                if .show_style {
                    col {
                        style: "absolute inset-y-0 right-0 z-30 w-64 border-l border-border bg-card p-3 gap-3 overflow-y-auto shadow-lg"
                        text "排版" { style: "text-xs font-semibold text-muted-foreground uppercase tracking-wide px-2 py-1 shrink-0" }
                        text "栏宽" { style: "text-sm text-foreground px-2" }
                        row {
                            style: "gap-2 px-2"
                            button {
                                onclick: .SetLayout("narrow")
                                style: ["px-3 py-1.5 text-sm rounded-lg transition-colors",
                                    if .layout == "narrow" {
                                        "bg-primary text-primary-foreground"
                                    } else {
                                        "text-foreground hover:bg-accent"
                                    }]
                                text "窄" {}
                            }
                            button {
                                onclick: .SetLayout("medium")
                                style: ["px-3 py-1.5 text-sm rounded-lg transition-colors",
                                    if .layout == "medium" {
                                        "bg-primary text-primary-foreground"
                                    } else {
                                        "text-foreground hover:bg-accent"
                                    }]
                                text "中" {}
                            }
                            button {
                                onclick: .SetLayout("wide")
                                style: ["px-3 py-1.5 text-sm rounded-lg transition-colors",
                                    if .layout == "wide" {
                                        "bg-primary text-primary-foreground"
                                    } else {
                                        "text-foreground hover:bg-accent"
                                    }]
                                text "宽" {}
                            }
                        }
                        text "阅读主题" { style: "text-sm text-foreground px-2" }
                        row {
                            style: "gap-2 px-2"
                            button {
                                onclick: .SetTheme("light")
                                style: ["px-3 py-1.5 text-sm rounded-lg transition-colors",
                                    if .theme == "light" {
                                        "bg-primary text-primary-foreground"
                                    } else {
                                        "text-foreground hover:bg-accent"
                                    }]
                                text "亮" {}
                            }
                            button {
                                onclick: .SetTheme("sepia")
                                style: ["px-3 py-1.5 text-sm rounded-lg transition-colors",
                                    if .theme == "sepia" {
                                        "bg-primary text-primary-foreground"
                                    } else {
                                        "text-foreground hover:bg-accent"
                                    }]
                                text "米" {}
                            }
                            button {
                                onclick: .SetTheme("dark")
                                style: ["px-3 py-1.5 text-sm rounded-lg transition-colors",
                                    if .theme == "dark" {
                                        "bg-primary text-primary-foreground"
                                    } else {
                                        "text-foreground hover:bg-accent"
                                    }]
                                text "暗" {}
                            }
                        }
                        text "字号与行距沿顶栏书内偏好（保存于阅读状态）" { style: "text-xs text-muted-foreground px-2" }
                        if .is_epub {
                            text "字号" { style: "text-sm text-foreground px-2" }
                            row {
                                style: "gap-2 px-2"
                                button {
                                    onclick: .SetFontSize("small")
                                    style: ["px-3 py-1.5 text-sm rounded-lg transition-colors",
                                        if .font_size == "small" {
                                            "bg-primary text-primary-foreground"
                                        } else {
                                            "text-foreground hover:bg-accent"
                                        }]
                                    text "小" {}
                                }
                                button {
                                    onclick: .SetFontSize("medium")
                                    style: ["px-3 py-1.5 text-sm rounded-lg transition-colors",
                                        if .font_size == "medium" {
                                            "bg-primary text-primary-foreground"
                                        } else {
                                            "text-foreground hover:bg-accent"
                                        }]
                                    text "中" {}
                                }
                                button {
                                    onclick: .SetFontSize("large")
                                    style: ["px-3 py-1.5 text-sm rounded-lg transition-colors",
                                        if .font_size == "large" {
                                            "bg-primary text-primary-foreground"
                                        } else {
                                            "text-foreground hover:bg-accent"
                                        }]
                                    text "大" {}
                                }
                            }
                            text "版面" { style: "text-sm text-foreground px-2" }
                            row {
                                style: "gap-2 px-2"
                                button {
                                    onclick: .SetFlow("paged")
                                    style: ["px-3 py-1.5 text-sm rounded-lg transition-colors",
                                        if .epub_flow == "paged" {
                                            "bg-primary text-primary-foreground"
                                        } else {
                                            "text-foreground hover:bg-accent"
                                        }]
                                    text "分页" {}
                                }
                                button {
                                    onclick: .SetFlow("scrolled")
                                    style: ["px-3 py-1.5 text-sm rounded-lg transition-colors",
                                        if .epub_flow == "scrolled" {
                                            "bg-primary text-primary-foreground"
                                        } else {
                                            "text-foreground hover:bg-accent"
                                        }]
                                    text "滚动" {}
                                }
                            }
                        }
                    }
                }
                // Reading column — READER-007 T-03：EPUB 走 doc-surface 引擎
                // 表面（VM 原生 WebView2 / vue 宿主容器，正文结构/图/脚注由
                // 引擎渲染）；TXT/MD 保持既有 scroll-pane 文本行形态
                // （scroll-pane controller + 段落锚点回退语义）。引擎表面
                // 装载失败时诚实提示，不回退冒充纯文本成功。
                if .is_epub {
                    if .loaded {
                        col {
                            style: "flex-1 min-h-0 w-full relative"
                            row {
                                style: "items-center gap-2 pb-2"
                                button {
                                    onclick: .SelAnnotate
                                    style: "px-3 py-1.5 text-sm bg-primary text-primary-foreground rounded-lg hover:bg-primary/90 transition-colors"
                                    text "批注所选" {}
                                }
                                if .sel_note != "" {
                                    text .sel_note { style: "text-xs text-muted-foreground" }
                                }
                            }
                            if .surface_url != "" {
                                doc-surface (url: .surface_url, height: 640) {
                                    style: "w-full h-full border border-border rounded-md bg-white overflow-hidden"
                                }
                            } else {
                                col {
                                    style: "items-center justify-center py-20 text-muted-foreground gap-2"
                                    text "引擎表面不可用" { style: "text-sm text-foreground" }
                                    if .engine_note != "" {
                                        text .engine_note { style: "text-xs text-muted-foreground" }
                                    }
                                }
                            }
                        }
                    } else {
                        col {
                            style: "items-center justify-center py-20 text-muted-foreground"
                            text "Loading…" {}
                        }
                    }
                }
                }
                if !.is_epub {
                // Reading column — T-25：scroll-pane（PLAN-656 controller）；
                // 恢复定位由段落 scroll-anchor + scroll_to_child 入队完成。
                // READER-002：栏宽/主题由本地排版偏好承载（沉浸面）。
                // 注：EPUB 走上方 doc-surface 分支（互斥 if——vue codegen 对
                // `} else {` 借用原块闭合会生成无条件渲染的 else div，T-03
                // 遗留；双 if 语义等价且双轨同源）。
                scroll-pane (controller: .rsc, style: ["flex-1 min-h-0 w-full", .theme_body_cls]) {
                    if .loaded {
                        col {
                            style: [.layout_col_cls, "mx-auto px-6 py-10 gap-6"]
                            h1 .chapter.title { style: "text-2xl font-bold text-foreground" }
                            if .is_real {
                                if .restored_note != "" {
                                    col {
                                        style: "px-4 py-2 rounded-lg bg-primary/10 text-sm text-foreground"
                                        text .restored_note {}
                                    }
                                }
                                if .paragraphs.len() == 0 {
                                    text "（本章无内容）" { style: .body_style }
                                } else {
                                    for p in .paragraphs {
                                        col {
                                            scroll-anchor: p.key
                                            style: "items-stretch gap-0"
                                            col {
                                                onclick: .TapParagraph(p.idx)
                                                // 当前段标记类：字面量嵌套三元栅格
                                                //（style 三元分支只吃字符串字面量
                                                //——model 引用分支被 vue codegen
                                                //静默发空串，T-03 实测；语义与
                                                //para_marked_cls/para_idle_cls 逐字等价）
                                                style: ["px-3 py-2 rounded-lg cursor-pointer transition-colors border-l-4",
                                                    if p.idx == .cur_paragraph {
                                                        if .theme == "sepia" {
                                                            "bg-[#eadfbd] border-primary para-marked"
                                                        } else {
                                                            if .theme == "dark" {
                                                                "bg-[#2a3140] border-primary para-marked"
                                                            } else {
                                                                "bg-primary/10 border-primary para-marked"
                                                            }
                                                        }
                                                    } else {
                                                        if .theme == "sepia" {
                                                            "border-transparent hover:bg-[#eadfbd]"
                                                        } else {
                                                            if .theme == "dark" {
                                                                "border-transparent hover:bg-[#2a3140]"
                                                            } else {
                                                                "border-transparent hover:bg-muted"
                                                            }
                                                        }
                                                    }]
                                                row {
                                                    style: "items-center gap-2"
                                                    text f"¶${p.idx}" { style: "text-xs text-muted-foreground/60 font-mono shrink-0" }
                                                    if p.mark_n > 0 {
                                                        text f"✎ ${p.mark_n}" { style: "text-xs text-primary font-mono shrink-0" }
                                                    }
                                                    if p.mark_bad > 0 {
                                                        text "需重定位" { style: "text-xs text-destructive shrink-0" }
                                                    }
                                                }
                                                // T-02 三态正卫栅格：图片就绪 /
                                                // 诚实错误（拒绝码+路径可见）/
                                                // 正文文本。点段=记位置行为不变。
                                                if p.kind == "img" {
                                                    image (src: p.img_uri, alt: "插图", fit: "contain") {
                                                        style: "max-w-full rounded-lg border border-border my-2"
                                                    }
                                                }
                                                if p.kind == "imgerr" {
                                                    col {
                                                        style: "items-start gap-1 my-2 px-3 py-2 rounded-lg bg-destructive/10 border border-destructive/40"
                                                        text "⚠ 插图不可用" { style: "text-sm text-destructive" }
                                                        text p.img_err { style: "text-xs text-destructive/80 font-mono" }
                                                        text p.text { style: "text-xs text-muted-foreground/60 font-mono" }
                                                    }
                                                }
                                                if p.kind == "text" {
                                                    text p.text { style: .body_style }
                                                }
                                            }
                                            // T-03：链接 chips（可点击 col 之外的
                                            // 兄弟面——不冒泡触发 TapParagraph；
                                            // 无效目标点击给诚实提示不跳转）
                                            if p.lk_n > 0 {
                                                row {
                                                    style: "flex-wrap gap-1 px-3 py-1"
                                                    for lk in p.lks {
                                                        button {
                                                            onclick: .JumpLink(lk.lch, lk.lpara)
                                                            style: "px-2 py-0.5 text-xs bg-primary/10 text-primary rounded border border-primary/30 hover:bg-primary/20 transition-colors"
                                                            text f"↗ ${lk.lbl}" {}
                                                        }
                                                    }
                                                }
                                            }
                                            // 当前段注释动作行（＋ 注释入口；
                                            // 不改变点段=记位置的既有行为）
                                            if p.idx == .cur_paragraph {
                                                if .is_real {
                                                    row {
                                                        style: "gap-2 px-3 py-1"
                                                        button {
                                                            onclick: .OpenAnnDialog(p.idx)
                                                            style: "px-2 py-1 text-xs bg-primary/10 text-primary rounded hover:bg-primary/20 transition-colors"
                                                            text "＋ 注释/书签" {}
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            } else {
                                text .chapter.body { style: .body_style }
                            }
                        }
                    } else {
                        col {
                            style: "items-center justify-center py-20 text-muted-foreground"
                            text "Loading…" {}
                        }
                    }
                }
            }

            // 注释对话框（READER-002 T-03）——底部浮层；quote/occurrence/
            // comment/tags 直传顶层字段（多字节安全），锚核验在服务端。
            if .ann_dialog {
                col {
                    style: "absolute inset-x-0 bottom-0 z-40 bg-card border-t border-border p-4 gap-2 shadow-2xl max-h-[60%] overflow-y-auto"
                    row {
                        style: "items-center gap-2"
                        text .ann_dlg_title { style: "text-sm font-semibold text-foreground flex-1" }
                        button {
                            onclick: .AnnCancel
                            style: "px-2 py-1 text-sm text-muted-foreground hover:bg-accent rounded transition-colors"
                            text "✕" {}
                        }
                    }
                    row {
                        style: "gap-2"
                        button {
                            onclick: .AnnKind("highlight")
                            style: ["px-3 py-1.5 text-sm rounded-lg transition-colors",
                                if .ann_kind == "highlight" {
                                    "bg-primary text-primary-foreground"
                                } else {
                                    "text-foreground hover:bg-accent"
                                }]
                            text "高亮" {}
                        }
                        button {
                            onclick: .AnnKind("comment")
                            style: ["px-3 py-1.5 text-sm rounded-lg transition-colors",
                                if .ann_kind == "comment" {
                                    "bg-primary text-primary-foreground"
                                } else {
                                    "text-foreground hover:bg-accent"
                                }]
                            text "注释" {}
                        }
                        button {
                            onclick: .AnnKind("bookmark")
                            style: ["px-3 py-1.5 text-sm rounded-lg transition-colors",
                                if .ann_kind == "bookmark" {
                                    "bg-primary text-primary-foreground"
                                } else {
                                    "text-foreground hover:bg-accent"
                                }]
                            text "书签" {}
                        }
                    }
                    text "摘录（逐字锚；可截取子串）" { style: "text-xs text-muted-foreground" }
                    input {
                        value: .ann_quote
                        oninput: .QuoteInput
                        placeholder: "摘录原文"
                        style: "w-full px-3 py-2 bg-background border border-border rounded-lg text-sm text-foreground outline-none focus:border-primary"
                    }
                    row {
                        style: "gap-2 items-center"
                        text "第" { style: "text-sm text-foreground" }
                        input {
                            value: .ann_occ_str
                            oninput: .OccInput
                            style: "w-16 px-2 py-1.5 bg-background border border-border rounded-lg text-sm text-foreground outline-none focus:border-primary"
                        }
                        text "处（同段重复句序号）" { style: "text-xs text-muted-foreground" }
                    }
                    text "批注" { style: "text-xs text-muted-foreground" }
                    textarea {
                        value: .ann_comment
                        oninput: .CommentInput
                        height: 64
                        placeholder: "写点什么（可空）"
                        style: "w-full px-3 py-2 bg-background border border-border rounded-lg text-sm text-foreground outline-none focus:border-primary"
                    }
                    text "标签（逗号分隔）" { style: "text-xs text-muted-foreground" }
                    input {
                        value: .ann_tags
                        oninput: .TagsInput
                        placeholder: "例：重点, 待查"
                        style: "w-full px-3 py-2 bg-background border border-border rounded-lg text-sm text-foreground outline-none focus:border-primary"
                    }
                    if .ann_dlg_note != "" {
                        text .ann_dlg_note { style: "text-xs text-destructive" }
                    }
                    button {
                        onclick: .AnnSubmit
                        style: "px-4 py-2 text-sm bg-primary text-primary-foreground rounded-lg hover:bg-primary/90 transition-colors"
                        text "保存注释" {}
                    }
                }
            }

            // Bottom bar: prev / progress / next
            row {
                style: "h-14 border-t border-border bg-card items-center px-4 gap-4 shrink-0"
                button {
                    onclick: .PrevChapter
                    style: page_btn
                    disabled: .chapter_num <= 1
                    text "← Prev" {}
                }
                col {
                    style: "flex-1 gap-1"
                    progress {
                        value: .progress_pct
                        max: 100
                        style: "w-full"
                    }
                    row {
                        style: "justify-between text-xs text-muted-foreground"
                        text f"Chapter ${.chapter_num} of ${.chapter_count}" {}
                        text .progress_label {}
                    }
                }
                button {
                    onclick: .NextChapter
                    style: page_btn
                    disabled: .chapter_num >= .chapter_count
                    text "Next →" {}
                }
            }
        }
    }

    on {
        .Init -> {
            // Route params are strings — coerce to int so arithmetic like
            // .chapter_num + 1 doesn't do string concat ("1" + 1 = "11").
            .route_id = router.param("id")
            .book_id = router.param("id").to_int()
            .chapter_num = router.param("ch").to_int()
            // 真实书探测：/api/library/books/:id 命中（book_id 非空）即真实书
            let probe = parse_lib(Http.get_json("/api/library/books/" + .route_id))
            if probe != null {
                let pb str = "" + probe.book_id
                if pb != "" {
                    if pb != "undefined" {
                        .is_real = true
                    }
                }
                // READER-007 T-03：format 字段区分 EPUB（引擎表面）与
                // TXT/MD（既有 scroll-pane 文本行）；缺省/未知格式不启用
                // 引擎表面（诚实回退，不冒充 EPUB 已支持）。
                var pfmt str = ""
                try {
                    pfmt = "" + probe.format
                } catch {
                    pfmt = ""
                }
                if pfmt == "epub" {
                    .is_epub = true
                }
            }
            if .is_real {
                // F-05 修复：章节号一律以路由为准（显式入口不被旧状态
                // 覆盖）；旧状态只提供排版设置与段级恢复判定。
                // var 而非 let：F-14 身份守卫在 book_id 失配时重赋 null
                //（VM 轨编译器强制 let 不可变——重赋使整个 Init 编译失败
                // 且被静默丢弃，即 N-r8-2 根因；诊断面修复后现形）
                var pr = parse_lib(Http.get_json("/api/library/progress?book_id=" + .route_id))
                // T-25：本页待恢复目标段（行号），锚点入队后即消费
                var restore_target int = -1
                if pr != null {
                    let pf str = "" + pr.font_size
                    if pf != "" {
                        .font_size = pf
                    }
                    let lh str = "" + pr.line_height
                    if lh != "" {
                        .line_height = lh
                    }
                    // READER-002 A：可选排版偏好（缺位 = 默认；枚举外忽略）
                    var ly str = ""
                    try {
                        ly = "" + pr.layout
                    } catch {
                        ly = ""
                    }
                    if ly == "narrow" {
                        .layout = "narrow"
                    }
                    if ly == "wide" {
                        .layout = "wide"
                    }
                    if ly == "medium" {
                        .layout = "medium"
                    }
                    var th str = ""
                    try {
                        th = "" + pr.theme
                    } catch {
                        th = ""
                    }
                    if th == "sepia" {
                        .theme = "sepia"
                    }
                    if th == "dark" {
                        .theme = "dark"
                    }
                    if th == "light" {
                        .theme = "light"
                    }
                    // auto-os/PLAN-059 T-03：书内显式主题（含显式 light）优先
                    // 于模式派生——有值即标记，末段派生分支跳过。
                    if th != "" {
                        .theme_explicit = true
                    }
                }
                let toc = parse_lib(Http.get_json("/api/library/books/" + .route_id + "/toc"))
                if toc != null {
                    .chapters = toc
                    .chapter_count = toc.len()
                }
                if .chapter_count < 1 {
                    .chapter_count = 1
                }
                if .chapter_num < 1 {
                    .chapter_num = 1
                }
                if .chapter_num > .chapter_count {
                    .chapter_num = .chapter_count
                }
                router.push("/book/" + .route_id + "/chapter/" + .chapter_num.to_string())
                let craw str = Http.get_json("/api/library/chapter?book_id=" + .route_id + "&number=" + .chapter_num.to_string())
                let chv = parse_lib(craw)
                if chv != null {
                    .chapter = chv
                }
                .chapter_src = craw
                // READER-002 注释装载规范序列（变更/换章后同式）
                .ann_resp = Http.get_json("/api/library/annotations?book_id=" + .route_id)
                .anns = enrich_ann(.ann_resp, "" + .chapter.body, .chapter_num)
                .paragraphs = merge_marks("" + .chapter.body, .ann_resp, .chapter_num, craw)
                .cur_paragraph = -1
                .cur_para_text = ""
                // 恢复段标记：仅当保存章节 == 当前章节；内容锚点逐字验证
                // （Phase 3 F-08）——存储态 para_text 与当前段落文本相等才
                // 标记「已恢复」；缺锚点（旧 sig1 态）/失配/越界分别诚实
                // 提示，绝不假恢复
                if pr != null {
                    // F-14 前端身份守卫：存储态 book_id 必须与路由一致
                    var pr_bid str = ""
                    try {
                        pr_bid = "" + pr.book_id
                    } catch {
                        pr_bid = ""
                    }
                    if pr_bid != .route_id {
                        pr = null
                    }
                }
                if pr != null {
                    let pc2 int = pr.chapter_number
                    if pc2 == .chapter_num {
                        let pi int = pr.paragraph_index
                        if pi >= 0 {
                            var matched bool = false
                            var i int = 0
                            while i < .paragraphs.len() {
                                let p = .paragraphs[i]
                                if p.idx == pi {
                                    matched = true
                                    // F-13 修正：缺失字段与合法正文必须区分。
                                    // `!= nil` 编译为宽松 `!= null`（Vue 覆盖
                                    // undefined；VM 缺字段 raise→catch）——缺失
                                    // →空串，合法正文（含字面量 "undefined"）
                                    // 原样保留参与逐字核对。
                                    var saved_text str = ""
                                    try {
                                        let v = pr.para_text
                                        if v != nil {
                                            saved_text = "" + v
                                        }
                                    } catch {
                                        saved_text = ""
                                    }
                                    if saved_text == "" {
                                        .restored_note = "上次保存的位置缺少内容锚点，请重新点选段落"
                                    } else {
                                        if saved_text == ("" + p.text) {
                                            .cur_paragraph = pi
                                            .cur_para_text = "" + p.text
                                            .restored_note = "已恢复上次位置（点任意段落可更新）"
                                            restore_target = pi
                                        } else {
                                            .restored_note = "上次保存的段落内容已变化，请重新点选位置"
                                        }
                                    }
                                    i = .paragraphs.len()
                                }
                                i = i + 1
                            }
                            if !matched {
                                .restored_note = "上次保存的段落在本章已不存在，请重新点选位置"
                            }
                        }
                    }
                }
                // T-25 恢复定位（PLAN-781 锚点）：.loaded 置真后经一次 await
                // 让出（Vue 在 await 边界刷新 DOM，段落此时真正入树；VM 轨
                // intent 队列本就渲染后排空），再按稳定子 key 入队元素级定
                // 位——nearest 公式按真实布局顶/底对齐入 pane（双轨同源）。
                // 入队回执非完成证明（完成 oracle = 真实 offset 变化 + 目标
                // 正面积交集，由 V-20 测试门承担）；入队期 error 诚实提示。
                .loaded = true
                if restore_target >= 0 {
                    let warm = parse_lib(Http.get_json("/api/library/progress?book_id=" + .route_id))
                    let rk str = "p" + restore_target.to_string()
                    let rr str = scroll_to_child(.rsc, rk)
                    if rr.find("error:") == 0 {
                        .restored_note = .restored_note + "；自动定位失败，请手动滚动"
                    }
                }
                let total int = .chapter_count
                if total > 0 {
                    .progress_pct = pct_of(.chapter_num, total)
                }
                .progress_label = pct1(.progress_pct) + "%"
                // READER-007 T-03：正式 EPUB 引擎表面自动装载——建立产品会话
                // 后取 surface-url 并写入 model（VM 轨 doc-surface 组件消费；
                // vue 轨经 mountProductEngine 页面自身装载），不靠驱动注入。
                // 会话/装载失败诚实提示，不冒充已装载。
                if .is_epub {
                    .loaded = true
                    let sid str = "r7-" + Time.now_ms().to_string()
                    // T-04：记录会话 id（目录/设置/分页滚动命令的宿主侧手柄）
                    .epub_sid = sid
                    // 先取书目记录的真实 source_hash（探针里已有），再一次
                    // 建会话——"pending" 占位必被服务端拒（hash 核验），
                    // 属无效调用，不发起。
                    let bprobe = parse_lib(Http.get_json("/api/library/books/" + .route_id))
                    var shash str = ""
                    if bprobe != null {
                        var bh str = ""
                        try {
                            bh = "" + bprobe.source_hash
                        } catch {
                            bh = ""
                        }
                        if bh != "" {
                            shash = bh
                            let sess2 = parse_lib(Http.post("/api/reader/session", { session_id: sid, book_id: .route_id, source_hash: shash, engine: "foliate-js@3d794195" }))
                        }
                    }
                    var sres = parse_lib(Http.get_json("/api/reader/surface-url"))
                    var surl str = ""
                    if sres != null {
                        var vok = sres.ok
                        var vurl str = ""
                        try {
                            vurl = "" + sres.url
                        } catch {
                            vurl = ""
                        }
                        if vok {
                            surl = vurl
                        }
                    }
                    if surl != "" {
                        .surface_url = surl
                        .engine_note = "引擎表面已装载"
                        let mres str = mountProductEngine(sid, .route_id, shash).await
                        if mres != "ok" {
                            .engine_note = "引擎装载失败：" + mres
                        }
                        // READER-007 T-07：冷恢复 v1/v2——阅读状态含 locator
                        // （EPUB v2 位次面）按其 spine 定位；否则按既有
                        // chapter_number；无状态默认章 1（doc-surface 初态）。
                        // goto 经会话命令队列（adapter 就绪后执行）。
                        var rest_ch int = 0
                        var prj str = ""
                        try {
                            prj = Http.get_json("/api/library/progress?book_id=" + .route_id)
                        } catch {
                            prj = ""
                        }
                        if prj != "" {
                            let pr = parse_lib(prj)
                            if pr != null {
                                var has_loc2 bool = false
                                try {
                                    let lchk = pr.locator
                                    has_loc2 = true
                                } catch {
                                    has_loc2 = false
                                }
                                if has_loc2 {
                                    try {
                                        let rs str = "" + pr.locator.resource.spine_index
                                        rest_ch = rs.to_int()
                                    } catch {
                                        rest_ch = 0
                                    }
                                }
                                if rest_ch < 1 {
                                    try {
                                        let cs str = "" + pr.chapter_number
                                        rest_ch = cs.to_int()
                                    } catch {
                                        rest_ch = 0
                                    }
                                }
                            }
                        }
                        if rest_ch >= 1 {
                            if rest_ch <= .chapter_count {
                                if rest_ch != .chapter_num {
                                    .chapter_num = rest_ch
                                    router.push("/book/" + .route_id + "/chapter/" + rest_ch.to_string())
                                    let craw str = Http.get_json("/api/library/chapter?book_id=" + .route_id + "&number=" + rest_ch.to_string())
                                    let chv = parse_lib(craw)
                                    if chv != null {
                                        .chapter = chv
                                    }
                                    .chapter_src = craw
                                }
                                if .epub_sid != "" {
                                    Http.post("/api/reader/command", { session_id: .epub_sid, op: "goto", index: rest_ch - 1, font_size: "", layout: "", theme: "", flow_mode: "" })
                                }
                                .restored_note = "已恢复到上次位置（第 " + rest_ch.to_string() + " 章）"
                            }
                        }
                    } else {
                        .engine_note = "引擎表面装载失败（会话或资源不可用）"
                    }
                }
            } else {
                .chapter = Http.get_json("/api/chapters?book_id=" + .book_id.to_string() + "&number=" + .chapter_num.to_string())
                .chapters = Http.get_json("/api/books/" + .book_id.to_string() + "/chapters")
                let book = Http.get_json("/api/books/" + .book_id.to_string())
                if book != null {
                    .chapter_count = book.chapter_count
                }
                let total_demo int = .chapter_count
                if total_demo > 0 {
                    .progress_pct = pct_of(.chapter_num, total_demo)
                }
                .progress_label = pct1(.progress_pct) + "%"
            }
            // 排版偏好合成下沉文件级 fn（等价语义）；VM 轨大 handler 内联
            // storage 尾段触发降档投毒（N-r8-2a），此重构为其绕避之一
            .font_size = fill_pref(.font_size, "br-font-size", "medium")
            .line_height = fill_pref(.line_height, "br-line-height", "comfy")
            .body_style = body_style_of(.font_size, .line_height)
            // auto-os/PLAN-059 T-03：阅读配色接入（经 READER-007 正式引擎
            // 端口）。优先级 = 显式书级选择（reading-state/选择器）> 应用模式
            // 派生（本页 dark_mode 位由运行时种子链/宿主策略驱动）> 内置缺省
            // light。无显式选择且应用处于 dark 时默认派生 dark（浅/深与壳
            // 同步；sepia 恒为显式选择）。
            if !.theme_explicit {
                if .dark_mode {
                    .theme = "dark"
                }
            }
            // READER-002 派生样式刷新（SetLayout/SetTheme 同式）
            .theme_body_cls = theme_body_of(.theme)
            .theme_hover_cls = theme_hover_of(.theme)
            .theme_marked_cls = theme_marked_of(.theme)
            .para_marked_cls = theme_marked_of(.theme) + " border-primary para-marked"
            .para_idle_cls = "border-transparent " + theme_hover_of(.theme)
            .layout_col_cls = layout_cls_of(.layout)
            // PLAN-059 T-03（既有缺口修复，有反例）：冷恢复此前不向引擎端口
            // 补发主题——stored/派生 theme=dark 重开后引擎面停留默认浅色。
            // 现按 SetTheme 同式经命令端口下发当前主题（含非 EPUB 面零副作用）。
            if .is_epub {
                if .epub_sid != "" {
                    Http.post("/api/reader/command", { session_id: .epub_sid, op: "settings", index: 0, font_size: "", layout: "", theme: .theme, flow_mode: "" })
                }
            }
            if !.is_real {
                .loaded = true
                store.SetProgress(.book_id, .progress_pct)
            }
        }
        .Back -> { router.push("/book/" + .route_id) }
        .ToggleToc -> { .show_toc = !.show_toc }
        .SelectChapter(n int) -> {
            .show_toc = false
            if n != .chapter_num {
                .chapter_num = n
                // T-04：EPUB 引擎表面换章走引擎内 goto 命令（表面整书装载，
                // 不整页重载/重装表面——旧行为 router.push 会重新 Init 并
                // 重建会话、丢失表面状态）。TXT/MD 保持既有换章序列。
                if .is_epub {
                    var tidx int = n - 1
                    if tidx < 0 {
                        tidx = 0
                    }
                    if .epub_sid != "" {
                        Http.post("/api/reader/command", { session_id: .epub_sid, op: "goto", index: tidx, font_size: "", layout: "", theme: "", flow_mode: "" })
                    }
                    var i int = 0
                    while i < .chapters.len() {
                        let c2 = .chapters[i]
                        let cn int = c2.number
                        if cn == n {
                            let t2 str = "" + c2.title
                            if t2 != "" {
                                .chapter.title = t2
                            }
                            i = .chapters.len()
                        }
                        i = i + 1
                    }
                } else {
                    router.push("/book/" + .route_id + "/chapter/" + .chapter_num.to_string())
                    if .is_real {
                        let craw str = Http.get_json("/api/library/chapter?book_id=" + .route_id + "&number=" + .chapter_num.to_string())
                        let chv = parse_lib(craw)
                        if chv != null {
                            .chapter = chv
                        }
                        .chapter_src = craw
// READER-002 注释装载规范序列（变更/换章后同式）
                        .ann_resp = Http.get_json("/api/library/annotations?book_id=" + .route_id)
                        .anns = enrich_ann(.ann_resp, "" + .chapter.body, .chapter_num)
                        .paragraphs = merge_marks("" + .chapter.body, .ann_resp, .chapter_num, craw)
                        .cur_paragraph = -1
                        .cur_para_text = ""
                    } else {
                        .chapter = Http.get_json("/api/chapters?book_id=" + .book_id.to_string() + "&number=" + .chapter_num.to_string())
                    }
                    if .is_real {
                        let pl str = real_payload(.route_id, .chapter_num, .cur_paragraph, para_hash(.cur_para_text), .font_size, .line_height, .layout, .theme)
                        var save_ok bool = false
                        try {
                            let resp str = Http.post("/api/library/progress", { book_id: .route_id, payload: pl, para_text: "" })
                            if resp.find("\"ok\":true") >= 0 {
                                save_ok = true
                            }
                        } catch { }
                        if !save_ok {
                            .restored_note = "位置保存失败：后端未确认，请重试"
                        }
                    } else {
                        store.SetProgress(.book_id, .progress_pct)
                    }
                }
                let total int = .chapter_count
                if total > 0 {
                    .progress_pct = pct_of(.chapter_num, total)
                }
                .progress_label = pct1(.progress_pct) + "%"
            }
        }
        .PrevChapter -> {
            if .chapter_num > 1 {
                .chapter_num = .chapter_num - 1
                // T-04：EPUB 引擎表面 prev 走 goto 命令（同 SelectChapter）
                if .is_epub {
                    if .epub_sid != "" {
                        Http.post("/api/reader/command", { session_id: .epub_sid, op: "goto", index: .chapter_num - 1, font_size: "", layout: "", theme: "", flow_mode: "" })
                    }
                } else {
                router.push("/book/" + .route_id + "/chapter/" + .chapter_num.to_string())
                if .is_real {
                    let craw str = Http.get_json("/api/library/chapter?book_id=" + .route_id + "&number=" + .chapter_num.to_string())
                    let chv = parse_lib(craw)
                    if chv != null {
                        .chapter = chv
                    }
                    .chapter_src = craw
// READER-002 注释装载规范序列（变更/换章后同式）
                    .ann_resp = Http.get_json("/api/library/annotations?book_id=" + .route_id)
                    .anns = enrich_ann(.ann_resp, "" + .chapter.body, .chapter_num)
                    .paragraphs = merge_marks("" + .chapter.body, .ann_resp, .chapter_num, craw)
                    .cur_paragraph = -1
                    .cur_para_text = ""
                } else {
                    .chapter = Http.get_json("/api/chapters?book_id=" + .book_id.to_string() + "&number=" + .chapter_num.to_string())
                }
                if .is_real {
                    let pl str = real_payload(.route_id, .chapter_num, .cur_paragraph, para_hash(.cur_para_text), .font_size, .line_height, .layout, .theme)
                    var save_ok bool = false
                    try {
                        let resp str = Http.post("/api/library/progress", { book_id: .route_id, payload: pl, para_text: "" })
                        if resp.find("\"ok\":true") >= 0 {
                            save_ok = true
                        }
                    } catch { }
                    if !save_ok {
                        .restored_note = "位置保存失败：后端未确认，请重试"
                    }
                } else {
                    store.SetProgress(.book_id, .progress_pct)
                }
                }
                let total int = .chapter_count
                if total > 0 {
                    .progress_pct = pct_of(.chapter_num, total)
                }
                .progress_label = pct1(.progress_pct) + "%"
            }
        }
        .NextChapter -> {
            if .chapter_num < .chapter_count {
                .chapter_num = .chapter_num + 1
                // T-04：EPUB 引擎表面 next 走 goto 命令（同 SelectChapter）
                if .is_epub {
                    if .epub_sid != "" {
                        Http.post("/api/reader/command", { session_id: .epub_sid, op: "goto", index: .chapter_num - 1, font_size: "", layout: "", theme: "", flow_mode: "" })
                    }
                } else {
                router.push("/book/" + .route_id + "/chapter/" + .chapter_num.to_string())
                if .is_real {
                    let craw str = Http.get_json("/api/library/chapter?book_id=" + .route_id + "&number=" + .chapter_num.to_string())
                    let chv = parse_lib(craw)
                    if chv != null {
                        .chapter = chv
                    }
                    .chapter_src = craw
// READER-002 注释装载规范序列（变更/换章后同式）
                    .ann_resp = Http.get_json("/api/library/annotations?book_id=" + .route_id)
                    .anns = enrich_ann(.ann_resp, "" + .chapter.body, .chapter_num)
                    .paragraphs = merge_marks("" + .chapter.body, .ann_resp, .chapter_num, craw)
                    .cur_paragraph = -1
                    .cur_para_text = ""
                } else {
                    .chapter = Http.get_json("/api/chapters?book_id=" + .book_id.to_string() + "&number=" + .chapter_num.to_string())
                }
                if .is_real {
                    let pl str = real_payload(.route_id, .chapter_num, .cur_paragraph, para_hash(.cur_para_text), .font_size, .line_height, .layout, .theme)
                    var save_ok bool = false
                    try {
                        let resp str = Http.post("/api/library/progress", { book_id: .route_id, payload: pl, para_text: "" })
                        if resp.find("\"ok\":true") >= 0 {
                            save_ok = true
                        }
                    } catch { }
                    if !save_ok {
                        .restored_note = "位置保存失败：后端未确认，请重试"
                    }
                } else {
                    store.SetProgress(.book_id, .progress_pct)
                }
                }
                let total int = .chapter_count
                if total > 0 {
                    .progress_pct = pct_of(.chapter_num, total)
                }
                .progress_label = pct1(.progress_pct) + "%"
            }
        }
        // Locator v1：tap 段落即记录（段 index + 段文本指纹），幂等保存。
        // F-05 修复：保存成功必须由后端响应确认；失败诚实提示可重试，
        // 不再吞异常后无条件显示"已记录"。
        .TapParagraph(idx int) -> {
            .cur_paragraph = idx
            var i int = 0
            while i < .paragraphs.len() {
                let p = .paragraphs[i]
                if p.idx == idx {
                    .cur_para_text = "" + p.text
                    i = .paragraphs.len()
                }
                i = i + 1
            }
            let ph str = para_hash(.cur_para_text)
            let pl str = real_payload(.route_id, .chapter_num, .cur_paragraph, ph, .font_size, .line_height, .layout, .theme)
            var save_ok bool = false
            try {
                let resp str = Http.post("/api/library/progress", { book_id: .route_id, payload: pl, para_text: .cur_para_text })
                if resp.find("\"ok\":true") >= 0 {
                    save_ok = true
                }
            } catch { }
            if save_ok {
                .restored_note = f"已记录位置：第 ${idx} 段"
            } else {
                .restored_note = "位置保存失败：后端未确认，请重试"
            }
        }
        // ── READER-002 阶段A handlers（T-01/T-03/T-05）──
        .NoOp -> { }
        // ── 输入回写（VM 轨 type_text/键入经事件通道按 handler 名送达——
        // NoOp 丢值，T-04 实测：原生编辑注释提交仍带旧 comment；Vue 轨
        // 同 handler 语义不变。auto-photos SetSearch 同款约定）──
        .SearchInput(v str) -> { .search_q = v }
        .QuoteInput(v str) -> { .ann_quote = v }
        .OccInput(v str) -> { .ann_occ_str = v }
        .CommentInput(v str) -> { .ann_comment = v }
        .TagsInput(v str) -> { .ann_tags = v }
        .ToggleSearch -> {
            .show_search = !.show_search
            .show_anns = false
            .show_style = false
            .search_note = ""
        }
        // 搜索：widget 级触发（onenter/按钮），无全局键盘 handler——
        // 不抢输入框/IME 事件（T-00 裁决）。结果由后端段粒度精确子串
        // 返回；点击结果走 JumpTo（跨章先换章再锚点定位）。
        .DoSearch -> {
            .search_note = "搜索中…"
            var resp str = ""
            try {
                resp = Http.post("/api/library/search", { book_id: .route_id, query: .search_q })
            } catch {
                resp = ""
            }
            .search_results = []
            .search_total = 0
            if resp == "" {
                .search_note = "搜索失败：后端未响应，请重试"
            } else {
                if resp.find("\"ok\":true") < 0 {
                    var msg str = "搜索被拒绝"
                    try {
                        let e = json.parse(resp)
                        msg = "" + e.message
                    } catch {
                        msg = "搜索被拒绝"
                    }
                    .search_note = msg
                } else {
                    var okp bool = false
                    var wrap = null
                    try {
                        wrap = json.parse(resp)
                        okp = true
                    } catch {
                        okp = false
                    }
                    if okp {
                        .search_results = wrap.results
                        .search_total = wrap.total
                        var tt int = wrap.total
                        if tt == 0 {
                            .search_note = "无结果（精确子串匹配）"
                        } else {
                            .search_note = ""
                        }
                    } else {
                        .search_note = "搜索响应解析失败"
                    }
                }
            }
        }
        .ToggleAnns -> {
            .show_anns = !.show_anns
            .show_search = false
            .show_style = false
            .ann_note = ""
        }
        .ToggleStyle -> {
            .show_style = !.show_style
            .show_search = false
            .show_anns = false
        }
        // 排版偏好：立即生效 + 随阅读状态持久化（layout/theme 可选键，
        // 与 001 的 font/line 同一保存面；失败诚实提示，不假保存）。
        .SetLayout(l str) -> {
            if l == "narrow" {
                .layout = "narrow"
            }
            if l == "medium" {
                .layout = "medium"
            }
            if l == "wide" {
                .layout = "wide"
            }
            .layout_col_cls = layout_cls_of(.layout)
            // T-04：EPUB 引擎表面设置经命令通道应用（列宽重排）
            if .is_epub {
                if .epub_sid != "" {
                    Http.post("/api/reader/command", { session_id: .epub_sid, op: "settings", index: 0, font_size: "", layout: .layout, theme: "", flow_mode: "" })
                }
            }
            if .is_real {
                let ph str = para_hash(.cur_para_text)
                let pl str = real_payload(.route_id, .chapter_num, .cur_paragraph, ph, .font_size, .line_height, .layout, .theme)
                var save_ok bool = false
                try {
                    let resp str = Http.post("/api/library/progress", { book_id: .route_id, payload: pl, para_text: .cur_para_text })
                    if resp.find("\"ok\":true") >= 0 {
                        save_ok = true
                    }
                } catch { }
                if !save_ok {
                    .restored_note = "排版保存失败：后端未确认，请重试"
                }
            }
        }
        .SetTheme(t str) -> {
            if t == "light" {
                .theme = "light"
            }
            if t == "sepia" {
                .theme = "sepia"
            }
            if t == "dark" {
                .theme = "dark"
            }
            .theme_body_cls = theme_body_of(.theme)
            .theme_hover_cls = theme_hover_of(.theme)
            .theme_marked_cls = theme_marked_of(.theme)
            .para_marked_cls = theme_marked_of(.theme) + " border-primary para-marked"
            .para_idle_cls = "border-transparent " + theme_hover_of(.theme)
            // T-04：EPUB 引擎表面主题经命令通道应用
            if .is_epub {
                if .epub_sid != "" {
                    Http.post("/api/reader/command", { session_id: .epub_sid, op: "settings", index: 0, font_size: "", layout: "", theme: .theme, flow_mode: "" })
                }
            }
            if .is_real {
                let ph str = para_hash(.cur_para_text)
                let pl str = real_payload(.route_id, .chapter_num, .cur_paragraph, ph, .font_size, .line_height, .layout, .theme)
                var save_ok bool = false
                try {
                    let resp str = Http.post("/api/library/progress", { book_id: .route_id, payload: pl, para_text: .cur_para_text })
                    if resp.find("\"ok\":true") >= 0 {
                        save_ok = true
                    }
                } catch { }
                if !save_ok {
                    .restored_note = "排版保存失败：后端未确认，请重试"
                }
            }
        }
        // T-04：字号切换（EPUB 引擎表面经命令通道；TXT/MD 走既有 body_style）
        .SetFontSize(f str) -> {
            if f == "small" {
                .font_size = "small"
            }
            if f == "medium" {
                .font_size = "medium"
            }
            if f == "large" {
                .font_size = "large"
            }
            .body_style = body_style_of(.font_size, .line_height)
            storage.set("br-font-size", .font_size)
            if .is_epub {
                if .epub_sid != "" {
                    Http.post("/api/reader/command", { session_id: .epub_sid, op: "settings", index: 0, font_size: .font_size, layout: "", theme: "", flow_mode: "" })
                }
            }
            if .is_real {
                let ph str = para_hash(.cur_para_text)
                let pl str = real_payload(.route_id, .chapter_num, .cur_paragraph, ph, .font_size, .line_height, .layout, .theme)
                var save_ok bool = false
                try {
                    let resp str = Http.post("/api/library/progress", { book_id: .route_id, payload: pl, para_text: .cur_para_text })
                    if resp.find("\"ok\":true") >= 0 {
                        save_ok = true
                    }
                } catch { }
                if !save_ok {
                    .restored_note = "排版保存失败：后端未确认，请重试"
                }
            }
        }
        // T-04：引擎表面流模式（分页/滚动）切换
        .SetFlow(m str) -> {
            if m == "paged" {
                .epub_flow = "paged"
            }
            if m == "scrolled" {
                .epub_flow = "scrolled"
            }
            if .is_epub {
                if .epub_sid != "" {
                    Http.post("/api/reader/command", { session_id: .epub_sid, op: "flow", index: 0, font_size: "", layout: "", theme: "", flow_mode: .epub_flow })
                }
            }
        }
        // 搜索结果/注释回访跳转：同章直接定位；跨章先走章节装载序列再
        // 定位。定位沿用 PLAN-781 锚柄（scroll_to_child by p<idx>），一次
        // HTTP 让出等待渲染（与 Init 恢复定位同式）；入队回执非完成证明。
        .JumpTo(ch int, pi int) -> {
            .show_search = false
            .show_anns = false
            if ch != .chapter_num {
                if ch >= 1 {
                    if ch <= .chapter_count {
                        .chapter_num = ch
                        router.push("/book/" + .route_id + "/chapter/" + .chapter_num.to_string())
                        let craw str = Http.get_json("/api/library/chapter?book_id=" + .route_id + "&number=" + .chapter_num.to_string())
                        let chv = parse_lib(craw)
                        if chv != null {
                            .chapter = chv
                        }
                        .chapter_src = craw
                        .ann_resp = Http.get_json("/api/library/annotations?book_id=" + .route_id)
                        .anns = enrich_ann(.ann_resp, "" + .chapter.body, .chapter_num)
                        .paragraphs = merge_marks("" + .chapter.body, .ann_resp, .chapter_num, craw)
                        let total int = .chapter_count
                        if total > 0 {
                            .progress_pct = pct_of(.chapter_num, total)
                        }
                        .progress_label = pct1(.progress_pct) + "%"
                    }
                }
            }
            // READER-007 T-07：EPUB 搜索/注释跳转的引擎定位——文本章切换
            // 后引擎 goto（与 SelectChapter 同式）；各命中按章分明（重复句
            // 第 1/2 处→章 1，第 3 处→章 2）。
            if .is_epub {
                if .epub_sid != "" {
                    Http.post("/api/reader/command", { session_id: .epub_sid, op: "goto", index: .chapter_num - 1, font_size: "", layout: "", theme: "", flow_mode: "" })
                }
            }
            var found bool = false
            var i int = 0
            while i < .paragraphs.len() {
                let p = .paragraphs[i]
                if p.idx == pi {
                    found = true
                    .cur_para_text = "" + p.text
                    i = .paragraphs.len()
                }
                i = i + 1
            }
            if found {
                .cur_paragraph = pi
                let warm = parse_lib(Http.get_json("/api/library/progress?book_id=" + .route_id))
                let rr str = scroll_to_child(.rsc, "p" + pi.to_string())
                if rr.find("error:") == 0 {
                    .restored_note = "自动定位失败，请手动滚动"
                } else {
                    .restored_note = f"已跳转：第 ${ch} 章 ¶${pi}"
                }
                let ph str = para_hash(.cur_para_text)
                let pl str = real_payload(.route_id, .chapter_num, .cur_paragraph, ph, .font_size, .line_height, .layout, .theme)
                try {
                    Http.post("/api/library/progress", { book_id: .route_id, payload: pl, para_text: .cur_para_text })
                } catch { }
            } else {
                .restored_note = "目标段在本章不存在（内容可能已变化）"
            }
        }
        // T-03：链接 chips 跳转（书内目标复用 JumpTo 序列；无效目标诚实
        // 提示不跳转——外部 scheme/越界/未知 fragment 由后端解析为 ch=0）。
        // para=-1 = 章首目标（无段锚，不滚动定位）。
        .JumpLink(lch int, lpara int) -> {
            if lch < 1 {
                .restored_note = "链接目标不可用（外部或越界，未执行）"
            } else {
                if lch != .chapter_num {
                    if lch >= 1 {
                        if lch <= .chapter_count {
                            .chapter_num = lch
                            router.push("/book/" + .route_id + "/chapter/" + .chapter_num.to_string())
                            let craw str = Http.get_json("/api/library/chapter?book_id=" + .route_id + "&number=" + .chapter_num.to_string())
                            let chv = parse_lib(craw)
                            if chv != null {
                                .chapter = chv
                            }
                            .ann_resp = Http.get_json("/api/library/annotations?book_id=" + .route_id)
                            .anns = enrich_ann(.ann_resp, "" + .chapter.body, .chapter_num)
                            .paragraphs = merge_marks("" + .chapter.body, .ann_resp, .chapter_num, craw)
                            let total int = .chapter_count
                            if total > 0 {
                                .progress_pct = pct_of(.chapter_num, total)
                            }
                            .progress_label = pct1(.progress_pct) + "%"
                        }
                    }
                }
                if lpara >= 0 {
                    var found bool = false
                    var i int = 0
                    while i < .paragraphs.len() {
                        let p = .paragraphs[i]
                        if p.idx == lpara {
                            found = true
                            .cur_para_text = "" + p.text
                            i = .paragraphs.len()
                        }
                        i = i + 1
                    }
                    if found {
                        .cur_paragraph = lpara
                        let warm = parse_lib(Http.get_json("/api/library/progress?book_id=" + .route_id))
                        let rr str = scroll_to_child(.rsc, "p" + lpara.to_string())
                        if rr.find("error:") == 0 {
                            .restored_note = "自动定位失败，请手动滚动"
                        } else {
                            .restored_note = f"已跳转链接：第 ${lch} 章 ¶${lpara}"
                        }
                        let ph str = para_hash(.cur_para_text)
                        let pl str = real_payload(.route_id, .chapter_num, .cur_paragraph, ph, .font_size, .line_height, .layout, .theme)
                        try {
                            Http.post("/api/library/progress", { book_id: .route_id, payload: pl, para_text: .cur_para_text })
                        } catch { }
                    } else {
                        .restored_note = "链接目标段在本章不存在（内容可能已变化）"
                    }
                } else {
                    .cur_paragraph = -1
                    .cur_para_text = ""
                    .restored_note = f"已跳转链接：第 ${lch} 章章首"
                }
            }
        }
        .AnnDelete(aid str) -> {
            var resp str = ""
            try {
                resp = Http.post("/api/library/annotations", { book_id: .route_id, op: "delete", annotation_id: aid, kind: "", chapter_number: 0, para_idx: 0, occurrence: 0, comment: "", tags_json: "[]", quote: "" })
            } catch {
                resp = ""
            }
            if resp.find("\"ok\":true") >= 0 {
                .ann_resp = Http.get_json("/api/library/annotations?book_id=" + .route_id)
                .anns = enrich_ann(.ann_resp, "" + .chapter.body, .chapter_num)
                .paragraphs = merge_marks("" + .chapter.body, .ann_resp, .chapter_num, .chapter_src)
                .ann_note = "已删除"
            } else {
                var msg str = "删除失败"
                try {
                    let e = json.parse(resp)
                    msg = "" + e.message
                } catch {
                    msg = "删除失败：后端未响应"
                }
                .ann_note = msg
            }
        }
        // 注释对话框：预填整段文本（子串可编辑截取）；出现序默认 1。
        // 点段=记位置行为不变；＋注释入口在当前段动作行。
        .OpenAnnDialog(idx int) -> {
            .ann_dialog = true
            .ann_edit_id = ""
            .ann_locator = ""
            .ann_dlg_title = "添加注释"
            .ann_ch = .chapter_num
            .ann_pi = idx
            var i int = 0
            while i < .paragraphs.len() {
                let p = .paragraphs[i]
                if p.idx == idx {
                    .ann_quote = "" + p.text
                    i = .paragraphs.len()
                }
                i = i + 1
            }
            .ann_occ_str = "1"
            .ann_comment = ""
            .ann_tags = ""
            .ann_kind = "highlight"
            .ann_dlg_note = ""
        }
        .AnnEdit(aid str) -> {
            var i int = 0
            while i < .anns.len() {
                let a = .anns[i]
                let tid str = "" + a.annotation_id
                if tid == aid {
                    .ann_dialog = true
                    .ann_edit_id = aid
                    .ann_dlg_title = "编辑注释"
                    .ann_ch = a.chapter_number
                    .ann_pi = a.para_idx
                    .ann_quote = "" + a.quote
                    .ann_occ_str = "" + a.occurrence
                    .ann_comment = "" + a.comment
                    .ann_kind = "" + a.kind
                    i = .anns.len()
                }
                i = i + 1
            }
            .ann_tags = ""
            .ann_dlg_note = ""
        }
        .AnnKind(k str) -> {
            if k == "highlight" {
                .ann_kind = "highlight"
            }
            if k == "comment" {
                .ann_kind = "comment"
            }
            if k == "bookmark" {
                .ann_kind = "bookmark"
            }
        }
        // T-06 批注所选：取会话最新 canonical locator（adapter 选区回传→
        // 服务器提案存储），预填注释抽屉；保存经 annotations-v2 携带 v2 锚。
        // 引擎表面与页面无共享 JS 上下文——消费面走服务器提案（非用户数据，
        // 注释/阅读状态零触碰；用户确认动作才落注释）。
        .SelAnnotate -> {
            if !.is_epub {
                .sel_note = ""
            } else {
                if .epub_sid == "" {
                    .sel_note = "引擎会话未就绪"
                } else {
                    var pj str = ""
                    try {
                        pj = Http.get_json("/api/reader/locator?session_id=" + .epub_sid)
                    } catch {
                        pj = ""
                    }
                    var found bool = false
                    if pj != "" {
                        // get_json/vue fetch 返回未解一层的包装串（\" 转义形态）
                        // ——token 用编码无关面（reader-locator 两形态都存在）
                        if pj.find("reader-locator") >= 0 {
                            found = true
                        }
                    }
                    if found {
                        var w1 = json.parse(pj)
                        var t1 str = "" + w1
                        var w = w1
                        if t1.substr(0, 1) == "{" {
                            w = json.parse(t1)
                        }
                        let lo = w.locator
                        let rs str = "" + lo.resource.spine_index
                        let oi str = "" + lo.occurrence.index
                        .ann_dialog = true
                        .ann_edit_id = ""
                        .ann_dlg_title = "批注所选（引擎选区）"
                        .ann_ch = rs.to_int()
                        .ann_pi = -1
                        .ann_quote = "" + lo.quote
                        .ann_occ_str = oi
                        .ann_comment = ""
                        .ann_tags = ""
                        .ann_kind = "highlight"
                        .ann_locator = "" + w.locator_json
                        .ann_dlg_note = "已捕获引擎选区（canonical locator，保存时逐字核验）"
                        .sel_note = ""
                    } else {
                        .sel_note = "未捕获选区——请先在正文拖选文字"
                    }
                }
            }
        }
        // T-06 回访：按记录 v2 锚跑恢复环核验（verify-ann oracle）——匹配才
        // 引擎 goto 定位；失配诚实 needs_relocate（不跳第一处/不静默）；
        // 纯 v1 记录诚实「无 v2 锚」。
        .AnnRevisit(aid str) -> {
            var resp str = ""
            try {
                resp = Http.post("/api/library/locator/verify-ann", { book_id: .route_id, annotation_id: aid })
            } catch {
                resp = ""
            }
            var mhit bool = false
            if resp.find("match\":true") >= 0 {
                mhit = true
            }
            if resp.find("match\": true") >= 0 {
                mhit = true
            }
            if mhit {
                var w20 = json.parse(resp)
                var t20 str = "" + w20
                var w2 = w20
                if t20.substr(0, 1) == "{" {
                    w2 = json.parse(t20)
                }
                let spn_s str = "" + w2.spine
                let spn int = spn_s.to_int()
                if spn >= 1 {
                    if spn <= .chapter_count {
                        .chapter_num = spn
                        if .is_epub {
                            if .epub_sid != "" {
                                Http.post("/api/reader/command", { session_id: .epub_sid, op: "goto", index: spn - 1, font_size: "", layout: "", theme: "", flow_mode: "" })
                            }
                        }
                        // 文本章同步装载（回访后抽屉/段落语义可用）
                        let craw str = Http.get_json("/api/library/chapter?book_id=" + .route_id + "&number=" + spn.to_string())
                        let chv = parse_lib(craw)
                        if chv != null {
                            .chapter = chv
                        }
                        .chapter_src = craw
                        .ann_resp = Http.get_json("/api/library/annotations?book_id=" + .route_id)
                        .anns = enrich_ann(.ann_resp, "" + .chapter.body, .chapter_num)
                        .paragraphs = merge_marks("" + .chapter.body, .ann_resp, .chapter_num, .chapter_src)
                    }
                    .ann_note = "已回访：v2 锚定位匹配"
                } else {
                    .ann_note = "已回访：锚缺资源位"
                }
            } else {
                if resp.find("anchored\":false") >= 0 {
                    .ann_note = "该注释无 v2 锚（旧段锚，回访沿段落定位）"
                } else {
                    var msg2 str = "回访失败"
                    try {
                        var e10 = json.parse(resp)
                        var t10 str = "" + e10
                        var e2 = e10
                        if t10.substr(0, 1) == "{" {
                            e2 = json.parse(t10)
                        }
                        let rsn str = "" + e2.reason
                        let msn str = "" + e2.message
                        if rsn != "" {
                            msg2 = "needs_relocate：" + rsn
                        } else {
                            if msn != "" {
                                msg2 = "回访失败：" + msn
                            }
                        }
                    } catch {
                        msg2 = "回访失败：后端未响应"
                    }
                    .ann_note = msg2
                }
            }
        }
        .AnnCancel -> {
            .ann_dialog = false
            .ann_edit_id = ""
            .ann_locator = ""
            .ann_dlg_note = ""
        }
        // 提交：quote/comment/tags 走顶层字段直传（多字节安全，F-08 同源）；
        // 锚核验在服务端（quote 非子串/出现序不足诚实拒绝——对话框回显
        // 错误消息，不假保存）。前置校验失败同样诚实提示。
        .AnnSubmit -> {
            let occv int = .ann_occ_str.trim().to_int()
            var pre_ok bool = true
            if occv < 1 {
                pre_ok = false
                .ann_dlg_note = "出现序需为正整数"
            }
            if pre_ok {
                if .ann_kind != "bookmark" {
                    if .ann_quote.trim() == "" {
                        pre_ok = false
                        .ann_dlg_note = "摘录不能为空（逐字锚必填）"
                    }
                }
            }
            if pre_ok {
                let tj str = tags_json_of(.ann_tags)
                var op str = "create"
                if .ann_edit_id != "" {
                    op = "update"
                }
                var resp str = ""
                try {
                    // T-06：EPUB 引擎选区新建经 annotations-v2 携带 canonical
                    // v2 锚（服务器恢复环核验+同一性）；其余写路径沿旧端点
                    //（存量 v2 锚在读改写中 canonical 保留，T-05 record_emit）。
                    if .is_epub {
                        if .ann_locator != "" {
                            if op == "create" {
                                resp = Http.post("/api/library/annotations-v2", { book_id: .route_id, op: op, annotation_id: .ann_edit_id, kind: .ann_kind, chapter_number: .ann_ch, para_idx: .ann_pi, occurrence: occv, comment: .ann_comment, tags_json: tj, quote: .ann_quote, locator_json: .ann_locator })
                            }
                        }
                    }
                    if resp == "" {
                        resp = Http.post("/api/library/annotations", { book_id: .route_id, op: op, annotation_id: .ann_edit_id, kind: .ann_kind, chapter_number: .ann_ch, para_idx: .ann_pi, occurrence: occv, comment: .ann_comment, tags_json: tj, quote: .ann_quote })
                    }
                } catch {
                    resp = ""
                }
                if resp.find("\"ok\":true") >= 0 {
                    .ann_dialog = false
                    .ann_edit_id = ""
                    .ann_locator = ""
                    .ann_resp = Http.get_json("/api/library/annotations?book_id=" + .route_id)
                    .anns = enrich_ann(.ann_resp, "" + .chapter.body, .chapter_num)
                    .paragraphs = merge_marks("" + .chapter.body, .ann_resp, .chapter_num, .chapter_src)
                    .show_anns = true
                    .ann_note = "已保存"
                } else {
                    var msg str = "保存失败"
                    try {
                        let e = json.parse(resp)
                        msg = "" + e.message
                    } catch {
                        msg = "保存失败：后端未响应，请重试"
                    }
                    .ann_dlg_note = msg
                }
            }
        }
        // Markdown 导出（T-05 本地面）：后端生成 <data>/exports/*.md，
        // 读回校验后返回真实路径；Notes 缺席不阻塞（纯本地交付）。
        .DoExport -> {
            .ann_note = "导出中…"
            var resp str = ""
            try {
                resp = Http.post("/api/library/export", { book_id: .route_id })
            } catch {
                resp = ""
            }
            if resp == "" {
                .ann_note = "导出失败：后端未响应，请重试"
            } else {
                if resp.find("\"ok\":true") < 0 {
                    var msg str = "导出失败"
                    try {
                        let e = json.parse(resp)
                        msg = "" + e.message
                    } catch {
                        msg = "导出失败"
                    }
                    .ann_note = msg
                } else {
                    var okp bool = false
                    var wrap = null
                    try {
                        wrap = json.parse(resp)
                        okp = true
                    } catch {
                        okp = false
                    }
                    if okp {
                        let pth str = "" + wrap.path
                        let cnt int = wrap.count
                        if pth == "" {
                            .ann_note = "暂无注释可导出"
                        } else {
                            .ann_note = f"已导出 ${cnt} 条 → ${pth}"
                        }
                    } else {
                        .ann_note = "导出响应解析失败"
                    }
                }
            }
        }
    }
}
