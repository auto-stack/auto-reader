// reading_page.at — "/book/:id/chapter/:ch" 沉浸式阅读页。
// 原模块名 reading：当前 CLI VM 轨下该名模块经 outlet 无法挂载（路由
// 更新、Init 不触发、零诊断输出；同形内容改名即恢复——r8 实测，登记
// 计划 §10 跨仓债务 N-r8-2，框架侧以最小复现排查）。
// PLAN-684 F-4：TOC 抽屉（容器内 absolute，非 fixed）+ 真实排版偏好
// （storage: br-font-size / br-line-height）+ 精简顶/底栏。
// NOTE: book + progress are stored as model fields (set in .Init), NOT
// multi-statement `computed` blocks — the vue codegen does not emit `return`
// for a block-bodied computed, so it would yield undefined.
// PLAN-043 走查修复（2026-09-24）：`use back.api` 直接导入 VM 轨不可解析
// ——章节/书目改 Http.get_json 拉（/api/chapters?book_id=&number= 与
// /api/books/:id(/chapters)，lazy back 随请求孵化）。
// READER-001 T-03：真实书模式——/book/<uuid>/chapter/<n>（id 为字符串）。
// 探测 /api/library/books/:id 命中即真实书：目录/章节/进度走 /api/library/*，
// 正文按段渲染。Phase 3（F-08/F-10）：点段保存携带顶层 para_text 内容
// 锚点（外层 JSON 传输零转义；后端与原文行逐字核对）；恢复以存储态
// para_text 与当前段落逐字验证，缺失/失配诚实提示。
// Phase 3（F-12→T-25）：正文列 scroll-pane（PLAN-656 controller）。恢复定
// 位自 Phase 7 起改 PLAN-781 子内容锚点（scroll-anchor + auto.scroll.to_child，
// 双轨同源 nearest 公式、真实布局定位）：每段带稳定子 key（p<idx>），恢复
// 时入队元素级定位，取代原「溢出滚动 + onscroll 字符占比估算」两段式——
// 估算对混排段失准（F-12），锚点按真实布局顶/底对齐入 pane。
// 逻辑内联于 handler（widget 内局部 fn 不支持——T-03 实测 parse error）；
// 纯计算下沉文件级 fn。/api/library/* 响应双层编码——统一经 parse_lib
// 二次解析（缺书/失败回 null，守卫跨 Vue/VM 双轨安全）。
// READER-002 阶段A（T-01/T-03/T-05）：全文搜索抽屉、注释/书签/高亮
// （对话框创建 quote=段文本可编辑+出现序，锚核验在服务端）、注释抽屉
// （回访跳转/删除/需重定位徽标/Markdown 导出）、排版偏好扩展
// （layout narrow|medium|wide + theme light|sepia|dark 随 reading 状态
// 持久化——SD-02 可选键，缺位=默认）。快捷键裁决（T-00）：无全局键盘
// handler，搜索 onenter / 对话框按钮 widget 级触发，不抢输入框/IME。
use store: BooksStore
use fmt: pct1

style page_btn = "inline-flex items-center gap-1 px-3 py-1.5 text-sm text-foreground hover:bg-accent rounded-lg transition-colors disabled:opacity-40"

/// 进度百分比（floor）。经 fn 形参计算——`as int` 套在 model 字段表达式上时
/// vue codegen 漏 `.value` 解包（生成 `chapter_num * 100` 而非
/// `chapter_num.value * 100`），fn 形参无此问题。
/// 除法自由环：vue 轨文件级 fn 形参不进 int 证明集，`/` 裸发射且 `as int`
/// 退化为 Number() 不截断（新 CLI 实测；后端 int 参数严格拒 float →
/// PUT progress 400）——floor(cur*100/total) 用纯整乘加比较环等价实现，
/// 双轨同义（codegen 债务登记计划 §10）。
fn pct_of(cur int, total int) int {
    if total <= 0 {
        return 0
    }
    if cur <= 0 {
        return 0
    }
    if cur >= total {
        return 100
    }
    var p int = 0
    while ((p + 1) * total <= cur * 100) {
        p = p + 1
    }
    return p
}

/// 段文本校验签名（Locator v1 兼容位）。
/// v1 = 字节长 + 行数（ASCII 输出）。内容证明自 Phase 3 起由 para_text
/// 承担（字符串相等，跨轨安全）；para_hash 仅作格式兼容位随 payload 发送。
fn para_hash(text str) str {
    let lines = text.split("
")
    return "sig1:" + text.len().to_string() + ":" + lines.len().to_string()
}

/// 正文 → 段落数组 [{idx, text, key}]（去空行；idx = 原行号；key = 稳定
/// 子锚点 key，scroll-anchor 寻址用——pane 内唯一，跨章节同构）。
/// READER-002：并入本章注释标记数 mark_n 与需重定位位 mark_bad
/// （quote 非空且在本段出现序不足 = bad——与后端核验同式，展示面诚实
/// 预判，终判在服务端）。入参全标量（anns_resp 为注释 GET 原文，函数内
/// 解析——规避 List/struct 作 fn 参数的双轨缺陷面）。
fn merge_marks(body str, anns_resp str, ch int) List {
    let lines = body.split("\n")
    var out List = []
    var anns = json.parse("[]")
    if anns_resp != "" {
        if anns_resp.find("\"annotations\":[") >= 0 {
            var okp bool = false
            var wrap = null
            try {
                wrap = json.parse(anns_resp)
                okp = true
            } catch {
                okp = false
            }
            if okp {
                anns = wrap.annotations
            }
        }
    }
    var i int = 0
    while i < lines.len() {
        let t str = ("" + lines[i]).trim()
        if t != "" {
            var n int = 0
            var bad int = 0
            for a in anns {
                let ach int = a.chapter_number
                if ach == ch {
                    let apx int = a.para_idx
                    if apx == i {
                        n = n + 1
                        let q str = "" + a.quote
                        if q != "" {
                            let occ int = a.occurrence
                            let live int = count_sub(t, q)
                            if live < occ {
                                bad = 1
                            }
                        }
                    }
                }
            }
            let k str = "p" + i.to_string()
            out.push({ idx: i, text: t, key: k, mark_n: n, mark_bad: bad })
        }
        i = i + 1
    }
    return out
}

/// READER-002：注释集富化（抽屉渲染面）——注释 GET 原文 + 当前章正文
/// → [{annotation_id, kind, chapter_number, para_idx, quote, occurrence,
/// comment, bad}]。bad 仅对当前章核对（quote 出现序不足 = 需重定位；
/// 其他章未核 = 不显示徽标，不做未证断言）。入参全标量。
fn enrich_ann(ann_src str, body str, ch int) List {
    var out List = []
    if ann_src == "" {
        return out
    }
    if ann_src.find("\"annotations\":[") < 0 {
        return out
    }
    var okp bool = false
    var wrap = null
    try {
        wrap = json.parse(ann_src)
        okp = true
    } catch {
        okp = false
    }
    if !okp {
        return out
    }
    let lines = body.split("\n")
    let arr = wrap.annotations
    for a in arr {
        let aid str = "" + a.annotation_id
        let akind str = "" + a.kind
        let ach int = a.chapter_number
        let apx int = a.para_idx
        let q str = "" + a.quote
        let aocc int = a.occurrence
        let acm str = "" + a.comment
        var badv int = 0
        if ach == ch {
            if q != "" {
                if apx < lines.len() {
                    let ln str = ("" + lines[apx]).trim()
                    if count_sub(ln, q) < aocc {
                        badv = 1
                    }
                } else {
                    badv = 1
                }
            }
        }
        out.push({ annotation_id: aid, kind: akind, chapter_number: ach, para_idx: apx, quote: q, occurrence: aocc, comment: acm, bad: badv })
    }
    return out
}

/// /api/library/* 响应二次解析（双层编码）；缺书（""）或解析失败回 null。
fn parse_lib(text str) JsonValue? {
    var out JsonValue? = null
    if text != "" {
        let v = json.parse(text)
        if v != null {
            if v != "" {
                out = v
            }
        }
    }
    return out
}

/// Locator v1 保存载荷（纯 ASCII：uuid/整数/ph1 指纹——VM HTTP 请求体
/// 多字节损坏规避）。段文本指纹由调用方算好传入。
/// 参数名禁与 widget model 变量同名（vue codegen 会对同名参数误加
/// .value 致 undefined——T-03 实测），故用 rid。
/// READER-002：layout/theme 为可选枚举（SD-02）；缺省串为空时不写键
/// （旧存储形态兼容，后端按缺位处理）。
fn real_payload(rid str, ch int, para int, ph str, font str, line str, lay str, thm str) str {
    var payload str = "{\"book_id\":\""
    payload = payload + rid
    payload = payload + "\",\"chapter_number\":"
    payload = payload + ch.to_string()
    payload = payload + ",\"paragraph_index\":"
    payload = payload + para.to_string()
    payload = payload + ",\"para_hash\":\""
    payload = payload + ph
    payload = payload + "\",\"font_size\":\""
    payload = payload + font
    payload = payload + "\",\"line_height\":\""
    payload = payload + line
    payload = payload + "\""
    if lay != "" {
        payload = payload + ",\"layout\":\""
        payload = payload + lay
        payload = payload + "\""
    }
    if thm != "" {
        payload = payload + ",\"theme\":\""
        payload = payload + thm
        payload = payload + "\""
    }
    payload = payload + ",\"updated_at\":0}"
    return payload
}

fn fill_pref(cur str, key str, def str) str {
    if cur != def {
        return cur
    }
    let v = storage.get(key)
    if v != nil {
        if v != "" {
            return v
        }
    }
    return cur
}

fn body_style_of(font str, line str) str {
    var size_cls str = "text-base"
    if font == "small" {
        size_cls = "text-sm"
    }
    if font == "large" {
        size_cls = "text-lg"
    }
    var lead_cls str = "leading-relaxed"
    if line == "compact" {
        lead_cls = "leading-snug"
    }
    return "text-foreground " + size_cls + " " + lead_cls
}

/// READER-002：阅读列宽（宽窄布局）。缺省 medium=max-w-2xl（001 原状）。
fn layout_cls_of(ly str) str {
    if ly == "narrow" {
        return "max-w-xl"
    }
    if ly == "wide" {
        return "max-w-4xl"
    }
    return "max-w-2xl"
}

/// READER-002：阅读主题（亮/米/暗）。作用于正文容器底色与文字色；
/// 页框（顶/底栏）保持应用主题——本地阅读偏好只覆盖沉浸面。
fn theme_body_of(th str) str {
    if th == "sepia" {
        return "bg-[#f4ecd8] text-[#5b4636]"
    }
    if th == "dark" {
        return "bg-[#1f2430] text-[#d6dae2]"
    }
    return "bg-background text-foreground"
}

/// 主题下段落悬停/标记的次级样式（与 theme_body_of 同枚举）。
fn theme_hover_of(th str) str {
    if th == "sepia" {
        return "hover:bg-[#eadfbd]"
    }
    if th == "dark" {
        return "hover:bg-[#2a3140]"
    }
    return "hover:bg-muted"
}

fn theme_marked_of(th str) str {
    if th == "sepia" {
        return "bg-[#eadfbd]"
    }
    if th == "dark" {
        return "bg-[#2a3140]"
    }
    return "bg-primary/10"
}

/// 段内出现计数（重叠口径，与后端 count_occurrences 同式——UI 侧
/// 「第 N 处」候选与锚点预判；终判在服务端）。
/// 段内出现计数（重叠口径，与后端 count_occurrences 同式——滑窗
/// substr 逐位比较，find 偏移不喂 substr，多字节口径错位防御）。
fn count_sub(hay str, needle str) int {
    if needle == "" {
        return 0
    }
    let hl int = hay.len()
    let nl int = needle.len()
    if nl > hl {
        return 0
    }
    var count int = 0
    var i int = 0
    while i + nl <= hl {
        if hay.substr(i, nl) == needle {
            count = count + 1
        }
        i = i + 1
    }
    return count
}
/// 标签输入消毒 + 规范 JSON 数组（"a, b" → ["a","b"]；空 → "[]"）。
/// 引号/反斜杠剥除（防 JSON 注入——服务端词法门兜底拒绝）。
fn tags_json_of(input str) str {
    let parts = input.split(",")
    var out str = "["
    var n int = 0
    while n < parts.len() {
        let raw str = ("" + parts[n]).trim()
        if raw != "" {
            let s str = raw.replace("\"", "").replace("\\", "")
            if s != "" {
                if n > 0 {
                    if out.len() > 1 {
                        out = out + ","
                    }
                }
                out = out + "\""
                out = out + s
                out = out + "\""
            }
        }
        n = n + 1
    }
    out = out + "]"
    return out
}

widget reading_page {
    msg { Init, Back, PrevChapter, NextChapter, ToggleToc, SelectChapter(int), TapParagraph(int), ToggleSearch, DoSearch, ToggleAnns, ToggleStyle, SetLayout(str), SetTheme(str), JumpTo(int, int), AnnDelete(str), OpenAnnDialog(int), AnnKind(str), AnnSubmit, AnnCancel, DoExport, NoOp }

    model {
        var book_id int = 0
        var route_id str = ""
        var is_real bool = false
        var chapter_num int = 1
        var chapter = { book_id: 0, number: 1, title: "", body: "", word_count: 0 }
        var chapters List = []
        var chapter_count int = 1
        var progress_pct int = 0
        var loaded bool = false
        var show_toc bool = false
        var font_size str = "medium"
        var line_height str = "comfy"
        var body_style str = "text-foreground text-base leading-relaxed"
        var progress_label str = "0.0%"
        // 真实书模式
        var paragraphs List = []
        var cur_paragraph int = -1
        var cur_para_text str = ""
        var restored_note str = ""
        // T-25 恢复定位：scroll-pane controller 锚柄（scroll_to_child 寻址）
        var rsc str = "reading-pane"
        // ── READER-002 A：排版偏好扩展（SD-02 可选键；缺省=001 原状）──
        var layout str = "medium"
        var theme str = "light"
        // ── 搜索（T-01）──
        var show_search bool = false
        var search_q str = ""
        var search_results List = []
        var search_note str = ""
        var search_total int = 0
        // ── 注释（T-03）──
        var show_anns bool = false
        var anns List = []
        var ann_marks List = []   // [{ch, pi, n, bad}] 当前章标记/需重定位
        var ann_note str = ""     // 抽屉级提示（导出/错误）
        // ── 注释对话框（创建/编辑）──
        var ann_dialog bool = false
        var ann_edit_id str = ""  // ""=新建；非空=编辑该 id
        var ann_kind str = "highlight"
        var ann_ch int = 0
        var ann_pi int = -1
        var ann_quote str = ""
        var ann_occ_str str = "1"
        var ann_comment str = ""
        var ann_tags str = ""
        var ann_dlg_note str = ""
        // ── 排版抽屉 ──
        var show_style bool = false
        // ── 派生样式（handlers 经文件级 fn 赋值——view 不做逻辑）──
        var theme_body_cls str = "bg-background text-foreground"
        var theme_hover_cls str = "hover:bg-muted"
        var theme_marked_cls str = "bg-primary/10"
        var layout_col_cls str = "max-w-2xl"
        var para_marked_cls str = "bg-primary/10 border-primary para-marked"
        var para_idle_cls str = "border-transparent hover:bg-muted"
        var ann_dlg_title str = "添加注释"
        // 注释 GET 原文（merge_marks/enrichment 共同标量输入）
        var ann_resp str = ""
    }

    view {
        col {
            style: "h-full min-h-screen bg-background relative overflow-hidden"

            // Top bar: back / chapter title / TOC toggle
            row {
                style: "h-14 border-b border-border bg-card items-center px-4 gap-3 shrink-0"
                button {
                    onclick: .Back
                    style: "p-2 hover:bg-accent rounded-lg transition-colors shrink-0"
                    text "←" { style: "text-lg text-foreground" }
                }
                if .loaded {
                    text .chapter.title { style: "font-medium text-foreground flex-1 truncate" }
                } else {
                    text "Loading…" { style: "font-medium text-muted-foreground flex-1 truncate" }
                }
                button {
                    onclick: .ToggleSearch
                    style: "px-3 py-1.5 text-sm text-foreground hover:bg-accent rounded-lg transition-colors shrink-0"
                    text "🔍 搜索" {}
                }
                button {
                    onclick: .ToggleAnns
                    style: "px-3 py-1.5 text-sm text-foreground hover:bg-accent rounded-lg transition-colors shrink-0"
                    text "✎ 注释" {}
                }
                button {
                    onclick: .ToggleStyle
                    style: "px-3 py-1.5 text-sm text-foreground hover:bg-accent rounded-lg transition-colors shrink-0"
                    text "Aa" {}
                }
                button {
                    onclick: .ToggleToc
                    style: "px-3 py-1.5 text-sm text-foreground hover:bg-accent rounded-lg transition-colors shrink-0"
                    text "☰ Contents" {}
                }
            }

            // Body: TOC drawer + search/annotations/style drawers + reading column
            row {
                style: "flex-1 min-h-0 items-stretch relative overflow-hidden"
                // TOC drawer — absolute 贴容器左，关闭时不占位
                if .show_toc {
                    col {
                        style: "absolute inset-y-0 left-0 z-30 w-64 border-r border-border bg-card p-3 gap-1 overflow-y-auto shadow-lg"
                        text "Contents" { style: "text-xs font-semibold text-muted-foreground uppercase tracking-wide px-2 py-1 shrink-0" }
                        for ch in .chapters {
                            row {
                                onclick: .SelectChapter(ch.number)
                                style: ["items-center gap-2 px-2 py-2 rounded-lg cursor-pointer transition-colors",
                                    if ch.number == .chapter_num {
                                        "bg-primary/15 text-foreground"
                                    } else {
                                        "hover:bg-accent text-foreground"
                                    }]
                                text f"${ch.number}" { style: "text-xs font-mono text-muted-foreground w-6 shrink-0" }
                                text ch.title { style: "text-sm truncate flex-1" }
                            }
                        }
                    }
                }
                // 搜索抽屉（READER-002 T-01）— absolute 贴容器右
                if .show_search {
                    col {
                        style: "absolute inset-y-0 right-0 z-30 w-80 border-l border-border bg-card p-3 gap-2 overflow-y-auto shadow-lg"
                        text "本书内搜索" { style: "text-xs font-semibold text-muted-foreground uppercase tracking-wide px-2 py-1 shrink-0" }
                        input {
                            value: .search_q
                            oninput: .NoOp
                            onenter: .DoSearch
                            placeholder: "输入关键词（精确子串）"
                            style: "w-full px-3 py-2 bg-background border border-border rounded-lg text-sm text-foreground outline-none focus:border-primary"
                        }
                        button {
                            onclick: .DoSearch
                            style: "px-3 py-1.5 text-sm bg-primary text-primary-foreground rounded-lg hover:bg-primary/90 transition-colors"
                            text "搜索" {}
                        }
                        if .search_note != "" {
                            text .search_note { style: "text-xs text-muted-foreground px-2" }
                        }
                        for r in .search_results {
                            col {
                                onclick: .JumpTo(r.chapter_number, r.para_idx)
                                style: "items-start gap-1 px-2 py-2 rounded-lg cursor-pointer hover:bg-accent transition-colors"
                                text f"第 ${r.chapter_number} 章 · ¶${r.para_idx}" { style: "text-xs text-muted-foreground font-mono" }
                                text r.para_text { style: "text-sm text-foreground truncate w-full" }
                            }
                        }
                        if .search_total > 0 {
                            text f"共 ${.search_total} 处（点击跳转）" { style: "text-xs text-muted-foreground px-2 py-1" }
                        }
                    }
                }
                // 注释抽屉（READER-002 T-03/T-05）— absolute 贴容器右
                if .show_anns {
                    col {
                        style: "absolute inset-y-0 right-0 z-30 w-80 border-l border-border bg-card p-3 gap-2 overflow-y-auto shadow-lg"
                        text "注释与书签" { style: "text-xs font-semibold text-muted-foreground uppercase tracking-wide px-2 py-1 shrink-0" }
                        if .ann_note != "" {
                            text .ann_note { style: "text-xs text-muted-foreground px-2" }
                        }
                        if .anns.len() == 0 {
                            text "（暂无注释——点击段落后再点「＋ 注释」创建）" { style: "text-sm text-muted-foreground px-2 py-2" }
                        } else {
                            for a in .anns {
                                col {
                                    style: "items-start gap-1 px-2 py-2 rounded-lg border border-border/60"
                                    row {
                                        onclick: .JumpTo(a.chapter_number, a.para_idx)
                                        style: "items-center gap-2 cursor-pointer w-full"
                                        text a.kind { style: "text-xs font-mono text-primary shrink-0" }
                                        text f"第 ${a.chapter_number} 章 · ¶${a.para_idx}" { style: "text-xs text-muted-foreground font-mono flex-1" }
                                        if a.bad == 1 {
                                            text "需重定位" { style: "text-xs text-destructive shrink-0" }
                                        }
                                    }
                                    if a.quote != "" {
                                        text a.quote { style: "text-sm text-foreground truncate w-full" }
                                    }
                                    if a.comment != "" {
                                        text a.comment { style: "text-xs text-muted-foreground truncate w-full" }
                                    }
                                    row {
                                        style: "gap-2"
                                        button {
                                            onclick: .AnnEdit(a.annotation_id)
                                            style: "px-2 py-1 text-xs text-foreground hover:bg-accent rounded transition-colors"
                                            text "编辑" {}
                                        }
                                        button {
                                            onclick: .AnnDelete(a.annotation_id)
                                            style: "px-2 py-1 text-xs text-destructive hover:bg-destructive/10 rounded transition-colors"
                                            text "删除" {}
                                        }
                                    }
                                }
                            }
                        }
                        button {
                            onclick: .DoExport
                            style: "px-3 py-1.5 text-sm bg-primary text-primary-foreground rounded-lg hover:bg-primary/90 transition-colors shrink-0"
                            text "导出 Markdown" {}
                        }
                    }
                }
                // 排版抽屉（READER-002 T-01）— absolute 贴容器右
                if .show_style {
                    col {
                        style: "absolute inset-y-0 right-0 z-30 w-64 border-l border-border bg-card p-3 gap-3 overflow-y-auto shadow-lg"
                        text "排版" { style: "text-xs font-semibold text-muted-foreground uppercase tracking-wide px-2 py-1 shrink-0" }
                        text "栏宽" { style: "text-sm text-foreground px-2" }
                        row {
                            style: "gap-2 px-2"
                            button {
                                onclick: .SetLayout("narrow")
                                style: ["px-3 py-1.5 text-sm rounded-lg transition-colors",
                                    if .layout == "narrow" {
                                        "bg-primary text-primary-foreground"
                                    } else {
                                        "text-foreground hover:bg-accent"
                                    }]
                                text "窄" {}
                            }
                            button {
                                onclick: .SetLayout("medium")
                                style: ["px-3 py-1.5 text-sm rounded-lg transition-colors",
                                    if .layout == "medium" {
                                        "bg-primary text-primary-foreground"
                                    } else {
                                        "text-foreground hover:bg-accent"
                                    }]
                                text "中" {}
                            }
                            button {
                                onclick: .SetLayout("wide")
                                style: ["px-3 py-1.5 text-sm rounded-lg transition-colors",
                                    if .layout == "wide" {
                                        "bg-primary text-primary-foreground"
                                    } else {
                                        "text-foreground hover:bg-accent"
                                    }]
                                text "宽" {}
                            }
                        }
                        text "阅读主题" { style: "text-sm text-foreground px-2" }
                        row {
                            style: "gap-2 px-2"
                            button {
                                onclick: .SetTheme("light")
                                style: ["px-3 py-1.5 text-sm rounded-lg transition-colors",
                                    if .theme == "light" {
                                        "bg-primary text-primary-foreground"
                                    } else {
                                        "text-foreground hover:bg-accent"
                                    }]
                                text "亮" {}
                            }
                            button {
                                onclick: .SetTheme("sepia")
                                style: ["px-3 py-1.5 text-sm rounded-lg transition-colors",
                                    if .theme == "sepia" {
                                        "bg-primary text-primary-foreground"
                                    } else {
                                        "text-foreground hover:bg-accent"
                                    }]
                                text "米" {}
                            }
                            button {
                                onclick: .SetTheme("dark")
                                style: ["px-3 py-1.5 text-sm rounded-lg transition-colors",
                                    if .theme == "dark" {
                                        "bg-primary text-primary-foreground"
                                    } else {
                                        "text-foreground hover:bg-accent"
                                    }]
                                text "暗" {}
                            }
                        }
                        text "字号与行距沿顶栏书内偏好（保存于阅读状态）" { style: "text-xs text-muted-foreground px-2" }
                    }
                }
                // Reading column — T-25：scroll-pane（PLAN-656 controller）；
                // 恢复定位由段落 scroll-anchor + scroll_to_child 入队完成。
                // READER-002：栏宽/主题由本地排版偏好承载（沉浸面）。
                scroll-pane (controller: .rsc, style: ["flex-1 min-h-0 w-full", .theme_body_cls]) {
                    if .loaded {
                        col {
                            style: [.layout_col_cls, "mx-auto px-6 py-10 gap-6"]
                            h1 .chapter.title { style: "text-2xl font-bold text-foreground" }
                            if .is_real {
                                if .restored_note != "" {
                                    col {
                                        style: "px-4 py-2 rounded-lg bg-primary/10 text-sm text-foreground"
                                        text .restored_note {}
                                    }
                                }
                                if .paragraphs.len() == 0 {
                                    text "（本章无内容）" { style: .body_style }
                                } else {
                                    for p in .paragraphs {
                                        col {
                                            scroll-anchor: p.key
                                            style: "items-stretch gap-0"
                                            col {
                                                onclick: .TapParagraph(p.idx)
                                                style: ["px-3 py-2 rounded-lg cursor-pointer transition-colors border-l-4",
                                                    if p.idx == .cur_paragraph {
                                                        .para_marked_cls
                                                    } else {
                                                        .para_idle_cls
                                                    }]
                                                row {
                                                    style: "items-center gap-2"
                                                    text f"¶${p.idx}" { style: "text-xs text-muted-foreground/60 font-mono shrink-0" }
                                                    if p.mark_n > 0 {
                                                        text f"✎ ${p.mark_n}" { style: "text-xs text-primary font-mono shrink-0" }
                                                    }
                                                    if p.mark_bad > 0 {
                                                        text "需重定位" { style: "text-xs text-destructive shrink-0" }
                                                    }
                                                }
                                                text p.text { style: .body_style }
                                            }
                                            // 当前段注释动作行（＋ 注释入口；
                                            // 不改变点段=记位置的既有行为）
                                            if p.idx == .cur_paragraph {
                                                if .is_real {
                                                    row {
                                                        style: "gap-2 px-3 py-1"
                                                        button {
                                                            onclick: .OpenAnnDialog(p.idx)
                                                            style: "px-2 py-1 text-xs bg-primary/10 text-primary rounded hover:bg-primary/20 transition-colors"
                                                            text "＋ 注释/书签" {}
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            } else {
                                text .chapter.body { style: .body_style }
                            }
                        }
                    } else {
                        col {
                            style: "items-center justify-center py-20 text-muted-foreground"
                            text "Loading…" {}
                        }
                    }
                }
            }

            // 注释对话框（READER-002 T-03）——底部浮层；quote/occurrence/
            // comment/tags 直传顶层字段（多字节安全），锚核验在服务端。
            if .ann_dialog {
                col {
                    style: "absolute inset-x-0 bottom-0 z-40 bg-card border-t border-border p-4 gap-2 shadow-2xl max-h-[60%] overflow-y-auto"
                    row {
                        style: "items-center gap-2"
                        text .ann_dlg_title { style: "text-sm font-semibold text-foreground flex-1" }
                        button {
                            onclick: .AnnCancel
                            style: "px-2 py-1 text-sm text-muted-foreground hover:bg-accent rounded transition-colors"
                            text "✕" {}
                        }
                    }
                    row {
                        style: "gap-2"
                        button {
                            onclick: .AnnKind("highlight")
                            style: ["px-3 py-1.5 text-sm rounded-lg transition-colors",
                                if .ann_kind == "highlight" {
                                    "bg-primary text-primary-foreground"
                                } else {
                                    "text-foreground hover:bg-accent"
                                }]
                            text "高亮" {}
                        }
                        button {
                            onclick: .AnnKind("comment")
                            style: ["px-3 py-1.5 text-sm rounded-lg transition-colors",
                                if .ann_kind == "comment" {
                                    "bg-primary text-primary-foreground"
                                } else {
                                    "text-foreground hover:bg-accent"
                                }]
                            text "注释" {}
                        }
                        button {
                            onclick: .AnnKind("bookmark")
                            style: ["px-3 py-1.5 text-sm rounded-lg transition-colors",
                                if .ann_kind == "bookmark" {
                                    "bg-primary text-primary-foreground"
                                } else {
                                    "text-foreground hover:bg-accent"
                                }]
                            text "书签" {}
                        }
                    }
                    text "摘录（逐字锚；可截取子串）" { style: "text-xs text-muted-foreground" }
                    input {
                        value: .ann_quote
                        oninput: .NoOp
                        placeholder: "摘录原文"
                        style: "w-full px-3 py-2 bg-background border border-border rounded-lg text-sm text-foreground outline-none focus:border-primary"
                    }
                    row {
                        style: "gap-2 items-center"
                        text "第" { style: "text-sm text-foreground" }
                        input {
                            value: .ann_occ_str
                            oninput: .NoOp
                            style: "w-16 px-2 py-1.5 bg-background border border-border rounded-lg text-sm text-foreground outline-none focus:border-primary"
                        }
                        text "处（同段重复句序号）" { style: "text-xs text-muted-foreground" }
                    }
                    text "批注" { style: "text-xs text-muted-foreground" }
                    textarea {
                        value: .ann_comment
                        oninput: .NoOp
                        height: 64
                        placeholder: "写点什么（可空）"
                        style: "w-full px-3 py-2 bg-background border border-border rounded-lg text-sm text-foreground outline-none focus:border-primary"
                    }
                    text "标签（逗号分隔）" { style: "text-xs text-muted-foreground" }
                    input {
                        value: .ann_tags
                        oninput: .NoOp
                        placeholder: "例：重点, 待查"
                        style: "w-full px-3 py-2 bg-background border border-border rounded-lg text-sm text-foreground outline-none focus:border-primary"
                    }
                    if .ann_dlg_note != "" {
                        text .ann_dlg_note { style: "text-xs text-destructive" }
                    }
                    button {
                        onclick: .AnnSubmit
                        style: "px-4 py-2 text-sm bg-primary text-primary-foreground rounded-lg hover:bg-primary/90 transition-colors"
                        text "保存注释" {}
                    }
                }
            }

            // Bottom bar: prev / progress / next
            row {
                style: "h-14 border-t border-border bg-card items-center px-4 gap-4 shrink-0"
                button {
                    onclick: .PrevChapter
                    style: page_btn
                    disabled: .chapter_num <= 1
                    text "← Prev" {}
                }
                col {
                    style: "flex-1 gap-1"
                    progress {
                        value: .progress_pct
                        max: 100
                        style: "w-full"
                    }
                    row {
                        style: "justify-between text-xs text-muted-foreground"
                        text f"Chapter ${.chapter_num} of ${.chapter_count}" {}
                        text .progress_label {}
                    }
                }
                button {
                    onclick: .NextChapter
                    style: page_btn
                    disabled: .chapter_num >= .chapter_count
                    text "Next →" {}
                }
            }
        }
    }

    on {
        .Init -> {
            // Route params are strings — coerce to int so arithmetic like
            // .chapter_num + 1 doesn't do string concat ("1" + 1 = "11").
            .route_id = router.param("id")
            .book_id = router.param("id").to_int()
            .chapter_num = router.param("ch").to_int()
            // 真实书探测：/api/library/books/:id 命中（book_id 非空）即真实书
            let probe = parse_lib(Http.get_json("/api/library/books/" + .route_id))
            if probe != null {
                let pb str = "" + probe.book_id
                if pb != "" {
                    if pb != "undefined" {
                        .is_real = true
                    }
                }
            }
            if .is_real {
                // F-05 修复：章节号一律以路由为准（显式入口不被旧状态
                // 覆盖）；旧状态只提供排版设置与段级恢复判定。
                // var 而非 let：F-14 身份守卫在 book_id 失配时重赋 null
                //（VM 轨编译器强制 let 不可变——重赋使整个 Init 编译失败
                // 且被静默丢弃，即 N-r8-2 根因；诊断面修复后现形）
                var pr = parse_lib(Http.get_json("/api/library/progress?book_id=" + .route_id))
                // T-25：本页待恢复目标段（行号），锚点入队后即消费
                var restore_target int = -1
                if pr != null {
                    let pf str = "" + pr.font_size
                    if pf != "" {
                        .font_size = pf
                    }
                    let lh str = "" + pr.line_height
                    if lh != "" {
                        .line_height = lh
                    }
                    // READER-002 A：可选排版偏好（缺位 = 默认；枚举外忽略）
                    var ly str = ""
                    try {
                        ly = "" + pr.layout
                    } catch {
                        ly = ""
                    }
                    if ly == "narrow" {
                        .layout = "narrow"
                    }
                    if ly == "wide" {
                        .layout = "wide"
                    }
                    if ly == "medium" {
                        .layout = "medium"
                    }
                    var th str = ""
                    try {
                        th = "" + pr.theme
                    } catch {
                        th = ""
                    }
                    if th == "sepia" {
                        .theme = "sepia"
                    }
                    if th == "dark" {
                        .theme = "dark"
                    }
                    if th == "light" {
                        .theme = "light"
                    }
                }
                let toc = parse_lib(Http.get_json("/api/library/books/" + .route_id + "/toc"))
                if toc != null {
                    .chapters = toc
                    .chapter_count = toc.len()
                }
                if .chapter_count < 1 {
                    .chapter_count = 1
                }
                if .chapter_num < 1 {
                    .chapter_num = 1
                }
                if .chapter_num > .chapter_count {
                    .chapter_num = .chapter_count
                }
                router.push("/book/" + .route_id + "/chapter/" + .chapter_num.to_string())
                let chv = parse_lib(Http.get_json("/api/library/chapter?book_id=" + .route_id + "&number=" + .chapter_num.to_string()))
                if chv != null {
                    .chapter = chv
                }
                // READER-002 注释装载规范序列（变更/换章后同式）
                .ann_resp = Http.get_json("/api/library/annotations?book_id=" + .route_id)
                .anns = enrich_ann(.ann_resp, "" + .chapter.body, .chapter_num)
                .paragraphs = merge_marks("" + .chapter.body, .ann_resp, .chapter_num)
                .cur_paragraph = -1
                .cur_para_text = ""
                // 恢复段标记：仅当保存章节 == 当前章节；内容锚点逐字验证
                // （Phase 3 F-08）——存储态 para_text 与当前段落文本相等才
                // 标记「已恢复」；缺锚点（旧 sig1 态）/失配/越界分别诚实
                // 提示，绝不假恢复
                if pr != null {
                    // F-14 前端身份守卫：存储态 book_id 必须与路由一致
                    var pr_bid str = ""
                    try {
                        pr_bid = "" + pr.book_id
                    } catch {
                        pr_bid = ""
                    }
                    if pr_bid != .route_id {
                        pr = null
                    }
                }
                if pr != null {
                    let pc2 int = pr.chapter_number
                    if pc2 == .chapter_num {
                        let pi int = pr.paragraph_index
                        if pi >= 0 {
                            var matched bool = false
                            var i int = 0
                            while i < .paragraphs.len() {
                                let p = .paragraphs[i]
                                if p.idx == pi {
                                    matched = true
                                    // F-13 修正：缺失字段与合法正文必须区分。
                                    // `!= nil` 编译为宽松 `!= null`（Vue 覆盖
                                    // undefined；VM 缺字段 raise→catch）——缺失
                                    // →空串，合法正文（含字面量 "undefined"）
                                    // 原样保留参与逐字核对。
                                    var saved_text str = ""
                                    try {
                                        let v = pr.para_text
                                        if v != nil {
                                            saved_text = "" + v
                                        }
                                    } catch {
                                        saved_text = ""
                                    }
                                    if saved_text == "" {
                                        .restored_note = "上次保存的位置缺少内容锚点，请重新点选段落"
                                    } else {
                                        if saved_text == ("" + p.text) {
                                            .cur_paragraph = pi
                                            .cur_para_text = "" + p.text
                                            .restored_note = "已恢复上次位置（点任意段落可更新）"
                                            restore_target = pi
                                        } else {
                                            .restored_note = "上次保存的段落内容已变化，请重新点选位置"
                                        }
                                    }
                                    i = .paragraphs.len()
                                }
                                i = i + 1
                            }
                            if !matched {
                                .restored_note = "上次保存的段落在本章已不存在，请重新点选位置"
                            }
                        }
                    }
                }
                // T-25 恢复定位（PLAN-781 锚点）：.loaded 置真后经一次 await
                // 让出（Vue 在 await 边界刷新 DOM，段落此时真正入树；VM 轨
                // intent 队列本就渲染后排空），再按稳定子 key 入队元素级定
                // 位——nearest 公式按真实布局顶/底对齐入 pane（双轨同源）。
                // 入队回执非完成证明（完成 oracle = 真实 offset 变化 + 目标
                // 正面积交集，由 V-20 测试门承担）；入队期 error 诚实提示。
                .loaded = true
                if restore_target >= 0 {
                    let warm = parse_lib(Http.get_json("/api/library/progress?book_id=" + .route_id))
                    let rk str = "p" + restore_target.to_string()
                    let rr str = scroll_to_child(.rsc, rk)
                    if rr.find("error:") == 0 {
                        .restored_note = .restored_note + "；自动定位失败，请手动滚动"
                    }
                }
                let total int = .chapter_count
                if total > 0 {
                    .progress_pct = pct_of(.chapter_num, total)
                }
                .progress_label = pct1(.progress_pct) + "%"
            } else {
                .chapter = Http.get_json("/api/chapters?book_id=" + .book_id.to_string() + "&number=" + .chapter_num.to_string())
                .chapters = Http.get_json("/api/books/" + .book_id.to_string() + "/chapters")
                let book = Http.get_json("/api/books/" + .book_id.to_string())
                if book != null {
                    .chapter_count = book.chapter_count
                }
                let total_demo int = .chapter_count
                if total_demo > 0 {
                    .progress_pct = pct_of(.chapter_num, total_demo)
                }
                .progress_label = pct1(.progress_pct) + "%"
            }
            // 排版偏好合成下沉文件级 fn（等价语义）；VM 轨大 handler 内联
            // storage 尾段触发降档投毒（N-r8-2a），此重构为其绕避之一
            .font_size = fill_pref(.font_size, "br-font-size", "medium")
            .line_height = fill_pref(.line_height, "br-line-height", "comfy")
            .body_style = body_style_of(.font_size, .line_height)
            // READER-002 派生样式刷新（SetLayout/SetTheme 同式）
            .theme_body_cls = theme_body_of(.theme)
            .theme_hover_cls = theme_hover_of(.theme)
            .theme_marked_cls = theme_marked_of(.theme)
            .para_marked_cls = theme_marked_of(.theme) + " border-primary para-marked"
            .para_idle_cls = "border-transparent " + theme_hover_of(.theme)
            .layout_col_cls = layout_cls_of(.layout)
            if !.is_real {
                .loaded = true
                store.SetProgress(.book_id, .progress_pct)
            }
        }
        .Back -> { router.push("/book/" + .route_id) }
        .ToggleToc -> { .show_toc = !.show_toc }
        .SelectChapter(n int) -> {
            .show_toc = false
            if n != .chapter_num {
                .chapter_num = n
                router.push("/book/" + .route_id + "/chapter/" + .chapter_num.to_string())
                if .is_real {
                    let chv = parse_lib(Http.get_json("/api/library/chapter?book_id=" + .route_id + "&number=" + .chapter_num.to_string()))
                    if chv != null {
                        .chapter = chv
                    }
// READER-002 注释装载规范序列（变更/换章后同式）
                    .ann_resp = Http.get_json("/api/library/annotations?book_id=" + .route_id)
                    .anns = enrich_ann(.ann_resp, "" + .chapter.body, .chapter_num)
                    .paragraphs = merge_marks("" + .chapter.body, .ann_resp, .chapter_num)
                    .cur_paragraph = -1
                    .cur_para_text = ""
                } else {
                    .chapter = Http.get_json("/api/chapters?book_id=" + .book_id.to_string() + "&number=" + .chapter_num.to_string())
                }
                let total int = .chapter_count
                if total > 0 {
                    .progress_pct = pct_of(.chapter_num, total)
                }
                .progress_label = pct1(.progress_pct) + "%"
                if .is_real {
                    let pl str = real_payload(.route_id, .chapter_num, .cur_paragraph, para_hash(.cur_para_text), .font_size, .line_height, .layout, .theme)
                    var save_ok bool = false
                    try {
                        let resp str = Http.post("/api/library/progress", { book_id: .route_id, payload: pl, para_text: "" })
                        if resp.find("\"ok\":true") >= 0 {
                            save_ok = true
                        }
                    } catch { }
                    if !save_ok {
                        .restored_note = "位置保存失败：后端未确认，请重试"
                    }
                } else {
                    store.SetProgress(.book_id, .progress_pct)
                }
            }
        }
        .PrevChapter -> {
            if .chapter_num > 1 {
                .chapter_num = .chapter_num - 1
                router.push("/book/" + .route_id + "/chapter/" + .chapter_num.to_string())
                if .is_real {
                    let chv = parse_lib(Http.get_json("/api/library/chapter?book_id=" + .route_id + "&number=" + .chapter_num.to_string()))
                    if chv != null {
                        .chapter = chv
                    }
// READER-002 注释装载规范序列（变更/换章后同式）
                    .ann_resp = Http.get_json("/api/library/annotations?book_id=" + .route_id)
                    .anns = enrich_ann(.ann_resp, "" + .chapter.body, .chapter_num)
                    .paragraphs = merge_marks("" + .chapter.body, .ann_resp, .chapter_num)
                    .cur_paragraph = -1
                    .cur_para_text = ""
                } else {
                    .chapter = Http.get_json("/api/chapters?book_id=" + .book_id.to_string() + "&number=" + .chapter_num.to_string())
                }
                let total int = .chapter_count
                if total > 0 {
                    .progress_pct = pct_of(.chapter_num, total)
                }
                .progress_label = pct1(.progress_pct) + "%"
                if .is_real {
                    let pl str = real_payload(.route_id, .chapter_num, .cur_paragraph, para_hash(.cur_para_text), .font_size, .line_height, .layout, .theme)
                    var save_ok bool = false
                    try {
                        let resp str = Http.post("/api/library/progress", { book_id: .route_id, payload: pl, para_text: "" })
                        if resp.find("\"ok\":true") >= 0 {
                            save_ok = true
                        }
                    } catch { }
                    if !save_ok {
                        .restored_note = "位置保存失败：后端未确认，请重试"
                    }
                } else {
                    store.SetProgress(.book_id, .progress_pct)
                }
            }
        }
        .NextChapter -> {
            if .chapter_num < .chapter_count {
                .chapter_num = .chapter_num + 1
                router.push("/book/" + .route_id + "/chapter/" + .chapter_num.to_string())
                if .is_real {
                    let chv = parse_lib(Http.get_json("/api/library/chapter?book_id=" + .route_id + "&number=" + .chapter_num.to_string()))
                    if chv != null {
                        .chapter = chv
                    }
// READER-002 注释装载规范序列（变更/换章后同式）
                    .ann_resp = Http.get_json("/api/library/annotations?book_id=" + .route_id)
                    .anns = enrich_ann(.ann_resp, "" + .chapter.body, .chapter_num)
                    .paragraphs = merge_marks("" + .chapter.body, .ann_resp, .chapter_num)
                    .cur_paragraph = -1
                    .cur_para_text = ""
                } else {
                    .chapter = Http.get_json("/api/chapters?book_id=" + .book_id.to_string() + "&number=" + .chapter_num.to_string())
                }
                let total int = .chapter_count
                if total > 0 {
                    .progress_pct = pct_of(.chapter_num, total)
                }
                .progress_label = pct1(.progress_pct) + "%"
                if .is_real {
                    let pl str = real_payload(.route_id, .chapter_num, .cur_paragraph, para_hash(.cur_para_text), .font_size, .line_height, .layout, .theme)
                    var save_ok bool = false
                    try {
                        let resp str = Http.post("/api/library/progress", { book_id: .route_id, payload: pl, para_text: "" })
                        if resp.find("\"ok\":true") >= 0 {
                            save_ok = true
                        }
                    } catch { }
                    if !save_ok {
                        .restored_note = "位置保存失败：后端未确认，请重试"
                    }
                } else {
                    store.SetProgress(.book_id, .progress_pct)
                }
            }
        }
        // Locator v1：tap 段落即记录（段 index + 段文本指纹），幂等保存。
        // F-05 修复：保存成功必须由后端响应确认；失败诚实提示可重试，
        // 不再吞异常后无条件显示"已记录"。
        .TapParagraph(idx int) -> {
            .cur_paragraph = idx
            var i int = 0
            while i < .paragraphs.len() {
                let p = .paragraphs[i]
                if p.idx == idx {
                    .cur_para_text = "" + p.text
                    i = .paragraphs.len()
                }
                i = i + 1
            }
            let ph str = para_hash(.cur_para_text)
            let pl str = real_payload(.route_id, .chapter_num, .cur_paragraph, ph, .font_size, .line_height, .layout, .theme)
            var save_ok bool = false
            try {
                let resp str = Http.post("/api/library/progress", { book_id: .route_id, payload: pl, para_text: .cur_para_text })
                if resp.find("\"ok\":true") >= 0 {
                    save_ok = true
                }
            } catch { }
            if save_ok {
                .restored_note = f"已记录位置：第 ${idx} 段"
            } else {
                .restored_note = "位置保存失败：后端未确认，请重试"
            }
        }
        // ── READER-002 阶段A handlers（T-01/T-03/T-05）──
        .NoOp -> { }
        .ToggleSearch -> {
            .show_search = !.show_search
            .show_anns = false
            .show_style = false
            .search_note = ""
        }
        // 搜索：widget 级触发（onenter/按钮），无全局键盘 handler——
        // 不抢输入框/IME 事件（T-00 裁决）。结果由后端段粒度精确子串
        // 返回；点击结果走 JumpTo（跨章先换章再锚点定位）。
        .DoSearch -> {
            .search_note = "搜索中…"
            var resp str = ""
            try {
                resp = Http.post("/api/library/search", { book_id: .route_id, query: .search_q })
            } catch {
                resp = ""
            }
            .search_results = []
            .search_total = 0
            if resp == "" {
                .search_note = "搜索失败：后端未响应，请重试"
            } else {
                if resp.find("\"ok\":true") < 0 {
                    var msg str = "搜索被拒绝"
                    try {
                        let e = json.parse(resp)
                        msg = "" + e.message
                    } catch {
                        msg = "搜索被拒绝"
                    }
                    .search_note = msg
                } else {
                    var okp bool = false
                    var wrap = null
                    try {
                        wrap = json.parse(resp)
                        okp = true
                    } catch {
                        okp = false
                    }
                    if okp {
                        .search_results = wrap.results
                        .search_total = wrap.total
                        var tt int = wrap.total
                        if tt == 0 {
                            .search_note = "无结果（精确子串匹配）"
                        } else {
                            .search_note = ""
                        }
                    } else {
                        .search_note = "搜索响应解析失败"
                    }
                }
            }
        }
        .ToggleAnns -> {
            .show_anns = !.show_anns
            .show_search = false
            .show_style = false
            .ann_note = ""
        }
        .ToggleStyle -> {
            .show_style = !.show_style
            .show_search = false
            .show_anns = false
        }
        // 排版偏好：立即生效 + 随阅读状态持久化（layout/theme 可选键，
        // 与 001 的 font/line 同一保存面；失败诚实提示，不假保存）。
        .SetLayout(l str) -> {
            if l == "narrow" {
                .layout = "narrow"
            }
            if l == "medium" {
                .layout = "medium"
            }
            if l == "wide" {
                .layout = "wide"
            }
            .layout_col_cls = layout_cls_of(.layout)
            if .is_real {
                let ph str = para_hash(.cur_para_text)
                let pl str = real_payload(.route_id, .chapter_num, .cur_paragraph, ph, .font_size, .line_height, .layout, .theme)
                var save_ok bool = false
                try {
                    let resp str = Http.post("/api/library/progress", { book_id: .route_id, payload: pl, para_text: .cur_para_text })
                    if resp.find("\"ok\":true") >= 0 {
                        save_ok = true
                    }
                } catch { }
                if !save_ok {
                    .restored_note = "排版保存失败：后端未确认，请重试"
                }
            }
        }
        .SetTheme(t str) -> {
            if t == "light" {
                .theme = "light"
            }
            if t == "sepia" {
                .theme = "sepia"
            }
            if t == "dark" {
                .theme = "dark"
            }
            .theme_body_cls = theme_body_of(.theme)
            .theme_hover_cls = theme_hover_of(.theme)
            .theme_marked_cls = theme_marked_of(.theme)
            .para_marked_cls = theme_marked_of(.theme) + " border-primary para-marked"
            .para_idle_cls = "border-transparent " + theme_hover_of(.theme)
            if .is_real {
                let ph str = para_hash(.cur_para_text)
                let pl str = real_payload(.route_id, .chapter_num, .cur_paragraph, ph, .font_size, .line_height, .layout, .theme)
                var save_ok bool = false
                try {
                    let resp str = Http.post("/api/library/progress", { book_id: .route_id, payload: pl, para_text: .cur_para_text })
                    if resp.find("\"ok\":true") >= 0 {
                        save_ok = true
                    }
                } catch { }
                if !save_ok {
                    .restored_note = "排版保存失败：后端未确认，请重试"
                }
            }
        }
        // 搜索结果/注释回访跳转：同章直接定位；跨章先走章节装载序列再
        // 定位。定位沿用 PLAN-781 锚柄（scroll_to_child by p<idx>），一次
        // HTTP 让出等待渲染（与 Init 恢复定位同式）；入队回执非完成证明。
        .JumpTo(ch int, pi int) -> {
            .show_search = false
            .show_anns = false
            if ch != .chapter_num {
                if ch >= 1 {
                    if ch <= .chapter_count {
                        .chapter_num = ch
                        router.push("/book/" + .route_id + "/chapter/" + .chapter_num.to_string())
                        let chv = parse_lib(Http.get_json("/api/library/chapter?book_id=" + .route_id + "&number=" + .chapter_num.to_string()))
                        if chv != null {
                            .chapter = chv
                        }
                        .ann_resp = Http.get_json("/api/library/annotations?book_id=" + .route_id)
                        .anns = enrich_ann(.ann_resp, "" + .chapter.body, .chapter_num)
                        .paragraphs = merge_marks("" + .chapter.body, .ann_resp, .chapter_num)
                        let total int = .chapter_count
                        if total > 0 {
                            .progress_pct = pct_of(.chapter_num, total)
                        }
                        .progress_label = pct1(.progress_pct) + "%"
                    }
                }
            }
            var found bool = false
            var i int = 0
            while i < .paragraphs.len() {
                let p = .paragraphs[i]
                if p.idx == pi {
                    found = true
                    .cur_para_text = "" + p.text
                    i = .paragraphs.len()
                }
                i = i + 1
            }
            if found {
                .cur_paragraph = pi
                let warm = parse_lib(Http.get_json("/api/library/progress?book_id=" + .route_id))
                let rr str = scroll_to_child(.rsc, "p" + pi.to_string())
                if rr.find("error:") == 0 {
                    .restored_note = "自动定位失败，请手动滚动"
                } else {
                    .restored_note = f"已跳转：第 ${ch} 章 ¶${pi}"
                }
                let ph str = para_hash(.cur_para_text)
                let pl str = real_payload(.route_id, .chapter_num, .cur_paragraph, ph, .font_size, .line_height, .layout, .theme)
                try {
                    Http.post("/api/library/progress", { book_id: .route_id, payload: pl, para_text: .cur_para_text })
                } catch { }
            } else {
                .restored_note = "目标段在本章不存在（内容可能已变化）"
            }
        }
        .AnnDelete(aid str) -> {
            var resp str = ""
            try {
                resp = Http.post("/api/library/annotations", { book_id: .route_id, op: "delete", annotation_id: aid, kind: "", chapter_number: 0, para_idx: 0, occurrence: 0, comment: "", tags_json: "[]", quote: "" })
            } catch {
                resp = ""
            }
            if resp.find("\"ok\":true") >= 0 {
                .ann_resp = Http.get_json("/api/library/annotations?book_id=" + .route_id)
                .anns = enrich_ann(.ann_resp, "" + .chapter.body, .chapter_num)
                .paragraphs = merge_marks("" + .chapter.body, .ann_resp, .chapter_num)
                .ann_note = "已删除"
            } else {
                var msg str = "删除失败"
                try {
                    let e = json.parse(resp)
                    msg = "" + e.message
                } catch {
                    msg = "删除失败：后端未响应"
                }
                .ann_note = msg
            }
        }
        // 注释对话框：预填整段文本（子串可编辑截取）；出现序默认 1。
        // 点段=记位置行为不变；＋注释入口在当前段动作行。
        .OpenAnnDialog(idx int) -> {
            .ann_dialog = true
            .ann_edit_id = ""
            .ann_dlg_title = "添加注释"
            .ann_ch = .chapter_num
            .ann_pi = idx
            var i int = 0
            while i < .paragraphs.len() {
                let p = .paragraphs[i]
                if p.idx == idx {
                    .ann_quote = "" + p.text
                    i = .paragraphs.len()
                }
                i = i + 1
            }
            .ann_occ_str = "1"
            .ann_comment = ""
            .ann_tags = ""
            .ann_kind = "highlight"
            .ann_dlg_note = ""
        }
        .AnnEdit(aid str) -> {
            var i int = 0
            while i < .anns.len() {
                let a = .anns[i]
                let tid str = "" + a.annotation_id
                if tid == aid {
                    .ann_dialog = true
                    .ann_edit_id = aid
                    .ann_dlg_title = "编辑注释"
                    .ann_ch = a.chapter_number
                    .ann_pi = a.para_idx
                    .ann_quote = "" + a.quote
                    .ann_occ_str = "" + a.occurrence
                    .ann_comment = "" + a.comment
                    .ann_kind = "" + a.kind
                    i = .anns.len()
                }
                i = i + 1
            }
            .ann_tags = ""
            .ann_dlg_note = ""
        }
        .AnnKind(k str) -> {
            if k == "highlight" {
                .ann_kind = "highlight"
            }
            if k == "comment" {
                .ann_kind = "comment"
            }
            if k == "bookmark" {
                .ann_kind = "bookmark"
            }
        }
        .AnnCancel -> {
            .ann_dialog = false
            .ann_edit_id = ""
            .ann_dlg_note = ""
        }
        // 提交：quote/comment/tags 走顶层字段直传（多字节安全，F-08 同源）；
        // 锚核验在服务端（quote 非子串/出现序不足诚实拒绝——对话框回显
        // 错误消息，不假保存）。前置校验失败同样诚实提示。
        .AnnSubmit -> {
            let occv int = .ann_occ_str.trim().to_int()
            var pre_ok bool = true
            if occv < 1 {
                pre_ok = false
                .ann_dlg_note = "出现序需为正整数"
            }
            if pre_ok {
                if .ann_kind != "bookmark" {
                    if .ann_quote.trim() == "" {
                        pre_ok = false
                        .ann_dlg_note = "摘录不能为空（逐字锚必填）"
                    }
                }
            }
            if pre_ok {
                let tj str = tags_json_of(.ann_tags)
                var op str = "create"
                if .ann_edit_id != "" {
                    op = "update"
                }
                var resp str = ""
                try {
                    resp = Http.post("/api/library/annotations", { book_id: .route_id, op: op, annotation_id: .ann_edit_id, kind: .ann_kind, chapter_number: .ann_ch, para_idx: .ann_pi, occurrence: occv, comment: .ann_comment, tags_json: tj, quote: .ann_quote })
                } catch {
                    resp = ""
                }
                if resp.find("\"ok\":true") >= 0 {
                    .ann_dialog = false
                    .ann_edit_id = ""
                    .ann_resp = Http.get_json("/api/library/annotations?book_id=" + .route_id)
                    .anns = enrich_ann(.ann_resp, "" + .chapter.body, .chapter_num)
                    .paragraphs = merge_marks("" + .chapter.body, .ann_resp, .chapter_num)
                    .show_anns = true
                    .ann_note = "已保存"
                } else {
                    var msg str = "保存失败"
                    try {
                        let e = json.parse(resp)
                        msg = "" + e.message
                    } catch {
                        msg = "保存失败：后端未响应，请重试"
                    }
                    .ann_dlg_note = msg
                }
            }
        }
        // Markdown 导出（T-05 本地面）：后端生成 <data>/exports/*.md，
        // 读回校验后返回真实路径；Notes 缺席不阻塞（纯本地交付）。
        .DoExport -> {
            .ann_note = "导出中…"
            var resp str = ""
            try {
                resp = Http.post("/api/library/export", { book_id: .route_id })
            } catch {
                resp = ""
            }
            if resp == "" {
                .ann_note = "导出失败：后端未响应，请重试"
            } else {
                if resp.find("\"ok\":true") < 0 {
                    var msg str = "导出失败"
                    try {
                        let e = json.parse(resp)
                        msg = "" + e.message
                    } catch {
                        msg = "导出失败"
                    }
                    .ann_note = msg
                } else {
                    var okp bool = false
                    var wrap = null
                    try {
                        wrap = json.parse(resp)
                        okp = true
                    } catch {
                        okp = false
                    }
                    if okp {
                        let pth str = "" + wrap.path
                        let cnt int = wrap.count
                        if pth == "" {
                            .ann_note = "暂无注释可导出"
                        } else {
                            .ann_note = f"已导出 ${cnt} 条 → ${pth}"
                        }
                    } else {
                        .ann_note = "导出响应解析失败"
                    }
                }
            }
        }
    }
}
