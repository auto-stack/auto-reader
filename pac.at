name: "book-reader"
version: "1.0.0"
scene: "ui"
render: "vue"
title: "Book Reader"
title_zh: "图书阅读器"
# READER-001 F-07：不声明 api: "rust"（014-weather 同款裁定）——该字段会
# 把缺省 server 强制为 a2r Rust 后端，而本仓后端依赖的动态 JSON 字段访问
# 等 a2r 映射尚未落地（缺陷群登记于 docs/research/20261005-t00-runtime-
# capability.md §12，跨仓计划处置）。缺省即 Vue 前端 + AutoVM HTTP 后端
# （真实数据面）；`-r vm` 缺省 VM+VM 全轨；`--server=rust` 仍可显式选择
# a2r 轨（构建受阻，属登记中的框架能力差距，非本仓代码缺陷）。
front_port: 17824
back_port: 17825
desktop: "true"

# auto-os/PLAN-059 T-02：官方主题包主题名导入消费面。pac `theme` 键保持
# 缺省 = **follow 宿主**（宿主策略完整快照 > 本 design 默认 > legacy 回退）。
# `vendor/themes` 为 UI 管理渠道发布的**固定版本快照**（themes 0.2.0，内容
# digest 9fa07742dc68aa5377ae06cb2d966386002063f184c515b6c5dddf8a6bef838e，
# per-file sha256 与源包逐文件校验同律；不可二次编辑、非第二权威源）。
# 本产品原为纯浅色壳（无 dark_mode 位、无明暗切换），独立默认腿沿静态 light
# （056 todo 先例）；宿主内策略完整快照按 031 full-host 语义整体接管。
# 主合同反链见 README 与 docs/specs/theme-adoption.md。
dep themes {
    path: "vendor/themes"
}

dep stylekit {
    path: "vendor/stylekit"
}
